      "IsExotic (n d : ℕ) : Prop := buDimFormula n d < buDim n d — definition of exotic representation",
      "exoticDefect (n d : ℕ) : ℕ := buDim n d - buDimFormula n d — integer measure of exoticness",
      "not_exotic_prime (p d) : ¬IsExotic p d — in proofs/Proofs/BorsukUlamOQ02OQ01OQ01OQ02.lean",
      "not_exotic_prime_pow (p k d) : ¬IsExotic (p^k) d — in BorsukUlamOQ02OQ01OQ01OQ02.lean",
      "exotic_implies_two_prime_factors (n d) : IsExotic n d → 2 ≤ n.primeFactors.card",
      "buDimFormula_mono_of_dvd (n m d) : n ∣ m → m ≠ 0 → buDimFormula n d ≤ buDimFormula m d",
      "conjecture_iff_no_exotic : (∀ n d, 2≤n → buDim n d ≤ buDimFormula n d) ↔ (∀ n d, 2≤n → ¬IsExotic n d)"
