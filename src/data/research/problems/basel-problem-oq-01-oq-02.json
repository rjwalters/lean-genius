  "problemStatement": {
    "formal": "The Basel series has sum pi^2/6, its reciprocal-square terms are summable and nonnegative, and the zeta(4) companion series has sum pi^4/90.",
    "plain": "Backfills metadata for the clean Basel/zeta-value core. The base proof records Mathlib-backed HasSum and tsum statements for the Basel problem, convergence and positivity facts for 1/n^2, and the zeta(4) value pi^4/90.",
    "whyMatters": [
      "The Basel problem is a landmark example connecting infinite series, pi, Fourier analysis, and zeta values.",
      "The clean base file gives reliable theorem names for the classical pi^2/6 and pi^4/90 facts.",
      "Separating this from axiom-dependent Apery-style siblings keeps the metadata precise."
    ]
  },
  "knownResults": {
    "proven": [
      "`basel_hasSum` proves HasSum (fun n => 1 / n^2) (pi^2 / 6).",
      "`basel_tsum` gives the corresponding tsum equality for the reciprocal-square series.",
      "`summable_one_div_sq` and `one_div_sq_nonneg` record convergence and nonnegativity facts for the series terms.",
      "`zeta_four_hasSum` proves the zeta(4) value pi^4 / 90.",
      "The base `BaselProblem.lean` file is recorded with 0 axioms and 0 sorries."
    ],
