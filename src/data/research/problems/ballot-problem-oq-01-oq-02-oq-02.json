  "problemStatement": {
    "formal": "three_ordering_product_conjecture (a b c : ℕ) (ha : c < b) (hb : b < a) : ballotRatio a b * ballotRatio b c * ballotRatio a c = (a - b) * (b - c) * (a - c) / ((a + b) * (b + c) * (a + c))",
    "plain": "Given m candidates with vote totals a₁ > a₂ > ... > aₘ, the probability that the ordering is maintained throughout the count equals the product ∏_{i<j} (aᵢ - aⱼ)/(aᵢ + aⱼ) of pairwise ballot probabilities. This MacMahon-LGV formula connects the m-candidate ballot problem to non-intersecting lattice paths via the Lindström-Gessel-Viennot lemma.",
    "whyMatters": [
      "Unifies m classical ballot theorems into a single determinantal formula",
      "Demonstrates the LGV lemma in a concrete, beautiful combinatorial setting",
      "Provides 6 verified numerical examples of the 3-candidate formula",
      "Establishes the 2-candidate case from Mathlib's ballot theorem"
    ]
  },
  "knownResults": {
    "proven": [
      "ballotRatio_antisymm: swapping candidates negates the ratio",
      "ballotRatio_pos: ratio is positive when a > b",
      "ballotRatio_le_one: ratio is at most 1 when a > b",
      "example_3_1: ballotRatio 3 1 = 1/2",
      "example_4_2: ballotRatio 4 2 = 1/3",
      "example_5_1: ballotRatio 5 1 = 2/3",
      "example_4_2_1: 3-candidate product (4,2,1) = 1/15",
      "example_5_3_1: 3-candidate product (5,3,1) = 1/12",
      "example_6_4_2: 3-candidate product (6,4,2) = 1/30",
      "orderingProbability_two: 2-candidate case from Mathlib ballot_problem",
      "det_ballotMatrix2: det of 2x2 ballot matrix = 1 + r²",
      "ballotMatrix2_entry_01: entry (0,1) = ballotRatio",
      "ballotRatio_mono: larger margin gives higher probability"
    ],
    "open": [
