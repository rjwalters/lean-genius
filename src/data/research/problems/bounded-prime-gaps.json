  "problemStatement": {
    "formal": "\\exists H, \\forall N, \\exists p > N, p \\text{ prime} \\wedge (p' - p \\leq H)",
    "plain": "There exist infinitely many pairs of consecutive primes differing by at most H, for some finite H. Best known in this formal family: H <= 246 unconditionally, and H <= 12 assuming Elliott-Halberstam.",
    "whyMatters": []
  },
