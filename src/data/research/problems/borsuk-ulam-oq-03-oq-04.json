  "problemStatement": {
    "formal": "theorem quantitative_borsuk_ulam_1d (f : ℝ → ℝ) (L : ℝ) (hL : 0 < L) (hf : LipschitzWith (NNReal.ofReal L) (fun x => f x)) (δ : ℝ) (hδ : 0 < δ) (hg : |f 1 - f (-1)| = δ) : ∃ x₀ ∈ Set.Icc (-1 + δ / (2 * L)) (1 - δ / (2 * L)), f x₀ = f (-x₀)",
    "plain": "If f: [-1,1] → ℝ is L-Lipschitz and |f(1) - f(-1)| = δ > 0, then the antipodal zero x₀ (where f(x₀) = f(-x₀)) lies in the interval [-1 + δ/(2L), 1 - δ/(2L)], giving a quantitative lower bound on its distance from the boundary.",
    "whyMatters": [
      "Adds quantitative content to the existence guarantee in the 1D Borsuk-Ulam theorem",
      "Connects topological existence proofs with effective/constructive bounds",
      "Potential Mathlib contribution in the intersection of topology and real analysis",
      "Extends the rich BorsukUlamOQ03.lean infrastructure with quantitative estimates"
    ]
  },
