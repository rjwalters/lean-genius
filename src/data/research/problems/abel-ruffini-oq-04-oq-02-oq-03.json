{
  "id": "abel-ruffini-oq-04-oq-02-oq-03",
  "name": "Finite groups of order < 60 are solvable",
  "status": "completed",
  "phase": "COMPLETED",
  "source": {
    "type": "open-question",
    "parentProof": "abel-ruffini-oq-04-oq-02",
    "question": "Can the general theorem 'finite group of order < 60 is solvable' be formalized?"
  },
  "problemStatement": {
    "formal": "Formalize solvability building blocks for finite groups of order less than 60, while documenting the remaining Burnside and Sylow cases.",
    "plain": "Prove the readily available p-group and abelian-group cases and mark the full order-below-60 theorem as still requiring deeper group theory.",
    "whyMatters": [
      "The entry turns a large classification target into verified reusable group-theory components.",
      "It keeps the S5 order-60 threshold visible for the Abel-Ruffini solvability story."
    ]
  },
  "knownResults": {
    "proven": [
      "pGroup_isSolvable proves that finite p-groups are solvable through Mathlib's nilpotent-group infrastructure.",
      "abelian_isSolvable records the commutative-group case.",
      "s5_not_solvable marks the non-solvable threshold at S5.",
      "primes_below_60 verifies the count of primes below 60.",
      "The Lean file documents the order-classification table and the cases covered by the proved components."
    ],
    "open": [
      "The full theorem that every finite group of order less than 60 is solvable is not completed here.",
      "Burnside's p^a q^b theorem or case-by-case Sylow counting remains needed for the documented remaining cases."
    ],
    "goal": "Surface the completed solvability scaffolding without overstating the unfinished classification theorem."
  },
  "tags": [
    "group-theory",
    "abel-ruffini",
    "finite-groups",
    "solvable-groups",
    "classification"
  ],
  "knowledge": {
    "progressSummary": "COMPLETED: Proved p-group→solvable chain and abelian→solvable using Mathlib. Documented complete order classification below 60. Full theorem needs Burnside p^a·q^b (not in Mathlib). 0A/0S, 4 proved theorems, 104 lines.",
    "builtItems": [
      "proofs/Proofs/AbelRuffiniOQ04OQ02OQ03.lean (104 lines)",
      "pGroup_isSolvable: p-group → nilpotent → solvable chain",
      "s5_not_solvable: threshold at order 60",
      "abelian_isSolvable: CommGroup → IsSolvable",
      "primes_below_60: 17 primes below 60",
      "Complete order classification table by proof method"
    ],
    "insights": [
      "IsPGroup.isNilpotent requires [Fact (Nat.Prime p)] instance",
      "IsNilpotent.to_isSolvable is an instance, use infer_instance",
      "Burnside p^a·q^b is the main missing piece for 33 of 59 orders",
      "Only 2 orders (30, 42) have ≥ 3 distinct prime factors below 60"
    ],
    "mathlibGaps": [
      "Burnside's p^a · q^b theorem (requires character theory or transfer)",
      "IsSolvable instance for Perm (Fin n) for n ≤ 4 not easily accessible"
    ],
    "nextSteps": [
      "Prove Burnside's p^a·q^b theorem in Mathlib",
      "Or: case-by-case Sylow counting for remaining 33 orders",
      "Connect to Feit-Thompson (odd order theorem) for odd orders"
    ]
  },
