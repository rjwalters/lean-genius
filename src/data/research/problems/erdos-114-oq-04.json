{
  "id": "erdos-114-oq-04",
  "name": "Verify lemniscate axioms using Mathlib complex analysis",
  "status": "completed",
  "phase": "COMPLETED",
  "source": {
    "type": "open-question",
    "parentProof": "erdos-114",
    "question": "Can any of the axiomatized results be verified using Mathlib's complex analysis?"
  },
  "problemStatement": {
    "formal": "For lemniscate sets L(P) = {z : |P(z)| = 1}, replace axiomatized set definitions and basic lemniscate facts with Lean definitions and Mathlib complex-analysis lemmas where possible.",
    "plain": "Determine which lemniscate facts in the Erdős #114 thread can be verified directly in Mathlib's complex-analysis library, especially the set-level definitions and elementary examples around z^n - 1.",
    "whyMatters": [
      "Separates facts already supported by Mathlib from analytic estimates that still need new infrastructure.",
      "Turns previously axiomatized lemniscate definitions into inspectable Lean objects.",
      "Clarifies that arc length and complex line-integration support are the remaining blockers for the deeper Danchenko-style bounds."
    ]
  },
  "knownResults": {
    "proven": [
      "Lemniscate sets can be defined axiom-free using Polynomial.eval and the complex norm.",
      "Basic set properties such as root membership, empty negative-level sets, and preimage descriptions are formalized.",
      "The z^n - 1 lemniscate examples and membership lemmas are implemented without sorries."
    ],
    "open": [
      "Arc length for parametric curves in C is not available as reusable Mathlib infrastructure.",
      "The Danchenko bound still needs complex curve integration or a custom replacement.",
      "A Gamma-function formula for the length of the z^n - 1 lemniscate remains outside the current Lean development."
    ],
    "goal": "Keep the axiom-free Mathlib-backed lemniscate definitions as the stable base, then remove the remaining analytic placeholder only after curve length and complex line-integral infrastructure exists."
  },
  "knowledge": {
    "progressSummary": "COMPLETED: Defined lemniscate sets properly using Polynomial.eval + ‖·‖ (no axioms needed for set definitions). Proved basic properties. Assessed axiom eliminability: arc length requires curve integration not in Mathlib. 1 axiom (Danchenko placeholder), 0 sorries, 10 theorems, 177 lines.",
    "builtItems": [
      "proofs/Proofs/Erdos114OQ04Problem.lean (177 lines)",
      "lemniscateSet and unitLemniscate definitions (axiom-free)",
      "Basic properties: lemniscate_zero_eq_roots, lemniscate_neg_empty, lemniscate_is_preimage",
      "z^n - 1 definitions: znMinus1, eval_znMinus1, znMinus1_lemniscate",
      "Membership: root_of_unity_not_on_lemniscate, zero_on_lemniscate",
      "Examples: lemniscate_degree_zero, lemniscate_n1, lemniscate_n2",
      "Gallery entry"
    ],
    "insights": [
      "Polynomial module moved from Data.Polynomial to Algebra.Polynomial in newer Mathlib",
      "Complex.abs is accessed via ‖·‖ (norm) in current Mathlib API",
      "norm_eq_zero and norm_nonneg are key lemmas for lemniscate proofs",
      "Arc length of ℂ curves is the main Mathlib gap blocking axiom elimination",
      "Danchenko bound potentially provable via Cauchy integral (~500 lines)"
    ],
    "mathlibGaps": [
      "No arc length for curves in ℂ",
      "No complex curve integration (line integrals over parametric curves)"
    ],
    "nextSteps": [
      "Define arc length for parametric curves in ℂ (custom infrastructure)",
      "Attempt Danchenko bound via Cauchy integral formula",
      "Connect to Gamma function formula for z^n-1 lemniscate length"
    ]
  },
