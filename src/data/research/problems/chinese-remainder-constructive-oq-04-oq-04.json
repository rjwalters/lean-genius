  "problemStatement": {
    "formal": "For a finite CRT system with pairwise coprime moduli and positive product M, prove there exists a unique solution x with x < M satisfying all congruences.",
    "plain": "Strengthen the list-based Chinese remainder theorem by choosing the canonical minimal non-negative representative of each solution class.",
    "whyMatters": [
      "A constructive CRT is most useful when it returns a canonical representative rather than only an arbitrary congruence class.",
      "The minimal representative in [0, M) is the finite-list analogue of taking a ZMod value.",
      "The Sunzi example gives a concrete sanity check for the abstract CRT statement."
    ]
  },
  "knownResults": {
    "proven": [
      "Reducing any satisfying solution modulo the product of the moduli preserves all congruences (Lean: satisfies_mod).",
      "Existence of a solution in the interval [0, moduliProd sys) is derived from the list CRT (Lean: crt_list_minimal_exists).",
      "Uniqueness of the bounded representative follows from the list-CRT uniqueness theorem (Lean: crt_list_minimal_unique).",
      "The combined exists-unique minimal CRT theorem is proved for pairwise coprime moduli and positive product (Lean: crt_list_min).",
      "The classic Sunzi system is verified with minimal solution 23 modulo 105 (Lean: sunzi_minimal_solution, sunzi_solution_is_23, sunzi_unique)."
    ],
