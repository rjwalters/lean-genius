  "problemStatement": {
    "formal": "∀ κ regular uncountable, ∀ f : ι → Ordinal, #ι < κ → (∀ i, f i < κ.ord) → ∃ β < κ.ord, ∀ i, f i < β",
    "plain": "Generalize the Cantor diagonal argument from ℵ₁ to arbitrary regular cardinals. The key property is regularity (cof = κ), not just uncountability.",
    "whyMatters": [
      "Unifies all diagonal-type arguments under one theorem",
      "Distinguishes regular from singular cardinals",
      "The ℵ₁ case is a 3-line specialization"
    ]
  },
  "knownResults": {
    "proven": [
      "regular_sup_bounded: iSup f < κ.ord for regular κ",
      "card_succ_lt_of_lt_infinite: μ+1 < κ for infinite κ",
      "regular_diagonal: main diagonal argument for regular κ",
      "regular_no_surjection: impossibility of <κ-sized surjection",
      "aleph1_diagonal: ℵ₁ specialization"
    ],
