  "problemStatement": {
    "formal": "\\forall n \\geq 1, r \\geq 0,\\quad \\text{Vol}(B^n(r)) = r^n \\cdot \\text{Vol}(B^n(1))",
    "plain": "Prove that the volume of the n-dimensional ball of radius r equals r^n times the unit ball volume. This is the axiom nball_volume_scaling in area-of-circle-oq-02.",
    "whyMatters": [
      "Eliminates an axiom from area-of-circle-oq-02",
      "Confirms Mathlib's EuclideanSpace.volume_ball is the right primitive",
      "Documents a subtle bug in the original axiom at n=0, r=0"
    ]
  },
