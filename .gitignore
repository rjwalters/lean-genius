# Root .gitignore — added as PR A of #38387 (engine check-in + runtime-state hygiene).
# Keep secrets first; later sections are runtime state, caches, and build outputs.

# ── Secrets — never commit ─────────────────────────────────────────────
.env
.env.*
# Exception: the placeholder template carries no secrets and is tracked.
!.env.example
.loom/tokens/
.loom/lean-daemon-state.json
.loom/usage-cache.json
.loom-checkpoint
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
aristotle-results/llm-mapping-cache.json
*.token

# ── Loom / agent runtime state ─────────────────────────────────────────
# Track Loom-installed files (hooks, roles, scripts, defaults); ignore ONLY
# runtime state. Loom 0.11.0 ships .loom/scripts/ and its installer refuses a
# blanket `.loom/*` ignore, so we enumerate runtime paths instead of the old
# ignore-then-negate. Secrets lines above (.loom/tokens, *.token) still apply.
.loom/config.json
.loom/logs/
.loom/locks/
.loom/signals/
.loom/state/
.loom/tmp/
.loom/sweep-checkpoint/
.loom/worktrees/
.loom-managed
research/*.pid
research/*.log
proofs/err.log
scripts/enricher/*.log
scripts/enricher/logs/

# ── Build artifacts / caches ───────────────────────────────────────────
.lake
.lake/
.build-cache/
.erdos-cache/
.wrangler/
node_modules/
dist/
public/
test-results/
.lean/state/
.lean/research/

# ── Fleet queues / derived research state ──────────────────────────────
research/claims/
research/enrichment-claims/
research/references/
research/quality-history/
research/candidate-pool.json
research/db/
aristotle-results/

# ── Generated site data (build outputs; see scripts/research/build.ts) ─
# proofs-side pair is emitted by the annotations build (src/data/proofs/index.ts docs);
# research-side pair by scripts/research/build.ts. All four are never tracked on main.
src/data/proofs/data-manifest.json
src/data/proofs/listings.json
src/data/research/research-data-manifest.json
src/data/research/research-listings.json

# ── Restored legacy rules (from pre-dc9fdffa30 root .gitignore, #38398) ─
# Union-merged: rules already covered above (e.g. .loom/* umbrella,
# .env.*, research/db/, research/claims/) are not repeated here.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs / local files
dist-ssr
*.local
package-lock.json
leanInk/

# Cloudflare local secrets
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Knuth tour-finder build artifacts
proofs/data/knuth/ham-benchmarks.tgz
proofs/data/knuth/tour-finder/Cargo.lock
proofs/data/knuth/tour-finder/target/

# Research runtime leftovers
research/stub-claims/
proofs/Proofs/*.bak
proofs/Proofs/*.lean.bak
.loom-in-use

# Synthetic pollution fixture for Tailwind v4 oxide scan-hang repro (#21009).
# Generated by scripts/repro/tailwind-scan-hang/setup.sh — never committed.
# (See #21009 discussion: comment out to reproduce the oxide hang.)
tmp-tailwind-repro/

# Python bytecode caches (e.g. research/**/scripts/__pycache__)
__pycache__/
*.pyc
