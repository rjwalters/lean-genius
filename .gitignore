# Root .gitignore — added as PR A of #38387 (engine check-in + runtime-state hygiene).
# Keep secrets first; later sections are runtime state, caches, and build outputs.

# ── Secrets — never commit ─────────────────────────────────────────────
.env
.env.*
# Exception: the placeholder template carries no secrets and is tracked.
!.env.example
# No trailing slash: the legacy on-disk form was a symlink, not a directory,
# and a directory-only rule let it slip through and get committed.
.loom/tokens
.loom/lean-daemon-state.json
.claude/settings.local.json
# Per-machine install record (absolute source path + install timestamp)
.claude/skills/repo/.install-local.json
.claude/projects/
.claude/worktrees/
aristotle-results/llm-mapping-cache.json
*.token

# ── Loom / agent runtime state ─────────────────────────────────────────
# Track Loom-installed files (hooks, roles, scripts, defaults); ignore ONLY
# runtime state. Loom 0.11.0 ships .loom/scripts/ and its installer refuses a
# blanket `.loom/*` ignore, so we enumerate runtime paths instead of the old
# ignore-then-negate. Secrets lines above (.loom/tokens, *.token) still apply.
# (Loom's own installer appends a `>>> loom-managed >>>` block below covering
# logs/signals/worktrees/daemon files; the paths here fill its gaps.)
# .loom/config.json is HOST-LOCAL (worktree.root=/Volumes/Stripe, guards.forceScope)
# and must never be committed.
.loom/accounts.env
.loom/locks/
.loom/state/
.loom/tmp/
.loom/sweep-checkpoint/
.loom/exit-codes/
.loom/config.json
.loom/model-config.env
.loom-managed
# host-local dev symlink to the loom-tools package source (see #43675)
loom-tools
research/*.pid
research/*.log
proofs/err.log
scripts/enricher/*.log
scripts/enricher/logs/

# ── Build artifacts / caches ───────────────────────────────────────────
.lake
.lake/
.build-cache/
.erdos-cache/
.wrangler/
node_modules/
dist/
public/
test-results/
.lean/state/
.lean/research/

# ── Fleet queues / derived research state ──────────────────────────────
research/claims/
research/enrichment-claims/
research/references/
research/quality-history/
research/candidate-pool.json
research/db/
aristotle-results/

# ── Generated site data (build outputs; see scripts/research/build.ts) ─
# proofs-side pair is emitted by the annotations build (src/data/proofs/index.ts docs);
# research-side pair by scripts/research/build.ts. All four are never tracked on main.
src/data/proofs/data-manifest.json
src/data/proofs/listings.json
src/data/research/research-data-manifest.json
src/data/research/research-listings.json

# ── Restored legacy rules (from pre-dc9fdffa30 root .gitignore, #38398) ─
# Union-merged: rules already covered above (e.g. .loom/* umbrella,
# .env.*, research/db/, research/claims/) are not repeated here.

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs / local files
dist-ssr
*.local
package-lock.json
# LeanInk output is generated alongside the sources, never in a leanInk/ dir.
proofs/Proofs/*.leanInk

# Cloudflare local secrets
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Knuth tour-finder build artifacts
proofs/data/knuth/ham-benchmarks.tgz
proofs/data/knuth/tour-finder/Cargo.lock
proofs/data/knuth/tour-finder/target/

# Research runtime leftovers
research/stub-claims/
# Retired daemon-stop sentinel; the live signal is .loom/signals/stop-lean-daemon
research/lean-stop-daemon
proofs/Proofs/*.bak
proofs/Proofs/*.lean.bak
proofs/Proofs/*.backup
proofs/Proofs/*.test

# Synthetic pollution fixture for Tailwind v4 oxide scan-hang repro (#21009).
# Generated by scripts/repro/tailwind-scan-hang/setup.sh — never committed.
# (See #21009 discussion: comment out to reproduce the oxide hang.)
tmp-tailwind-repro/

# Python bytecode caches (e.g. research/**/scripts/__pycache__)
__pycache__/
*.pyc
# >>> loom-managed (do not edit) >>>
# Loom runtime state (don't commit these)
.loom-in-use
.loom-checkpoint
.no-changes-needed
.loom/.daemon.pid
.loom/.daemon.log
.loom/daemon.sock
.loom/daemon-loop.pid
.loom/daemon-metrics.json
.loom/loom-source-path
.loom/spawn-loop-state.json
.loom/spawn-loop.pid
.loom/stop-spawn-loop
.loom/issue-failures.json
.loom/interventions/
.loom/worktrees/
.loom/worktrees-local/
.loom/state.json
.loom/mcp-command.json
.loom/activity.db
.loom/claims/
.loom/signals/
.loom/status/
.loom/retry-state/
.loom/sweep-run/
.loom/stats/
.loom/diagnostics/
.loom/guide-docs-state.json
.loom/metrics_state.json
.loom/manifest.json
.loom/stuck-config.json
.loom/metrics/
.loom/usage-cache.json
.loom/claude-config/
.loom/account-health.json
.loom/account-health.lock
.loom/CANARY
.loom/*.log
.loom/*.sock
.loom/*.tmp
.loom/*.bak
.loom/logs/
# <<< loom-managed <<<

# Repo Skills machine-local install metadata (absolute source path + timestamp)
.claude/skills/repo/.install-local.json
.squad/
