def B (g : Fin 16) : Fin 24 → Fin 24 → Bool := fun i j => (adjRows g i).getLsbD j.val
theorem adjacency_checked (g : Fin 16) : ∀ i j,
    B g i j = B 0 (label g i) (label g j) := by decide +revert

theorem no_joint (h : ¬ ThreeHighJointWitness (B 0)) (g : Fin 16) :
    ¬ ThreeHighJointWitness (B g) :=
  no_joint_transfer (B g) (B 0) g (adjacency_checked g) h
def crossRows : Fin 16 → Fin 15 → BitVec 8 := ![![2,16,32,64,132,8,4,128,16,96,32,8,2,64,144],![2,16,32,128,68,8,4,64,16,160,32,8,2,128,80],![2,32,16,64,132,8,4,128,32,80,16,8,2,64,160],![2,32,16,128,68,8,4,64,32,144,16,8,2,128,96],![2,16,32,64,136,4,8,128,16,96,32,4,2,64,144],![2,16,32,128,72,4,8,64,16,160,32,4,2,128,80],![2,32,16,64,136,4,8,128,32,80,16,4,2,64,160],![2,32,16,128,72,4,8,64,32,144,16,4,2,128,96],![32,64,2,16,132,2,64,32,8,144,128,16,8,4,96],![32,128,2,16,68,2,128,32,8,80,64,16,8,4,160],![16,64,2,32,132,2,64,16,8,160,128,32,8,4,80],![16,128,2,32,68,2,128,16,8,96,64,32,8,4,144],![32,64,2,16,136,2,64,32,4,144,128,16,4,8,96],![32,128,2,16,72,2,128,32,4,80,64,16,4,8,160],![16,64,2,32,136,2,64,16,4,160,128,32,4,8,80],![16,128,2,32,72,2,128,16,4,96,64,32,4,8,144]]
def cross (g : Fin 16) : ThreeHighCross := fun i j => (crossRows g i).getLsbD j.val
theorem member_eq (g : Fin 16) : B g =
    threeHighEmptyAdj FixedPairCoordinates.U FixedPairCoordinates.R (cross g) := by decide +revert

theorem no_joint_cross (h : ¬ ThreeHighJointWitness (B 0)) (g : Fin 16) :
    ¬ ThreeHighJointWitness (threeHighEmptyAdj
      (threeHighFullUnionAdj (threeBlockFirstRowEmbed (threeBlockCompactCode 6 6 15)))
      (threeHighSecondaryTupleAdj (threeHighSecondaryRepresentative 14)) (cross g)) := by
  rw [← FixedPairCoordinates.U_eq, ← FixedPairCoordinates.R_eq, ← member_eq]
  exact no_joint h g
end Orbit11
