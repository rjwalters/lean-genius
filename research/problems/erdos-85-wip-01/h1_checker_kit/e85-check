#!/usr/bin/env python3
"""e85-check — independently re-check the H1 stratum of the Erdős 85 order-49 drop.

Runs on the public checker AMI (or any arm64 Linux host prepared by ami_setup.sh) in us-east-1, under
YOUR AWS credentials. The certificate bucket is Requester Pays: you pay for your own requests/transfer,
which are free inside us-east-1.

  e85-check bank    [--sample N | --all] [--seed S]   stream published bank proofs into cake_lpr
  e85-check census  [--sample N | --ids a,b] [--max-hours H]
                                                      re-solve census orbits with the pinned CaDiCaL,
                                                      stream each proof into cake_lpr, compare its sha256
                                                      with the published receipt
  e85-check cube    [--leaves 31,44]                  the hardest orbit, h1_81494a6ef36d3ec9: rebuild its 36
                                                      cube CNFs, solve + cake_lpr each (cover proved in Lean)
  e85-check summary                                   tabulate everything under the results directory

Every row is checked from scratch: the CNF is regenerated by the pinned Lean-compiled emitter (v2cnf)
inside the pinned image and must match the published CNF sha256; a row PASSES only if cake_lpr prints
`s VERIFIED UNSAT` (cake_lpr exits 0 even on failure — the exit code proves nothing).
"""
from __future__ import annotations
import argparse, concurrent.futures as cf, csv, json, os, random, subprocess, sys, time
from pathlib import Path

KIT = Path(os.environ.get("E85_KIT", "/opt/e85/kit"))
TOOLS = Path(os.environ.get("E85_TOOLS", "/opt/e85/repo/research/problems/erdos-85-wip-01"))
RESULTS = Path(os.environ.get("E85_RESULTS", "/scratch/e85-results"))
INVENTORY = Path(os.environ.get("E85_INVENTORY", "/opt/e85/repo/proofs/Proofs/Certificates/h1_orbit_inventory.compact"))
V2CNF = os.environ.get("E85_V2CNF", "/opt/e85/bin/v2cnf")
CAKE = os.environ.get("E85_CAKE_LPR", "/usr/local/bin/cake_lpr")
CADICAL = os.environ.get("E85_CADICAL", "/usr/local/bin/cadical")


def mem_gb() -> float:
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemAvailable"):
                return int(line.split()[1]) / 1048576
    except OSError:
        pass
    return float(os.environ.get("E85_MEM_GB", "24"))


def workers(per_row_gb: float) -> int:
    return max(1, min(os.cpu_count() or 1, int((mem_gb() - 4) // per_row_gb)))


def load_jsonl(p: Path) -> list[dict]:
    return [json.loads(l) for l in p.read_text().splitlines() if l.strip()]


def pick(rows, key, a):
    if a.ids:
        want = set(a.ids.split(","))
        return [r for r in rows if r[key] in want]
    if a.all:
        return rows
    return random.Random(a.seed).sample(rows, min(a.sample, len(rows)))


def run_bank(a):
    out = RESULTS / "bank"; out.mkdir(parents=True, exist_ok=True)
    rows = pick(load_jsonl(KIT / "manifests" / "bank_manifest.jsonl"), "tag", a)
    todo = [r for r in rows if not (out / r["tag"] / "receipt.json").exists()]
    n = workers(10.0)
    print(f"bank: {len(todo)} rows to check ({len(rows) - len(todo)} already done), {n} parallel", flush=True)

    def one(r):
        cand = out / f"{r['tag']}.candidates.json"
        cand.write_text(json.dumps(r["candidates"]))
        subprocess.run([sys.executable, str(TOOLS / "h1_bank_check_20261006" / "bank_check_row.py"), r["tag"], "--out", str(out),
                        "--candidates", str(cand) if r["candidates"] else "none", "--heap-mb", "8000",
                        "--inventory", str(INVENTORY), "--v2cnf", V2CNF, "--cake-lpr", CAKE, "--profile", "", "--request-payer"],
                       capture_output=True)
        p = out / r["tag"] / "receipt.json"
        return json.loads(p.read_text()) if p.exists() else {"tag": r["tag"], "status": "NO_RECEIPT"}

    with cf.ThreadPoolExecutor(n) as ex:
        for f in cf.as_completed([ex.submit(one, r) for r in todo]):
            r = f.result(); print(r["tag"], r["status"], flush=True)
    summary(a)


def run_census(a):
    out = RESULTS / "census"; out.mkdir(parents=True, exist_ok=True)
    man = load_jsonl(KIT / "manifests" / "census_manifest.jsonl")
    if a.max_hours:
        man = [r for r in man if r["census_cadical_seconds"] is not None and r["census_cadical_seconds"] <= a.max_hours * 3600]
    rows = pick(man, "id", a)
    todo = [r for r in rows if not list(out.glob(f"{r['id']}*/receipt.json"))]
    n = workers(6.0)
    print(f"census: {len(todo)} rows to re-solve and check, {n} parallel", flush=True)

    def one(r):
        d = out / f"{r['id']}.{int(time.time())}"
        subprocess.run([sys.executable, str(TOOLS / "h1_cert_full_20261001" / "cert_row.py"), "--case-id", r["id"],
                        "--table", str(KIT / "tables" / f"{r['id']}.json"), "--profile", str(r["profile"]),
                        "--cnf-sha256", r["cnf_sha256"], "--out", str(d), "--cap", "172800", "--heap-mb", "16000",
                        "--v2cnf", V2CNF, "--cadical", CADICAL, "--cake-lpr", CAKE], capture_output=True)
        p = d / "receipt.json"
        return json.loads(p.read_text()) if p.exists() else {"case_id": r["id"], "status": "NO_RECEIPT"}

    with cf.ThreadPoolExecutor(n) as ex:
        for f in cf.as_completed([ex.submit(one, r) for r in todo]):
            r = f.result(); print(r["case_id"], r["status"], flush=True)
    summary(a)


def run_cube(a):
    out = RESULTS / "cube"
    subprocess.run([sys.executable, str(TOOLS / "h1_checker_kit" / "cube_check.py"), "--kit", str(KIT), "--out", str(out),
                    "--v2cnf", V2CNF, "--cadical", CADICAL, "--cake-lpr", CAKE] + (["--leaves", a.leaves] if a.leaves else []))


def summary(_a):
    pub = {}
    with open(KIT / "receipts" / "h1_cert_census_receipts.tsv") as f:
        for r in csv.DictReader(f, delimiter="\t"):
            pub[r["id"]] = r
    with open(KIT / "receipts" / "h1_bank_check_receipts.tsv") as f:
        for r in csv.DictReader(f, delimiter="\t"):
            pub[r["tag"]] = r
    res = {"bank": {}, "census": {}}
    for p in (RESULTS / "bank").glob("*/receipt.json"):
        j = json.loads(p.read_text())
        ok = j.get("status") == "VERIFIED" and j.get("lrat_sha256") == pub.get(j["tag"], {}).get("lrat_sha256")
        res["bank"][j["tag"]] = "PASS" if ok else j.get("status")
    for p in (RESULTS / "census").glob("*/receipt.json"):
        j = json.loads(p.read_text()); rid = j["case_id"]
        if j.get("status") != "CERTIFIED":
            res["census"][rid] = j.get("status"); continue
        published = pub.get(rid, {}).get("proof_sha256")
        if not published:
            res["census"][rid] = "PASS (historical orbit: no published proof hash to compare)"
        elif j.get("proof", {}).get("sha256") == published:
            res["census"][rid] = "PASS, proof byte-identical to published"
        else:
            res["census"][rid] = "PASS (proof differs from published receipt: that row was produced by a different CaDiCaL build — see CHECKING.md)"
    cs = RESULTS / "cube" / "SUMMARY.json"
    if cs.exists():
        res["cube"] = json.loads(cs.read_text())["leaves"]
    tally = {k: {} for k in res}
    for k, v in res.items():
        for s in v.values():
            tally[k][s] = tally[k].get(s, 0) + 1
    print(json.dumps(tally, indent=1))
    (RESULTS / "SUMMARY.json").write_text(json.dumps({"tally": tally, "rows": res}, indent=1) + "\n")
    print(f"details: {RESULTS}/SUMMARY.json")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, fn in (("bank", run_bank), ("census", run_census)):
        s = sub.add_parser(name)
        g = s.add_mutually_exclusive_group()
        g.add_argument("--sample", type=int, default=20); g.add_argument("--all", action="store_true"); g.add_argument("--ids", default="")
        s.add_argument("--seed", type=int, default=int(time.time()))
        if name == "census":
            s.add_argument("--max-hours", type=float, default=1.0, help="only orbits whose original CaDiCaL solve took at most this long (default 1 h; 0 = no limit)")
        s.set_defaults(fn=fn)
    s = sub.add_parser("cube"); s.add_argument("--leaves", default=""); s.set_defaults(fn=run_cube)
    s = sub.add_parser("summary"); s.set_defaults(fn=summary)
    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
