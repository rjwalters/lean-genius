/-- The miss table read exactly as the `v2cnf` emitter's `tableOfEntries`. -/
def h1Cube81494aTable : OneHighMissTable := fun c j =>
  match h1Cube81494aTableEntries.find? (fun e => e.1.1 = c ∧ e.1.2 = j) with
