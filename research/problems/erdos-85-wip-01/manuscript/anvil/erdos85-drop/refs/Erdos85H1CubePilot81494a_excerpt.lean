/-- Composition for the pilot tree: the 36 leaf cube CNFs refute the base. -/
theorem cnf_unsat_of_h1Cube81494a (cnf : Std.Sat.CNF Nat)
    (hleaf : ∀ d ∈ h1Cube81494aCubes, (cubeCnf cnf d).Unsat) : cnf.Unsat :=
  cnf_unsat_of_cubeTree cnf h1Cube81494aTree h1Cube81494aCubes
    h1Cube81494a_cover hleaf

