/-- The base CNF of the pilot root, generated in Lean. -/
def h1Cube81494aBaseCnf : Std.Sat.CNF Nat := oneHighFamilyV2SatCnf 0 h1Cube81494aTable

theorem h1Cube81494aTree_leafCount : h1Cube81494aTree.leafCount = 36 := by decide

theorem h1Cube81494aCubes_length : h1Cube81494aCubes.length = 36 := by decide

set_option maxRecDepth 100000 in
theorem h1Cube81494a_cover :
    ∀ c ∈ h1Cube81494aTree.cubes, ∃ d ∈ h1Cube81494aCubes, ∀ l ∈ d, l ∈ c := by
