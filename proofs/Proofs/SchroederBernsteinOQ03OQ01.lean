import Mathlib.Computability.Reduce
import Mathlib.GroupTheory.Perm.Sign
import Mathlib.Tactic

/-!
# The Computable (Recursive) Symmetric Group on ℕ

A child result of `schroeder-bernstein-oq-03` (Myhill's isomorphism theorem, the
computable analogue of Schröder–Bernstein). The parent studies *computable
permutations* `e : ℕ ≃ ℕ` — bijections `e` such that both `e` and `e.symm` are
`Computable` (Mathlib's `Equiv.Computable`). Myhill's theorem produces such a
permutation from a pair of computable one-one reductions; its full priority
construction is still open in that file.

This file isolates a clean, fully machine-checked structural fact that the
priority construction implicitly relies on and that stands on its own:

> **The computable permutations of `ℕ` form a subgroup of the symmetric group
> `Equiv.Perm ℕ`.**

This "recursive symmetric group" `recSym` is a classical object of computability
theory (the group of *recursive permutations* of the naturals). We prove:

* `recSym : Subgroup (Equiv.Perm ℕ)` — closure of `Equiv.Computable` under the
  group operations (identity, composition, inverse). Composition-closure is
  exactly what lets a back-and-forth argument chain finitely many computable
  adjustments and remain computable.
* Every **transposition** `Equiv.swap m n` is computable (`swap_mem`), by an
  explicit `Primrec` witness for the swapping function.
* Consequently the subgroup generated by all transpositions consists of
  computable permutations (`closure_isSwap_le`), and every finite product of
  transpositions is computable (`list_prod_swap_mem`). In particular every
  finitely-supported permutation of `ℕ` is computable.
* The recursive symmetric group is nontrivial (`recSym_ne_bot`).

All results are `0`-axiom (no `sorry`, no added `axiom`, no `native_decide`).

## References

* J. Myhill, *Creative sets*, Z. Math. Logik Grundlagen Math. 1 (1955).
* H. Rogers, *Theory of Recursive Functions and Effective Computability*, §7.4.
-/

open Equiv Function

namespace ComputableSymmetricGroup

/-!
## Section 1: Transpositions are computable

The two-element swap `Equiv.swap m n`, viewed as the function
`x ↦ if x = m then n else if x = n then m else x`, is primitive recursive: it is
built from decidable equality tests and constants. Since `swap m n` is its own
inverse, this single computability fact gives `(swap m n).Computable`.
-/

/-- The underlying swapping function of `Equiv.swap m n` is primitive recursive:
    it is an `ite`-tree over the decidable equality tests `x = m` and `x = n`. -/
theorem primrec_swapFun (m n : ℕ) :
    Primrec (fun x : ℕ => if x = m then n else if x = n then m else x) :=
  Primrec.ite (PrimrecRel.comp Primrec.eq Primrec.id (Primrec.const m))
    (Primrec.const n)
    (Primrec.ite (PrimrecRel.comp Primrec.eq Primrec.id (Primrec.const n))
      (Primrec.const m) Primrec.id)

/-- The transposition `Equiv.swap m n`, as a function `ℕ → ℕ`, is computable. -/
theorem computable_swap_coe (m n : ℕ) :
    Computable (⇑(Equiv.swap m n) : ℕ → ℕ) :=
  (primrec_swapFun m n).to_comp.of_eq (fun x => (Equiv.swap_apply_def m n x).symm)

/-- **Transpositions are computable permutations.** Both `Equiv.swap m n` and its
    inverse are computable; the inverse is the same swap (`Equiv.symm_swap`). -/
theorem swap_computable (m n : ℕ) : (Equiv.swap m n).Computable :=
  ⟨computable_swap_coe m n, by
    rw [Equiv.symm_swap]; exact computable_swap_coe m n⟩

/-!
## Section 2: The recursive symmetric group

The computable permutations form a subgroup of `Equiv.Perm ℕ`. The three closure
properties are:

* **identity**: `id` is computable and `(Equiv.refl ℕ).symm = Equiv.refl ℕ`;
* **composition**: `(a * b) = b.trans a` and `Equiv.Computable.trans`;
* **inverse**: `a⁻¹ = a.symm` and `Equiv.Computable.symm`.
-/

/-- **The recursive symmetric group** `recSym`: the subgroup of `Equiv.Perm ℕ`
    consisting of the computable permutations (those `e` with both `e` and
    `e.symm` computable). -/
def recSym : Subgroup (Equiv.Perm ℕ) where
  carrier := {e | e.Computable}
  one_mem' := by
    show (1 : Equiv.Perm ℕ).Computable
    rw [Equiv.Perm.one_def]
    refine ⟨?_, ?_⟩ <;>
      · simp only [Equiv.coe_refl, Equiv.refl_symm]
        exact Computable.id
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [Equiv.Perm.mul_def]
    exact hb.trans ha
  inv_mem' := by
    intro a ha
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [Equiv.Perm.inv_def]
    exact ha.symm

/-- Membership in `recSym` is exactly computability of the permutation. -/
@[simp] theorem mem_recSym {e : Equiv.Perm ℕ} : e ∈ recSym ↔ e.Computable := Iff.rfl

/-!
## Section 3: Generators and structure
-/

/-- Every transposition belongs to the recursive symmetric group. -/
theorem swap_mem (m n : ℕ) : Equiv.swap m n ∈ recSym := swap_computable m n

/-- **The subgroup generated by all transpositions is computable.** The subgroup
    of `Equiv.Perm ℕ` generated by the set of transpositions is contained in
    `recSym`; hence every permutation expressible as a product of transpositions
    is a computable permutation. -/
theorem closure_isSwap_le :
    Subgroup.closure {σ : Equiv.Perm ℕ | σ.IsSwap} ≤ recSym := by
  rw [Subgroup.closure_le]
  rintro σ ⟨x, y, -, rfl⟩
  exact swap_mem x y

/-- Any permutation in the closure of the transpositions is computable. -/
theorem computable_of_mem_closure_isSwap {σ : Equiv.Perm ℕ}
    (h : σ ∈ Subgroup.closure {σ : Equiv.Perm ℕ | σ.IsSwap}) : σ.Computable :=
  closure_isSwap_le h

/-- **Every finite product of transpositions is a computable permutation.** In
    particular every finitely-supported permutation of `ℕ` is computable, since
    such permutations are exactly the finite products of transpositions. -/
theorem list_prod_swap_mem (l : List (ℕ × ℕ)) :
    (l.map (fun p => Equiv.swap p.1 p.2)).prod ∈ recSym :=
  recSym.list_prod_mem <| by
    intro x hx
    simp only [List.mem_map] at hx
    obtain ⟨p, -, rfl⟩ := hx
    exact swap_mem p.1 p.2

/-- **The recursive symmetric group is nontrivial**: it contains the
    transposition `swap 0 1`, which is not the identity permutation. -/
theorem recSym_ne_bot : recSym ≠ ⊥ := by
  intro h
  have hmem : Equiv.swap (0 : ℕ) 1 ∈ recSym := swap_mem 0 1
  rw [h, Subgroup.mem_bot] at hmem
  have h01 : (Equiv.swap (0 : ℕ) 1 : Equiv.Perm ℕ) 0 = (1 : Equiv.Perm ℕ) 0 := by
    rw [hmem]
  rw [Equiv.swap_apply_left] at h01
  simp only [Equiv.Perm.coe_one, id_eq] at h01
  exact one_ne_zero h01

end ComputableSymmetricGroup
