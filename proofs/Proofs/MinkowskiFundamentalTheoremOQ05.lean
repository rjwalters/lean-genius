/-
  Dirichlet's Simultaneous Approximation Theorem from Minkowski
  (minkowski-fundamental-theorem-oq-05)

  Open Question (from minkowski-fundamental-theorem, OQ #5):
  "Can Dirichlet's simultaneous-approximation theorem be derived as a corollary
  in this formalization?  The construction is explicit: apply
  `minkowski_fundamental` to S = {x : |xᵢ - αᵢx₀| < 1/Q for i ≥ 1, |x₀| ≤ Qⁿ}
  with covolume 1."

  This file answers OQ #5 affirmatively.  We prove **Dirichlet's simultaneous
  Diophantine approximation theorem**:

      For every finite family of reals α : Fin d → ℝ and every integer N ≥ 1,
      there exist an integer q with 1 ≤ q ≤ Nᵈ and integers p : Fin d → ℤ with

          |αᵢ · q - pᵢ| ≤ 1/N     for all i.

  Mathlib already contains the *one-dimensional* Dirichlet theorem
  (`Real.exists_int_int_abs_mul_sub_le`), proved by the pigeonhole principle.
  The genuinely new content here is the **simultaneous** (multi-dimensional)
  version, and crucially the fact that it is obtained **as a corollary of the
  Minkowski convex body theorem** (the parent entry's `minkowski_fundamental`),
  exactly as the open question requests.

  ## The Minkowski construction

  Work in ℝ^{d+1} with coordinates (x₀, x₁, …, x_d).  Consider the lattice
  generated by the rows of the unipotent ("shear") matrix

        ⎛ 1  -α₀ -α₁ … -α_{d-1} ⎞
        ⎜ 0   1   0  …    0     ⎟
        ⎜ 0   0   1  …    0     ⎟
        ⎝ …                  1  ⎠

  whose determinant is 1, so the lattice has covolume 1.  A lattice point with
  integer coordinates (q, p₀, …, p_{d-1}) is the vector
  (q, p₀ - α₀q, …, p_{d-1} - α_{d-1}q).  Inside the symmetric box

        |x₀| ≤ Nᵈ + ½,    |xᵢ| ≤ 1/N   (i ≥ 1)

  of volume 2^{d+1}(1 + 1/(2Nᵈ)) > 2^{d+1} = 2^{d+1}·covolume, Minkowski's
  theorem produces a nonzero lattice point.  Reading off its coordinates and
  using that q is an integer (so |q| ≤ Nᵈ + ½ forces |q| ≤ Nᵈ) yields the
  approximation.  A sign flip makes q positive; the case q = 0 only occurs when
  N = 1, which is handled directly with rounding.

  HONEST SCOPE: 0 sorries, 0 new axioms.  The proof is a genuine reduction to
  the parent `minkowski_fundamental` (which is itself proved from Mathlib's
  geometry-of-numbers API), together with the box-volume computation
  `Real.volume_Icc_pi` and the determinant of an upper-triangular matrix.

  References:
  - G. L. Dirichlet, "Verallgemeinerung eines Satzes aus der Lehre von den
    Kettenbrüchen" (1842).
  - J. W. S. Cassels, "An Introduction to the Geometry of Numbers" (1959), Ch. I.
  - Mathlib: `Mathlib.NumberTheory.DiophantineApproximation.Basic`
    (one-dimensional case).
-/
import Mathlib
import Proofs.MinkowskiFundamentalTheorem

set_option maxHeartbeats 1600000
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace MinkowskiDirichlet

open MinkowskiFundamentalTheorem Set MeasureTheory

/-! ## The shear matrix and its lattice -/

/-- Row `0` of the shear matrix as a vector: `(0, α₀, α₁, …, α_{d-1})`.
    (The `0` slot is never used; the diagonal `1` overrides it.) -/
def shearRow0 {d : ℕ} (α : Fin d → ℝ) : Fin (d + 1) → ℝ := Fin.cons (0 : ℝ) α

/-- The unipotent shear matrix in dimension `d+1`: identity except for row `0`,
    whose off-diagonal entries are `-αⱼ`.  Its determinant is `1`. -/
def shearMatrix {d : ℕ} (α : Fin d → ℝ) : Matrix (Fin (d + 1)) (Fin (d + 1)) ℝ :=
  Matrix.of fun i j => if i = j then (1 : ℝ) else if i = 0 then -(shearRow0 α j) else 0

@[simp] lemma shearMatrix_apply {d : ℕ} (α : Fin d → ℝ) (i j : Fin (d + 1)) :
    shearMatrix α i j = if i = j then (1 : ℝ) else if i = 0 then -(shearRow0 α j) else 0 := rfl

/-- The shear matrix is upper triangular. -/
lemma shearMatrix_blockTriangular {d : ℕ} (α : Fin d → ℝ) :
    (shearMatrix α).BlockTriangular id := by
  intro i j hji
  -- `hji : id j < id i`, i.e. `j < i`
  simp only [id] at hji
  have hij : i ≠ j := fun h => by simp [h] at hji
  have hi0 : i ≠ 0 := by
    rintro rfl; exact absurd hji (by simp)
  rw [shearMatrix_apply, if_neg hij, if_neg hi0]

/-- The determinant of the shear matrix is `1`. -/
lemma shearMatrix_det {d : ℕ} (α : Fin d → ℝ) : (shearMatrix α).det = 1 := by
  rw [Matrix.det_of_upperTriangular (shearMatrix_blockTriangular α)]
  simp

/-- The Dirichlet lattice: the lattice whose basis matrix is the shear matrix. -/
def dirichletLattice {d : ℕ} (α : Fin d → ℝ) : MinkowskiFundamentalTheorem.Lattice (d + 1) where
  basis := shearMatrix α
  basis_invertible := by rw [shearMatrix_det]; exact one_ne_zero

@[simp] lemma dirichletLattice_covolume {d : ℕ} (α : Fin d → ℝ) :
    (dirichletLattice α).covolume = 1 := by
  rw [MinkowskiFundamentalTheorem.Lattice.covolume, dirichletLattice, shearMatrix_det,
    abs_one]

/-! ## The symmetric box -/

/-- Half-widths of the Minkowski box: `Nᵈ + ½` in coordinate `0`, and `1/N`
    in the remaining coordinates. -/
noncomputable def boxHi {d : ℕ} (N : ℕ) : Fin (d + 1) → ℝ :=
  Fin.cons ((N : ℝ) ^ d + 1 / 2) (fun _ => 1 / (N : ℝ))

lemma boxHi_zero {d : ℕ} (N : ℕ) : (boxHi N : Fin (d + 1) → ℝ) 0 = (N : ℝ) ^ d + 1 / 2 := rfl

lemma boxHi_succ {d : ℕ} (N : ℕ) (k : Fin d) :
    (boxHi N : Fin (d + 1) → ℝ) k.succ = 1 / (N : ℝ) := by simp [boxHi]

lemma boxHi_nonneg {d : ℕ} {N : ℕ} (hN : 1 ≤ N) (i : Fin (d + 1)) :
    0 ≤ (boxHi N : Fin (d + 1) → ℝ) i := by
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  refine Fin.cases ?_ ?_ i
  · rw [boxHi_zero]; positivity
  · intro k; rw [boxHi_succ]; positivity

/-- The Minkowski box as a `ConvexBody`: `Icc (-boxHi N) (boxHi N)`. -/
noncomputable def dirichletBox {d : ℕ} (N : ℕ) (hN : 1 ≤ N) :
    MinkowskiFundamentalTheorem.ConvexBody (d + 1) where
  carrier := Icc (-boxHi N) (boxHi N)
  convex := convex_Icc _ _
  symmetric := by
    intro x hx
    rw [mem_Icc] at hx ⊢
    refine ⟨?_, ?_⟩
    · simpa using neg_le_neg hx.2
    · simpa using neg_le_neg hx.1
  nonempty := by
    refine ⟨0, mem_Icc.mpr ⟨fun i => ?_, fun i => ?_⟩⟩
    · simpa using neg_nonpos_of_nonneg (boxHi_nonneg hN i)
    · simpa using boxHi_nonneg hN i

/-- The (real) volume of the box. -/
noncomputable def boxVolume (d N : ℕ) : ℝ :=
  (2 * (N : ℝ) ^ d + 1) * (2 / (N : ℝ)) ^ d

lemma boxVolume_eq {d : ℕ} (N : ℕ) :
    MeasureTheory.volume (Icc (-boxHi N) (boxHi N) : Set (Fin (d + 1) → ℝ))
      = ENNReal.ofReal (boxVolume d N) := by
  rw [Real.volume_Icc_pi]
  have hwidth : ∀ i : Fin (d + 1),
      (boxHi N : Fin (d + 1) → ℝ) i - (-boxHi N : Fin (d + 1) → ℝ) i
        = 2 * (boxHi N : Fin (d + 1) → ℝ) i := by
    intro i; simp only [Pi.neg_apply]; ring
  simp_rw [hwidth]
  rw [Fin.prod_univ_succ]
  have h0 : (2 : ℝ) * (boxHi N : Fin (d + 1) → ℝ) 0 = 2 * (N : ℝ) ^ d + 1 := by
    rw [boxHi_zero]; ring
  have hs : ∀ k : Fin d, (2 : ℝ) * (boxHi N : Fin (d + 1) → ℝ) k.succ = 2 / (N : ℝ) := by
    intro k; rw [boxHi_succ]; ring
  rw [h0]
  simp_rw [hs]
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    ← ENNReal.ofReal_pow (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  rfl

/-- `HasVolume` instance for the box. -/
noncomputable def dirichletBox_hasVolume {d : ℕ} (N : ℕ) (hN : 1 ≤ N) :
    HasVolume (d + 1) (dirichletBox N hN) where
  volume := boxVolume d N
  volume_pos := by
    have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
    unfold boxVolume; positivity
  carrier_measurableSet := by
    show MeasurableSet (Icc (-boxHi N) (boxHi N) : Set (Fin (d + 1) → ℝ))
    exact measurableSet_Icc
  volume_eq := boxVolume_eq N

/-- The box volume strictly exceeds the critical volume `2^{d+1}`. -/
lemma boxVolume_gt_critical {d : ℕ} (α : Fin d → ℝ) {N : ℕ} (hN : 1 ≤ N) :
    boxVolume d N > criticalVolume (d + 1) (dirichletLattice α) := by
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
  have hNne : (N : ℝ) ≠ 0 := ne_of_gt hNpos
  have hNd : (0 : ℝ) < (N : ℝ) ^ d := pow_pos hNpos d
  rw [criticalVolume, dirichletLattice_covolume, mul_one]
  have e : boxVolume d N = (2 : ℝ) ^ (d + 1) + (2 : ℝ) ^ d / (N : ℝ) ^ d := by
    rw [boxVolume, div_pow]
    field_simp
    ring
  rw [e]
  have hpos : (0 : ℝ) < (2 : ℝ) ^ d / (N : ℝ) ^ d := div_pos (pow_pos (by norm_num) d) hNd
  linarith

/-! ## The Minkowski core: a nonzero approximating lattice point -/

/-- Column `0` of the shear matrix: `1` at row `0`, else `0`. -/
private lemma shear_col0 {d : ℕ} (α : Fin d → ℝ) (i : Fin (d + 1)) :
    shearMatrix α i 0 = if i = 0 then (1 : ℝ) else 0 := by
  rw [shearMatrix_apply]; by_cases h : i = 0 <;> simp [h]

/-- The `0`-row, `k.succ`-column entry of the shear matrix is `-αₖ`. -/
private lemma shear_row0_succ {d : ℕ} (α : Fin d → ℝ) (k : Fin d) :
    shearMatrix α 0 k.succ = -(α k) := by
  rw [shearMatrix_apply, if_neg (Fin.succ_ne_zero k).symm, if_pos rfl, shearRow0,
    Fin.cons_succ]

/-- The `j.succ`-row, `k.succ`-column entry of the shear matrix is `δⱼₖ`. -/
private lemma shear_succ_succ {d : ℕ} (α : Fin d → ℝ) (j k : Fin d) :
    shearMatrix α j.succ k.succ = if j = k then (1 : ℝ) else 0 := by
  rw [shearMatrix_apply]
  by_cases h : j = k
  · subst h; simp
  · have h2 : j.succ ≠ k.succ := fun hh => h (Fin.succ_injective _ hh)
    rw [if_neg h2, if_neg (Fin.succ_ne_zero j)]; simp [h]

theorem dirichlet_minkowski_core {d : ℕ} (α : Fin d → ℝ) {N : ℕ} (hN : 1 ≤ N) :
    ∃ (q : ℤ) (p : Fin d → ℤ),
      |q| ≤ (N : ℤ) ^ d ∧ (∀ i, |α i * (q : ℝ) - (p i : ℝ)| ≤ 1 / (N : ℝ)) ∧
      (q ≠ 0 ∨ ∃ i, p i ≠ 0) := by
  obtain ⟨x, hx_mem, hx_lat, hx_ne⟩ :=
    minkowski_fundamental (d + 1) (dirichletLattice α) (dirichletBox N hN)
      (hv := dirichletBox_hasVolume N hN) (boxVolume_gt_critical α hN)
  obtain ⟨coeffs, hx_eq⟩ := hx_lat
  have hbasis : (dirichletLattice α).basis = shearMatrix α := rfl
  -- Coordinate `0` of the lattice point is `coeffs 0`.
  have hx0 : x 0 = (coeffs 0 : ℝ) := by
    rw [hx_eq]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hbasis, shear_col0,
      mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq' Finset.univ (0 : Fin (d + 1)) (fun i => (coeffs i : ℝ))]
    simp
  -- Coordinate `k.succ` is `coeffs k.succ - αₖ · coeffs 0`.
  have hxs : ∀ k : Fin d, x k.succ = (coeffs k.succ : ℝ) - α k * (coeffs 0 : ℝ) := by
    intro k
    rw [hx_eq]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hbasis]
    rw [Fin.sum_univ_succ]
    rw [shear_row0_succ]
    simp_rw [shear_succ_succ, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq' Finset.univ k (fun j => (coeffs j.succ : ℝ))]
    simp
    ring
  -- Bounds from box membership: `|x i| ≤ boxHi N i`.
  have hmemIcc : (-boxHi N : Fin (d + 1) → ℝ) ≤ x ∧ x ≤ boxHi N := hx_mem
  have hb : ∀ i, |x i| ≤ (boxHi N : Fin (d + 1) → ℝ) i := by
    intro i
    rw [abs_le]
    refine ⟨?_, hmemIcc.2 i⟩
    have := hmemIcc.1 i
    simpa using this
  -- `|coeffs 0| ≤ Nᵈ`, using that `coeffs 0` and `Nᵈ` are integers.
  have hq_abs : |coeffs 0| ≤ (N : ℤ) ^ d := by
    have h := hb 0
    rw [hx0, boxHi_zero] at h
    have h4 : |coeffs 0| < (N : ℤ) ^ d + 1 := by
      have hcast : ((|coeffs 0| : ℤ) : ℝ) < (((N : ℤ) ^ d + 1 : ℤ) : ℝ) := by
        push_cast; linarith
      exact_mod_cast hcast
    omega
  -- The approximation bound in each coordinate.
  have happrox : ∀ k : Fin d, |α k * (coeffs 0 : ℝ) - (coeffs k.succ : ℝ)| ≤ 1 / (N : ℝ) := by
    intro k
    have h := hb k.succ
    rw [hxs k, boxHi_succ] at h
    rw [abs_sub_comm]
    exact h
  -- Nonzero: not all coefficients vanish.
  have hnz : coeffs 0 ≠ 0 ∨ ∃ k : Fin d, coeffs k.succ ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    obtain ⟨h00, hkk⟩ := hcon
    apply hx_ne
    funext i
    simp only [Pi.zero_apply]
    refine Fin.cases ?_ ?_ i
    · rw [hx0, h00]; simp
    · intro k; rw [hxs k, hkk k, h00]; simp
  exact ⟨coeffs 0, fun k => coeffs k.succ, hq_abs, happrox, hnz⟩

/-! ## Dirichlet's simultaneous approximation theorem -/

theorem dirichlet_simultaneous {d : ℕ} (α : Fin d → ℝ) {N : ℕ} (hN : 1 ≤ N) :
    ∃ (q : ℤ) (p : Fin d → ℤ),
      0 < q ∧ q ≤ (N : ℤ) ^ d ∧ ∀ i, |α i * (q : ℝ) - (p i : ℝ)| ≤ 1 / (N : ℝ) := by
  rcases Nat.lt_or_ge N 2 with hN1 | hN2
  · -- N = 1: take q = 1 and round each αᵢ.
    have hNe1 : N = 1 := by omega
    subst hNe1
    refine ⟨1, fun i => round (α i), one_pos, by simp, ?_⟩
    intro i
    have hr := abs_sub_round (α i)
    simp only [Int.cast_one, Nat.cast_one, mul_one, div_one]
    linarith [hr]
  · -- N ≥ 2: use the Minkowski core, fix the sign of q.
    obtain ⟨q, p, hqb, happ, hnz⟩ := dirichlet_minkowski_core α (by omega : 1 ≤ N)
    have hNR : (2 : ℝ) ≤ N := by exact_mod_cast hN2
    -- q ≠ 0 (q = 0 would force N = 1).
    have hq0 : q ≠ 0 := by
      intro hq
      subst hq
      rcases hnz with h | ⟨i, hi⟩
      · exact h rfl
      · have hcoord := happ i
        rw [Int.cast_zero, mul_zero, zero_sub, abs_neg] at hcoord
        have h1 : (1 : ℝ) ≤ |(p i : ℝ)| := by
          rw [← Int.cast_abs]
          have : (1 : ℤ) ≤ |p i| := Int.one_le_abs hi
          exact_mod_cast this
        have h2 : 1 / (N : ℝ) ≤ 1 / 2 :=
          one_div_le_one_div_of_le (by norm_num) hNR
        linarith
    rw [abs_le] at hqb
    rcases hq0.lt_or_gt with hneg | hpos
    · -- q < 0: negate.
      refine ⟨-q, fun i => -(p i), by omega, by omega, ?_⟩
      intro i
      have hcoord := happ i
      push_cast
      rw [show α i * -(q : ℝ) - -(p i : ℝ) = -(α i * (q : ℝ) - (p i : ℝ)) by ring, abs_neg]
      exact hcoord
    · -- q > 0.
      exact ⟨q, p, hpos, by omega, happ⟩

end MinkowskiDirichlet
