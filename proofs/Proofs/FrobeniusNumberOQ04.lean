/-
  Sylvester–Frobenius (Chicken McNugget) via Mathlib's canonical predicate — OQ-04

  researcher-1, 2026-06-19.

  The existing gallery entry `Proofs/FrobeniusNumber.lean` proves the two-coin
  formula `g(m, n) = m·n − m − n` using a *homemade* representability predicate
  (`Representable a b n := ∃ x y, n = a·x + b·y`) and a plain function
  `frobeniusNumber a b := a·b − a − b`. That is mathematically fine, but the
  "largest non-representable" claim is encoded by hand.

  This entry instead grounds the same theorem in Mathlib's **canonical** Frobenius
  machinery:

    `FrobeniusNumber n s := IsGreatest { k | k ∉ AddSubmonoid.closure s } n`

  i.e. representability is `AddSubmonoid.closure {m, n}` (the verified general
  notion of "nonnegative integer combination") and the extremal claim is a single
  `IsGreatest`. We invoke `frobeniusNumber_pair` and then unpack it two ways:

    1. via `frobeniusNumber_iff` — the bare not-in-closure / above-in-closure pair;
    2. via `AddSubmonoid.mem_closure_pair` — the *elementary* representability
       statement `∃ a b : ℕ, a·m + b·n = k`, so the final corollaries read in the
       same `a·m + b·n` language as the gallery's homemade entry, but every step is
       backed by Mathlib's verified `IsGreatest`/closure development.

  The Chicken McNugget instance `g(3, 5) = 7` is then the canonical
  `FrobeniusNumber 7 {3, 5}` together with its fully elementary unpacking
  (`¬ ∃ a b, 3a + 5b = 7` and `∀ k > 7, ∃ a b, 3a + 5b = k`).

  0 axioms, 0 sorries.
-/
import Mathlib.NumberTheory.FrobeniusNumber
import Mathlib.Algebra.Group.Submonoid.Membership

namespace FrobeniusNumberOQ04

open scoped Nat

/-! ## Part I: The elementary bridge for the closure of a pair

Mathlib's `AddSubmonoid.mem_closure_pair` says membership in `closure {m, n}` is
exactly being a `ℕ`-linear combination `a • m + b • n`. Over `ℕ` the action `•`
is multiplication, so this is the elementary "representable as `a·m + b·n`". -/

/-- `k` lies in the additive submonoid generated by `{m, n}` iff it is a
nonnegative integer combination `a·m + b·n`. This is the elementary meaning of
"representable", here derived from Mathlib's `mem_closure_pair`. -/
theorem mem_closure_pair_iff (m n k : ℕ) :
    k ∈ AddSubmonoid.closure ({m, n} : Set ℕ) ↔ ∃ a b : ℕ, a * m + b * n = k := by
  rw [AddSubmonoid.mem_closure_pair]
  simp only [smul_eq_mul]

/-! ## Part II: Sylvester–Frobenius via the canonical predicate -/

/-- **Sylvester–Frobenius / Chicken McNugget theorem**, stated with Mathlib's
canonical `FrobeniusNumber` predicate: for coprime `m, n > 1`, the number
`m·n − m − n` is the greatest natural number *not* in the additive submonoid
generated by `{m, n}`. This is `frobeniusNumber_pair` re-exported under the
gallery's namespace. -/
theorem sylvester_frobenius_canonical {m n : ℕ}
    (cop : Nat.Coprime m n) (hm : 1 < m) (hn : 1 < n) :
    FrobeniusNumber (m * n - m - n) ({m, n} : Set ℕ) :=
  frobeniusNumber_pair cop hm hn

/-- Unpacking via `frobeniusNumber_iff`: the Frobenius value `m·n − m − n`
is itself not representable. -/
theorem frobenius_not_in_closure {m n : ℕ}
    (cop : Nat.Coprime m n) (hm : 1 < m) (hn : 1 < n) :
    (m * n - m - n) ∉ AddSubmonoid.closure ({m, n} : Set ℕ) :=
  (frobeniusNumber_iff.mp (sylvester_frobenius_canonical cop hm hn)).1

/-- Unpacking via `frobeniusNumber_iff`: every integer strictly above the
Frobenius value is representable. -/
theorem above_frobenius_in_closure {m n : ℕ}
    (cop : Nat.Coprime m n) (hm : 1 < m) (hn : 1 < n) :
    ∀ k > m * n - m - n, k ∈ AddSubmonoid.closure ({m, n} : Set ℕ) :=
  (frobeniusNumber_iff.mp (sylvester_frobenius_canonical cop hm hn)).2

/-! ## Part III: Fully elementary form `∃ a b, a·m + b·n = k`

Combining Parts I and II, the canonical theorem reads in the same elementary
language as the gallery's homemade entry — but now every step is backed by
Mathlib's verified development rather than a hand-rolled predicate. -/

/-- The Frobenius value `m·n − m − n` is not a nonnegative combination `a·m + b·n`. -/
theorem frobenius_not_representable {m n : ℕ}
    (cop : Nat.Coprime m n) (hm : 1 < m) (hn : 1 < n) :
    ¬ ∃ a b : ℕ, a * m + b * n = m * n - m - n := by
  rw [← mem_closure_pair_iff]
  exact frobenius_not_in_closure cop hm hn

/-- Every integer above `m·n − m − n` is a nonnegative combination `a·m + b·n`. -/
theorem above_frobenius_representable {m n : ℕ}
    (cop : Nat.Coprime m n) (hm : 1 < m) (hn : 1 < n) :
    ∀ k > m * n - m - n, ∃ a b : ℕ, a * m + b * n = k := by
  intro k hk
  rw [← mem_closure_pair_iff]
  exact above_frobenius_in_closure cop hm hn k hk

/-! ## Part IV: The Chicken McNugget instance `g(3, 5) = 7` -/

/-- The classic Chicken McNugget case: `7 = 3·5 − 3 − 5` is the canonical
Frobenius number of `{3, 5}`. -/
theorem mcnugget_canonical : FrobeniusNumber 7 ({3, 5} : Set ℕ) := by
  have : (7 : ℕ) = 3 * 5 - 3 - 5 := by norm_num
  rw [this]
  exact frobeniusNumber_pair (by decide) (by norm_num) (by norm_num)

/-- 7 cannot be made from 3s and 5s. -/
theorem seven_not_representable : ¬ ∃ a b : ℕ, a * 3 + b * 5 = 7 := by
  have h : (7 : ℕ) = 3 * 5 - 3 - 5 := by norm_num
  rw [h]
  exact frobenius_not_representable (by decide) (by norm_num) (by norm_num)

/-- Every amount above 7 can be made from 3s and 5s. -/
theorem above_seven_representable : ∀ k > 7, ∃ a b : ℕ, a * 3 + b * 5 = k := by
  have h : (7 : ℕ) = 3 * 5 - 3 - 5 := by norm_num
  rw [h]
  exact above_frobenius_representable (by decide) (by norm_num) (by norm_num)

end FrobeniusNumberOQ04
