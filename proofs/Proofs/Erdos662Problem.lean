/-
Erdos Problem 662 -- Distances in Separated Point Sets

Conjecture (Erdos-Lovasz-Vesztergombi, 1997): Among all n-point
1-separated sets in R2, the triangular lattice maximizes the number
of pairs at distance le t, for each t ge 1.

Status: OPEN
Reference: https://erdosproblems.com/662
-/

import Mathlib.Data.Nat.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Finset.Basic
import Mathlib.Data.Finset.Card
import Mathlib.Tactic

open Finset Classical

attribute [local instance] Classical.propDecidable

-- ## Definitions

/-- A point in R2. -/
def Point2D := ℝ × ℝ

/-- Squared Euclidean distance between two points. -/
noncomputable def sqDist (p q : Point2D) : ℝ :=
  (p.1 - q.1) ^ 2 + (p.2 - q.2) ^ 2

/-- A set of points is 1-separated if all pairwise squared distances ge 1. -/
def IsSeparated (pts : Finset Point2D) : Prop :=
  ∀ p ∈ pts, ∀ q ∈ pts, p ≠ q → sqDist p q ≥ 1

/-- The set of neighbors of p in pts at squared distance le t squared. -/
noncomputable def neighbors (pts : Finset Point2D) (p : Point2D) (t : ℝ) :
    Finset Point2D :=
  pts.filter fun q => p ≠ q ∧ sqDist p q ≤ t ^ 2

/-- The number of ordered pairs at squared distance le t squared. -/
noncomputable def orderedPairsWithinDist (pts : Finset Point2D) (t : ℝ) : ℕ :=
  ((pts ×ˢ pts).filter fun pq => pq.1 ≠ pq.2 ∧ sqDist pq.1 pq.2 ≤ t ^ 2).card

/-- The number of unordered pairs at distance le t. -/
noncomputable def pairsWithinDist (pts : Finset Point2D) (t : ℝ) : ℕ :=
  orderedPairsWithinDist pts t / 2

-- ## Triangular Lattice

/-- The triangular lattice in R2 with unit spacing, generated by
    basis vectors (1, 0) and (1/2, sqrt3/2). -/
noncomputable def triLatticePoint (a b : ℤ) : Point2D :=
  (↑a + ↑b / 2, ↑b * Real.sqrt 3 / 2)

/-- f(t): the number of nonzero lattice points at distance le t from the
    origin in the triangular lattice. -/
axiom triangularLatticeCount : ℝ → ℕ

-- ## Known Lattice Values

/-- The squared distance from the origin to lattice point (a,b) is
    a squared + ab + b squared in the triangular lattice. -/
theorem triLattice_sqDist (a b : ℤ) :
    sqDist (triLatticePoint a b) (triLatticePoint 0 0) =
      ↑a ^ 2 + ↑a * ↑b + ↑b ^ 2 := by
  simp only [sqDist, triLatticePoint, Int.cast_zero, zero_div, add_zero, mul_zero,
    zero_mul, sub_zero]
  have h3 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num : (3 : ℝ) ≥ 0)
  have key : (↑b * Real.sqrt 3 / 2) ^ 2 = ↑b ^ 2 * 3 / 4 := by
    rw [div_pow, mul_pow, h3]; ring
  rw [key]; ring

/-- The 6 nearest neighbors in the triangular lattice at distance 1. -/
theorem triLattice_nearest_neighbors :
    triangularLatticeCount 1 = 6 := by sorry

/-- The 12 points within distance sqrt 3. -/
theorem triLattice_second_shell :
    triangularLatticeCount (Real.sqrt 3) = 12 := by sorry

-- ## Contact Number Bound (t = 1 case)

/-- In a 1-separated set, each point has at most 6 unit neighbors. -/
axiom unit_neighbor_bound (pts : Finset Point2D) (p : Point2D)
    (hp : p ∈ pts) (hsep : IsSeparated pts) :
    (neighbors pts p 1).card ≤ 6

/-- Ordered unit-distance pairs bounded by 6n. -/
theorem ordered_unit_pairs_bound (pts : Finset Point2D)
    (hsep : IsSeparated pts) :
    orderedPairsWithinDist pts 1 ≤ 6 * pts.card := by sorry

/-- Contact Number Bound (3n): unordered unit-distance pairs le 3n. -/
theorem contact_number_3n (pts : Finset Point2D)
    (hsep : IsSeparated pts) :
    pairsWithinDist pts 1 ≤ 3 * pts.card := by
  unfold pairsWithinDist
  have h := ordered_unit_pairs_bound pts hsep
  omega

-- ## Main Conjecture (OPEN)

/-- Erdos-Lovasz-Vesztergombi Conjecture (OPEN). -/
axiom erdos_662_lattice_optimal :
  ∀ t : ℝ, t ≥ 1 →
    ∃ N : ℕ, ∀ (pts : Finset Point2D), IsSeparated pts →
      pts.card ≥ N →
      pairsWithinDist pts t ≤ pts.card * triangularLatticeCount t / 2
