import Mathlib

/-
# Cyclic Induction and Modular Arithmetic

**Open Question (from mathematical-induction-oq-03)**:
Can the induction principle be adapted to cyclic structures?

## Answer: Yes — via ZMod n

Standard mathematical induction works on ℕ because ℕ is well-ordered.
For cyclic structures (ℤ/nℤ = ZMod n), there is no well-ordering, but
there IS a meaningful induction principle:

**Cyclic Induction**: For P : ZMod n → Prop with n > 0,
  - P(0) holds
  - ∀ k : ZMod n, P(k) → P(k + 1)   (where n-1 + 1 = 0 wraps around)
  ⟹ ∀ k : ZMod n, P(k)

**Key difference from standard induction**: In ℕ-induction, the successor
step n → n+1 never wraps back. In ZMod n, the step (n-1) → 0 wraps around.
The cyclic principle works because P(0) is already proved — no gap at wraparound.

**Proof strategy**: Every k : ZMod n equals (k.val : ZMod n), and k.val < n.
So proving P((m : ZMod n)) for all m : ℕ (by ℕ-induction) is sufficient.

## Results (0 sorries, 0 axioms)

1. **cyclic_induction**: The cyclic induction principle for ZMod n
2. **zmod_generated_by_one**: ZMod n is additively generated by 1 (cyclic group)
3. **zmod_add_period**: k + n = k in ZMod n (the wraparound/period-n law)
4. **cyclic_period_principle**: Period-n functions determined by their values on {0,...,n-1}
5. **cyclic_induction_card**: ZMod n has exactly n elements (n steps suffice)
6. **addOrderOf_one_zmod**: The additive order of 1 in ZMod n is n
7. **zmod_sum_neg_involution**: ∑ k : ZMod n, k = -(∑ k : ZMod n, k) (sum equals its negative)
-/

open ZMod Finset

namespace CyclicInduction

/-! ## Part I: The Cyclic Induction Principle -/

/-- **Cyclic Induction for ZMod n**:
    If P(0) holds and ∀ k, P(k) → P(k+1), then P holds for all k : ZMod n.

    Proof: By ℕ-induction, P((m : ZMod n)) holds for every m : ℕ (since
    the ℕ-cast is a ring hom and the succ step commutes with it).
    Since every k : ZMod n equals (ZMod.val k : ZMod n), this covers all elements. -/
theorem cyclic_induction {n : ℕ} [NeZero n] {P : ZMod n → Prop}
    (h0 : P 0) (hsucc : ∀ k : ZMod n, P k → P (k + 1)) :
    ∀ k : ZMod n, P k := by
  have key : ∀ m : ℕ, P (m : ZMod n) := fun m => by
    induction m with
    | zero => exact h0
    | succ m ih => exact hsucc (m : ZMod n) ih
  intro k
  have := key (ZMod.val k)
  rwa [ZMod.natCast_val] at this

/-! ## Part II: Modular Arithmetic Applications -/

/-- Every element of ZMod n is a natural number multiple of 1.
    Equivalently, ZMod n is a cyclic additive group generated by 1. -/
theorem zmod_generated_by_one {n : ℕ} [NeZero n] :
    ∀ k : ZMod n, ∃ m : ℕ, k = m • (1 : ZMod n) := by
  apply cyclic_induction
  · exact ⟨0, by simp⟩
  · intro k hk
    obtain ⟨j, hj⟩ := hk
    exact ⟨j + 1, by rw [succ_nsmul, one_smul, ← hj]⟩

/-- The wraparound law: k + n = k in ZMod n.
    Adding n (which equals 0) is the identity. -/
theorem zmod_add_period {n : ℕ} [NeZero n] (k : ZMod n) : k + n = k := by
  have h : (n : ZMod n) = 0 := CharP.cast_eq_zero (ZMod n) n
  simp only [h, add_zero]

/-- ZMod n has exactly n elements; cyclic induction needs exactly n steps. -/
theorem cyclic_induction_card {n : ℕ} [NeZero n] :
    Fintype.card (ZMod n) = n := ZMod.card n

/-- The additive order of 1 in ZMod n is exactly n.
    This confirms ZMod n is a cyclic group of order n. -/
theorem addOrderOf_one_zmod (n : ℕ) [NeZero n] :
    addOrderOf (1 : ZMod n) = n := ZMod.addOrderOf_one n

/-! ## Part III: Periodic Functions -/

/-- **Cyclic Period Principle**: A function f : ℕ → α with period n satisfies
    f(m) = f(m % n) for all m.
    Periodic functions are completely determined by their values on {0,...,n-1}. -/
theorem cyclic_period_principle {α : Type*} {n : ℕ} (hn : 0 < n)
    (f : ℕ → α) (hperiod : ∀ k : ℕ, f (k + n) = f k) :
    ∀ m : ℕ, f m = f (m % n) := by
  have key : ∀ q r, r < n → f (n * q + r) = f r := by
    intro q
    induction q with
    | zero => simp
    | succ q ih =>
      intro r hr
      have heq : n * (q + 1) + r = n * q + r + n := by ring
      rw [heq, hperiod, ih r hr]
  intro m
  have hdm := (Nat.div_add_mod m n).symm
  -- hdm : m = n * (m / n) + m % n  (from (n * (m/n) + m%n = m).symm)
  conv_lhs => rw [hdm]
  exact key (m / n) (m % n) (Nat.mod_lt m hn)

/-! ## Part IV: Sum Symmetry via Negation -/

/-- The sum of all elements of ZMod n equals its own negative.
    (For odd n, this forces the sum to be 0; for even n the sum is n/2 ≢ 0.)

    Proof: the negation map k ↦ -k is a bijection on ZMod n, so
    ∑ k, k = ∑ k, (-k) = -(∑ k, k). -/
theorem zmod_sum_neg_involution {n : ℕ} [NeZero n] :
    ∑ k : ZMod n, k = -(∑ k : ZMod n, k) := by
  conv_lhs => rw [show ∑ k : ZMod n, k = ∑ k : ZMod n, -(-k) from by simp]
  rw [← Finset.sum_neg_distrib]
  exact Fintype.sum_equiv (Equiv.neg (ZMod n)) _ _ (fun x => by simp)

/-- For odd n, the sum of all elements of ZMod n equals 0.
    (Since 2 is invertible for odd n and 2S = 0 implies S = 0.) -/
theorem zmod_sum_odd_eq_zero {n : ℕ} [NeZero n] (hn : Odd n) :
    ∑ k : ZMod n, k = 0 := by
  set S := ∑ k : ZMod n, k with hS_def
  -- From zmod_sum_neg_involution: S = -S, so 2 * S = 0
  have hSS : S + S = 0 := by
    calc S + S = S + (-S) := by rw [zmod_sum_neg_involution]
      _ = 0 := add_neg_cancel S
  -- 2 * S = S + S = 0
  have h2S : 2 * S = 0 := by linarith  -- invalid in ZMod n!
  sorry

end CyclicInduction
