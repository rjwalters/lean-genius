/-
  Reverse Newton's Identities: eₖ as a polynomial in the power sums
  (amgm-inequality-oq-02-oq-01-oq-02-oq-01-oq-01-oq-01-oq-01)

  Open Question (the listed follow-up of the general Newton–Girard recurrence
  entry, amgm-inequality-oq-02-oq-01-oq-02-oq-01-oq-01-oq-01):
  "Reverse Newton's identities: eₖ as a polynomial in the power sums."

  The parent entry proved the forward recurrence

      pₖ = ∑_{i=1}^{k-1} (-1)^(i+1)·eᵢ·pₖ₋ᵢ  +  (-1)^(k+1)·k·eₖ,

  equivalently its dual `mul_esymm_recurrence`

      (-1)^(k+1)·k·eₖ = pₖ − ∑_{i=1}^{k-1} (-1)^(i+1)·eᵢ·pₖ₋ᵢ,

  which expresses `k·eₖ` through the power sums and the LOWER elementary
  symmetric polynomials.  The genuinely NEW content of this file is the
  *reverse* direction: each `eₖ` is itself a polynomial in the power sums
  alone (no `eᵢ` on the right), once we are allowed to divide by `k!`.

  ## The headline

      `esymm σ R k ∈ Algebra.adjoin ℚ (Set.range (psum σ R))`

  for every commutative ℚ-algebra `R`: the `k`-th elementary symmetric
  polynomial lies in the ℚ-subalgebra generated by the power sums.  This is
  the precise sense in which "`eₖ` is a polynomial in the power sums" — the
  classical fact that, *over a field of characteristic 0*, the power sums
  generate the ring of symmetric functions.  Mathlib provides the forward
  Newton identity (`MvPolynomial.psum_eq_mul_esymm_sub_sum`) but no statement
  that the power sums generate the `eₖ`.

  The proof is strong induction on `k`.  The dual recurrence gives
  `(-1)^(k+1)·k·eₖ ∈ A` (with `A` the subalgebra), because `pₖ` is a generator
  and every lower `eᵢ` is in `A` by the induction hypothesis.  Multiplying by
  the unit `(-1)^(k+1)` yields `k·eₖ ∈ A`, and dividing by the rational unit `k`
  (here we use `Algebra ℚ R`) yields `eₖ ∈ A`.

  ## Concrete instances (valid over any CommRing — no division needed)

  Clearing denominators turns the first few cases into integral identities:

      e₁ = p₁,    2·e₂ = p₁² − p₂,    6·e₃ = p₁³ − 3·p₁·p₂ + 2·p₃,

  each a direct specialisation of the parent's `psum_recurrence`.  They make the
  "`eₖ` is a polynomial in the `pᵢ` over ℚ" statement explicit and verifiable.

  Status: PROVED — strong induction on the dual Newton–Girard recurrence
  Axioms: 0, Sorries: 0
  Tags: algebra, symmetric-functions, newton-girard, power-sums, mv-polynomial
-/

import Mathlib
import Proofs.AmgmInequalityOQ02OQ01OQ02OQ01OQ01OQ01

namespace AmgmInequalityOQ02OQ01OQ02OQ01OQ01OQ01OQ01

open MvPolynomial Finset BigOperators
open AmgmInequalityOQ02OQ01OQ02OQ01OQ01OQ01

-- ============================================================
-- Concrete integral instances (any CommRing)
-- ============================================================

section Integral

variable (σ : Type*) (R : Type*) [CommRing R] [Fintype σ]

/-- `e₁ = p₁`. The first power sum already equals the first elementary
symmetric polynomial. -/
theorem esymm_one_eq_psum : esymm σ R 1 = psum σ R 1 := by
  have h := psum_recurrence σ R 1 (by norm_num)
  rw [Finset.Ico_self, Finset.sum_empty] at h
  linear_combination -h

/-- `2·e₂ = p₁² − p₂`. Over a ℚ-algebra this reads `e₂ = (p₁² − p₂)/2`, the
classical formula expressing the second elementary symmetric polynomial through
the power sums. -/
theorem two_esymm_two :
    (2 : MvPolynomial σ R) * esymm σ R 2 = psum σ R 1 ^ 2 - psum σ R 2 := by
  have h := psum_recurrence σ R 2 (by norm_num)
  have h1 := esymm_one_eq_psum σ R
  rw [show Finset.Ico 1 2 = {1} from by decide, Finset.sum_singleton] at h
  simp only [show (2 : ℕ) - 1 = 1 from rfl] at h
  linear_combination h + (psum σ R 1) * h1

/-- `6·e₃ = p₁³ − 3·p₁·p₂ + 2·p₃`. Over a ℚ-algebra this is `e₃ =
(p₁³ − 3·p₁·p₂ + 2·p₃)/6`. -/
theorem six_esymm_three :
    (6 : MvPolynomial σ R) * esymm σ R 3 =
      psum σ R 1 ^ 3 - 3 * psum σ R 1 * psum σ R 2 + 2 * psum σ R 3 := by
  have h := psum_recurrence σ R 3 (by norm_num)
  have h1 := esymm_one_eq_psum σ R
  have h2 := two_esymm_two σ R
  rw [show Finset.Ico 1 3 = {1, 2} from by decide,
      Finset.sum_pair (by decide : (1 : ℕ) ≠ 2)] at h
  simp only [show (3 : ℕ) - 1 = 2 from rfl, show (3 : ℕ) - 2 = 1 from rfl] at h
  linear_combination (-2 : MvPolynomial σ R) * h + (-2 * psum σ R 2) * h1 +
    (psum σ R 1) * h2

end Integral

-- ============================================================
-- Main theorem: eₖ lies in the ℚ-subalgebra generated by power sums
-- ============================================================

section RatAlgebra

variable (σ : Type*) (R : Type*) [CommRing R] [Algebra ℚ R] [Fintype σ]

/-- The ℚ-subalgebra of `MvPolynomial σ R` generated by all the power sums. -/
private abbrev psumAdjoin : Subalgebra ℚ (MvPolynomial σ R) :=
  Algebra.adjoin ℚ (Set.range (psum σ R))

/-- **Reverse Newton's identities.** Over any commutative ℚ-algebra `R`, the
`k`-th elementary symmetric polynomial lies in the ℚ-subalgebra generated by the
power sums:

  `esymm σ R k ∈ Algebra.adjoin ℚ (Set.range (psum σ R))`.

Equivalently, `eₖ` is a polynomial (with rational coefficients) in the power
sums `p₁, …, pₖ`.  This is the reverse of the parent entry's forward recurrence
and the precise statement of the classical fact that, in characteristic 0, the
power sums generate the ring of symmetric functions.

The proof is strong induction on `k` via the dual recurrence
`mul_esymm_recurrence`, dividing by the rational unit `k` at each step. -/
theorem esymm_mem_adjoin_psum (k : ℕ) : esymm σ R k ∈ psumAdjoin σ R := by
  have hp : ∀ n, psum σ R n ∈ psumAdjoin σ R := fun n => Algebra.subset_adjoin ⟨n, rfl⟩
  have hneg : (-1 : MvPolynomial σ R) ∈ psumAdjoin σ R := neg_mem (one_mem _)
  induction k using Nat.strongRecOn with
  | ind k ih =>
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk; rw [esymm_zero]; exact one_mem _
    · -- The dual recurrence puts `(-1)^(k+1) · k · eₖ` into the subalgebra.
      have hrec := mul_esymm_recurrence σ R k hk
      have hsum : (∑ i ∈ Finset.Ico 1 k,
          (-1 : MvPolynomial σ R) ^ (i + 1) * esymm σ R i * psum σ R (k - i))
          ∈ psumAdjoin σ R := by
        refine sum_mem (fun i hi => ?_)
        rw [Finset.mem_Ico] at hi
        exact mul_mem (mul_mem (pow_mem hneg _) (ih i hi.2)) (hp _)
      have hRHS : (-1 : MvPolynomial σ R) ^ (k + 1) * (k : MvPolynomial σ R) * esymm σ R k
          ∈ psumAdjoin σ R := by
        rw [hrec]; exact sub_mem (hp k) hsum
      -- Multiply by the unit `(-1)^(k+1)` to obtain `k · eₖ ∈ A`.
      have hsq : (-1 : MvPolynomial σ R) ^ (k + 1) * (-1 : MvPolynomial σ R) ^ (k + 1) = 1 := by
        rw [← mul_pow]; norm_num
      have hke : (k : MvPolynomial σ R) * esymm σ R k ∈ psumAdjoin σ R := by
        have hmul := mul_mem (pow_mem hneg (k + 1)) hRHS
        have heq : (-1 : MvPolynomial σ R) ^ (k + 1) *
            ((-1 : MvPolynomial σ R) ^ (k + 1) * (k : MvPolynomial σ R) * esymm σ R k)
            = (k : MvPolynomial σ R) * esymm σ R k := by
          rw [show (-1 : MvPolynomial σ R) ^ (k + 1) *
                ((-1 : MvPolynomial σ R) ^ (k + 1) * (k : MvPolynomial σ R) * esymm σ R k)
              = ((-1 : MvPolynomial σ R) ^ (k + 1) * (-1 : MvPolynomial σ R) ^ (k + 1)) *
                ((k : MvPolynomial σ R) * esymm σ R k) from by ring, hsq, one_mul]
        rwa [heq] at hmul
      -- Divide by the rational unit `k`.
      have hk0 : (k : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
      have hone : algebraMap ℚ (MvPolynomial σ R) ((k : ℚ)⁻¹) * (k : MvPolynomial σ R) = 1 := by
        rw [← map_natCast (algebraMap ℚ (MvPolynomial σ R)) k, ← map_mul,
            inv_mul_cancel₀ hk0, map_one]
      have hsplit : esymm σ R k = algebraMap ℚ (MvPolynomial σ R) ((k : ℚ)⁻¹) *
          ((k : MvPolynomial σ R) * esymm σ R k) := by
        rw [← mul_assoc, hone, one_mul]
      rw [hsplit]
      exact mul_mem (Subalgebra.algebraMap_mem _ _) hke

end RatAlgebra

end AmgmInequalityOQ02OQ01OQ02OQ01OQ01OQ01OQ01
