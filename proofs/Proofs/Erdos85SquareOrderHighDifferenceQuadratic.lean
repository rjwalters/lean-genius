import Proofs.Erdos85SquareOrderHighRootKernel

/-!
# The quadratic adjacency sector generated by high differences

At square order, adjacency exchanges a difference of high coordinate vectors
with the corresponding difference of high incidence rows, up to the scalar
`d`.  Hence both families lie in the `A² = d I` sector.
-/

open SimpleGraph

namespace Erdos85

noncomputable section

/-- Difference of two adjacency rows. -/
def squareOrderHighRowDifference
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (a b : V) : V → ℤ :=
  fun x => G.adjMatrix ℤ a x - G.adjMatrix ℤ b x

/-- Difference of two standard coordinate vectors. -/
def coordinateDifference
    {V : Type*} [DecidableEq V] (a b : V) : V → ℤ :=
  fun x => (if x = a then 1 else 0) - (if x = b then 1 else 0)

private theorem adjMatrix_mulVec_adjRow_eq_card_common
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (a x : V) :
    (G.adjMatrix ℤ).mulVec (fun y => G.adjMatrix ℤ a y) x =
      ((G.neighborFinset a ∩ G.neighborFinset x).card : ℤ) := by
  calc
    (G.adjMatrix ℤ).mulVec (fun y => G.adjMatrix ℤ a y) x =
        (G.adjMatrix ℤ * G.adjMatrix ℤ) a x := by
      simp only [Matrix.mulVec, dotProduct, Matrix.mul_apply]
      apply Finset.sum_congr rfl
      intro y _
      simp [SimpleGraph.adjMatrix_apply, G.adj_comm, mul_comm]
    _ = _ := by
      rw [adjMatrix_sq_apply_eq_card_common]

/-- Adjacency sends a high incidence-row difference to `d` times the
corresponding coordinate difference. -/
theorem squareOrder_adjMatrix_mulVec_highRowDifference
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [DecidableRel (antipodalGraph G).Adj]
    [DecidableRel (triangleFreeEdgeGraph G).Adj]
    (hfree : ¬ containsC4 V G)
    {d : Nat} (hd : 2 ≤ d) (hmin : ∀ x : V, d ≤ G.degree x)
    (hcard : Fintype.card V = d * d)
    {a b : V} (ha : G.degree a = d + 1) (hb : G.degree b = d + 1) :
    (G.adjMatrix ℤ).mulVec (squareOrderHighRowDifference G a b) =
      fun x => (d : ℤ) * coordinateDifference a b x := by
  funext x
  simp only [squareOrderHighRowDifference, Matrix.mulVec, dotProduct]
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib]
  rw [show (∑ y, G.adjMatrix ℤ x y * G.adjMatrix ℤ a y) =
      ((G.neighborFinset a ∩ G.neighborFinset x).card : ℤ) by
    simpa [Matrix.mulVec, dotProduct, G.adj_comm, mul_comm] using
      adjMatrix_mulVec_adjRow_eq_card_common G a x]
  rw [show (∑ y, G.adjMatrix ℤ x y * G.adjMatrix ℤ b y) =
      ((G.neighborFinset b ∩ G.neighborFinset x).card : ℤ) by
    simpa [Matrix.mulVec, dotProduct, G.adj_comm, mul_comm] using
      adjMatrix_mulVec_adjRow_eq_card_common G b x]
  have hcommonA :
      (G.neighborFinset a ∩ G.neighborFinset x).card =
        if x = a then d + 1 else 1 := by
    by_cases hxa : x = a
    · subst x
      simp [G.card_neighborFinset_eq_degree, ha]
    · rw [if_neg hxa]
      exact squareOrder_card_common_highRoot_eq_one
        G hfree hd hmin hcard ha (Ne.symm hxa)
  have hcommonB :
      (G.neighborFinset b ∩ G.neighborFinset x).card =
        if x = b then d + 1 else 1 := by
    by_cases hxb : x = b
    · subst x
      simp [G.card_neighborFinset_eq_degree, hb]
    · rw [if_neg hxb]
      exact squareOrder_card_common_highRoot_eq_one
        G hfree hd hmin hcard hb (Ne.symm hxb)
  rw [hcommonA, hcommonB]
  simp only [coordinateDifference]
  split_ifs <;> push_cast <;> ring

/-- Adjacency sends a coordinate difference to the matching incidence-row
difference. -/
theorem squareOrder_adjMatrix_mulVec_coordinateDifference
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (a b : V) :
    (G.adjMatrix ℤ).mulVec (coordinateDifference a b) =
      squareOrderHighRowDifference G a b := by
  funext x
  simp only [Matrix.mulVec, dotProduct, coordinateDifference]
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib]
  have hone : ∀ c : V,
      (∑ y, G.adjMatrix ℤ x y * (if y = c then 1 else 0)) =
        G.adjMatrix ℤ x c := by
    intro c
    simp
  rw [hone a, hone b]
  simp [squareOrderHighRowDifference, SimpleGraph.adjMatrix_apply, G.adj_comm]

/-- Every high incidence-row difference is killed by `A²-dI`. -/
theorem squareOrder_adjMatrix_sq_mulVec_highRowDifference
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [DecidableRel (antipodalGraph G).Adj]
    [DecidableRel (triangleFreeEdgeGraph G).Adj]
    (hfree : ¬ containsC4 V G)
    {d : Nat} (hd : 2 ≤ d) (hmin : ∀ x : V, d ≤ G.degree x)
    (hcard : Fintype.card V = d * d)
    {a b : V} (ha : G.degree a = d + 1) (hb : G.degree b = d + 1) :
    ((G.adjMatrix ℤ) * (G.adjMatrix ℤ)).mulVec
        (squareOrderHighRowDifference G a b) =
      fun x => (d : ℤ) * squareOrderHighRowDifference G a b x := by
  rw [← Matrix.mulVec_mulVec]
  rw [squareOrder_adjMatrix_mulVec_highRowDifference
    G hfree hd hmin hcard ha hb]
  funext x
  simp only [Matrix.mulVec, dotProduct]
  calc
    (∑ y, G.adjMatrix ℤ x y *
        ((d : ℤ) * coordinateDifference a b y)) =
        (d : ℤ) * ∑ y,
          G.adjMatrix ℤ x y * coordinateDifference a b y := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro y _
      ring
    _ = (d : ℤ) * squareOrderHighRowDifference G a b x := by
      rw [show (∑ y, G.adjMatrix ℤ x y * coordinateDifference a b y) =
          squareOrderHighRowDifference G a b x by
        have h := congrFun
          (squareOrder_adjMatrix_mulVec_coordinateDifference G a b) x
        simpa [Matrix.mulVec, dotProduct] using h]

end

end Erdos85
