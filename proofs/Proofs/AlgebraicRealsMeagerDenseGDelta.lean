import Mathlib.Topology.GDelta.Basic
import Mathlib.Topology.Baire.Lemmas
import Mathlib.RingTheory.Algebraic.Basic
import Mathlib.Topology.Algebra.Order.Archimedean
import Mathlib.Tactic
import Proofs.AlgebraicRealsMeager

/-!
# The Transcendental Reals are an Explicit Dense Gδ

## Open Question (algebraic-reals-meager-oq-02)

The parent entry `algebraic-reals-meager` proves that the algebraic reals
`{x : ℝ | IsAlgebraic ℚ x}` are **meagre** and that the transcendentals are therefore
**residual** (comeagre) and **dense**. Its second open question asks to

> "Quantify the comeagre transcendental complement as an explicit dense Gδ set,
>  exhibiting the residual witness from `mem_residual` concretely rather than abstractly."

`residual` is, by definition, only the filter *generated by* dense Gδ sets, so
`transcendentalReals_residual` asserts the transcendentals *contain* a dense Gδ without
naming one. This entry closes that gap by exhibiting the transcendentals as themselves a
concrete dense Gδ:

    {x : ℝ | ¬ IsAlgebraic ℚ x}  =  ⋂_{a algebraic} {a}ᶜ

a countable intersection of open sets (each `{a}ᶜ` is open since `ℝ` is `T1`), dense because
its complement is meagre. This is the strictly stronger structural statement: residual means
"contains a dense Gδ"; here the set *is* a dense Gδ.

The argument is abstracted to its natural generality — in any `T1` space the complement of a
*countable* set is a Gδ, and in a perfect `T1` Baire space it is moreover dense — mirroring
Mathlib's treatment of the irrationals (`IsGδ.setOf_irrational`, `dense_irrational`).

As a dual corollary we obtain the analogue of the classical fact that `ℚ` is **not** a Gδ: the
algebraic reals, being a *dense* set that is *meagre*, cannot be a Gδ — for a dense Gδ is
residual, and no nonempty Baire space has a set that is simultaneously meagre and residual.

## Main Results

* `isGδ_compl_of_countable`: in any `T1` space, the complement of a countable set is a Gδ.
* `isGδ_dense_compl_of_countable`: in a perfect `T1` Baire space, the complement of a countable
  set is a dense Gδ.
* `not_isGδ_of_dense_isMeagre`: a dense meagre set in a nonempty Baire space is never a Gδ.
* `transcendentalReals_dense_isGδ`: **the headline** — the transcendental reals are an explicit
  dense Gδ in `ℝ`, the concrete residual witness requested by the open question.
* `algebraicReals_not_isGδ`: the algebraic reals are **not** a Gδ (the `ℚ`-is-not-Gδ phenomenon).
-/

open Set Topology

namespace AlgebraicRealsMeagerDenseGDelta

/-! ### Abstract lemmas: complements of countable sets -/

/-- **In a `T1` space the complement of a countable set is a Gδ.**

`sᶜ = ⋂_{a ∈ s} {a}ᶜ` is a countable intersection of open sets: each singleton `{a}` is closed
(`T1`), so each `{a}ᶜ` is open, and the family is indexed by the countable set `s`. -/
theorem isGδ_compl_of_countable {X : Type*} [TopologicalSpace X] [T1Space X]
    {s : Set X} (hs : s.Countable) : IsGδ sᶜ := by
  have hcov : sᶜ = ⋂ a ∈ s, ({a}ᶜ : Set X) := by
    ext x
    simp only [mem_compl_iff, mem_iInter, mem_singleton_iff]
    constructor
    · intro hx a ha hxa; exact hx (hxa ▸ ha)
    · intro h hx; exact h x hx rfl
  rw [hcov]
  exact IsGδ.biInter_of_isOpen hs (fun a _ => isOpen_compl_singleton)

/-- **In a perfect `T1` Baire space the complement of a countable set is dense.**

The countable set is meagre (`AlgebraicRealsMeager.countable_isMeagre`), and the complement of a
meagre set is residual, hence dense. -/
theorem dense_compl_of_countable {X : Type*} [TopologicalSpace X] [T1Space X]
    [PerfectSpace X] [BaireSpace X] {s : Set X} (hs : s.Countable) : Dense sᶜ := by
  have hm : IsMeagre s := AlgebraicRealsMeager.countable_isMeagre hs
  exact dense_of_mem_residual hm

/-- **In a perfect `T1` Baire space the complement of a countable set is a dense Gδ.**

The abstract form of the open question: it packages the Gδ structure together with density,
turning the bare "residual" assertion into a named dense Gδ set. -/
theorem isGδ_dense_compl_of_countable {X : Type*} [TopologicalSpace X] [T1Space X]
    [PerfectSpace X] [BaireSpace X] {s : Set X} (hs : s.Countable) :
    IsGδ sᶜ ∧ Dense sᶜ :=
  ⟨isGδ_compl_of_countable hs, dense_compl_of_countable hs⟩

/-- **A dense meagre set in a nonempty Baire space is never a Gδ.**

If a dense set `s` were a Gδ it would be residual (`residual_of_dense_Gδ`); but then both `s`
(meagre by hypothesis) and `sᶜ` (residual, i.e. `s` residual makes `sᶜ` meagre) would be meagre,
so their union `univ` would be meagre — contradicting that a nonempty Baire space is not meagre
in itself. This is the abstract mechanism behind "`ℚ` is not a Gδ". -/
theorem not_isGδ_of_dense_isMeagre {X : Type*} [TopologicalSpace X] [BaireSpace X]
    [Nonempty X] {s : Set X} (hd : Dense s) (hm : IsMeagre s) : ¬ IsGδ s := by
  intro hg
  have hres : s ∈ residual X := residual_of_dense_Gδ hg hd
  have hmc : IsMeagre sᶜ := by
    show (sᶜ)ᶜ ∈ residual X
    rw [compl_compl]; exact hres
  have huniv : IsMeagre (univ : Set X) := by
    have hu := hm.union hmc
    rwa [union_compl_self] at hu
  exact not_isMeagre_of_isOpen isOpen_univ univ_nonempty huniv

/-! ### The transcendental reals as a concrete dense Gδ -/

/-- **The transcendental reals are a Gδ in `ℝ`.**

`{x | ¬ IsAlgebraic ℚ x}` is the complement of the countable algebraic reals
(`AlgebraicNumbersCountable.algebraic_reals_countable`), and `ℝ` is `T1`. -/
theorem transcendentalReals_isGδ : IsGδ {x : ℝ | ¬ IsAlgebraic ℚ x} := by
  have h : {x : ℝ | ¬ IsAlgebraic ℚ x} = {x : ℝ | IsAlgebraic ℚ x}ᶜ := by
    ext x; simp only [mem_compl_iff, mem_setOf_eq]
  rw [h]
  exact isGδ_compl_of_countable AlgebraicNumbersCountable.algebraic_reals_countable

/-- **The transcendental reals are an explicit dense Gδ in `ℝ`.**

This is the concrete residual witness requested by the open question: the parent's
`transcendentalReals_residual` only asserts membership in the `residual` filter, whereas here the
transcendentals are exhibited *as* a named dense Gδ set. -/
theorem transcendentalReals_dense_isGδ :
    IsGδ {x : ℝ | ¬ IsAlgebraic ℚ x} ∧ Dense {x : ℝ | ¬ IsAlgebraic ℚ x} :=
  ⟨transcendentalReals_isGδ, AlgebraicRealsMeager.transcendentalReals_dense⟩

/-- **Residual, recovered from the explicit dense Gδ.**

A second route to `transcendentalReals_residual`: rather than passing through meagreness of the
complement, derive membership in `residual ℝ` directly from the now-explicit dense Gδ structure
via `residual_of_dense_Gδ`. -/
theorem transcendentalReals_residual_of_dense_Gδ :
    {x : ℝ | ¬ IsAlgebraic ℚ x} ∈ residual ℝ :=
  residual_of_dense_Gδ transcendentalReals_isGδ AlgebraicRealsMeager.transcendentalReals_dense

/-! ### The algebraic reals are dense but not a Gδ -/

/-- **The algebraic reals are dense in `ℝ`.**

They contain every rational (`isAlgebraic_rat`), and the rationals are dense
(`Rat.denseRange_cast`). -/
theorem algebraicReals_dense : Dense {x : ℝ | IsAlgebraic ℚ x} := by
  have hsub : Set.range ((↑) : ℚ → ℝ) ⊆ {x : ℝ | IsAlgebraic ℚ x} := by
    rw [range_subset_iff]
    intro q
    exact isAlgebraic_rat ℚ q
  exact Dense.mono hsub Rat.denseRange_cast

/-- **The algebraic reals are not a Gδ in `ℝ` — the `ℚ`-is-not-Gδ phenomenon.**

They are dense (containing `ℚ`) yet meagre (`AlgebraicRealsMeager.algebraicReals_isMeagre`); a
dense Gδ is residual, and no nonempty Baire space carries a set that is at once meagre and
residual. Contrast the transcendentals, which *are* a dense Gδ. -/
theorem algebraicReals_not_isGδ : ¬ IsGδ {x : ℝ | IsAlgebraic ℚ x} :=
  not_isGδ_of_dense_isMeagre algebraicReals_dense AlgebraicRealsMeager.algebraicReals_isMeagre

end AlgebraicRealsMeagerDenseGDelta

#print axioms AlgebraicRealsMeagerDenseGDelta.isGδ_compl_of_countable
#print axioms AlgebraicRealsMeagerDenseGDelta.isGδ_dense_compl_of_countable
#print axioms AlgebraicRealsMeagerDenseGDelta.not_isGδ_of_dense_isMeagre
#print axioms AlgebraicRealsMeagerDenseGDelta.transcendentalReals_dense_isGδ
#print axioms AlgebraicRealsMeagerDenseGDelta.transcendentalReals_residual_of_dense_Gδ
#print axioms AlgebraicRealsMeagerDenseGDelta.algebraicReals_not_isGδ
