import Mathlib.RingTheory.MvPolynomial.Symmetric.FundamentalTheorem
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.AlgebraicIndependent.Basic
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
import Mathlib.Tactic

/-!
# Hilbert 14 OQ-02 / OQ-01: sharpness of the degree bound `β(Sₙ) = n`

The parent entry (`hilbert-14-oq-02`) settles the **upper bound** of Hilbert's 14th-problem
degree question for the fundamental example, the symmetric group `Sₙ` acting on
`R[x₁,…,xₙ]` by permuting variables. It packages the Fundamental Theorem of Symmetric
Polynomials to show the invariant ring is generated by the `n` elementary symmetric
polynomials `e₁,…,eₙ`, with `eₖ` homogeneous of degree `k`, giving `β(Sₙ) ≤ n`.

This entry proves the **complementary lower bound**, i.e. that the bound is *sharp*:

> The top generator `eₙ` is **transcendental over** the subalgebra `R[e₁,…,e_{n-1}]`
> generated by the lower elementary symmetric polynomials. In particular `eₙ ∉ R[e₁,…,e_{n-1}]`,
> so `eₙ` is a genuinely new generator at degree exactly `n` and the degree bound cannot be
> lowered: `β(Sₙ) ≥ n`, hence `β(Sₙ) = n`.

The argument is short and structural: the elementary symmetric polynomials `e₁,…,eₙ` are
algebraically independent (the parent's "optimal *number*" fact), and a member of an
algebraically independent family is always transcendental over the subalgebra generated by
the others (`AlgebraicIndependent.transcendental_adjoin`). Specialising the family to its top
index `eₙ` and the rest `e₁,…,e_{n-1}` gives the result.

## Main results

* `esymm_top_transcendental_over_lower` : `eₙ` is transcendental over `R[e₁,…,e_{n-1}]`.
* `esymm_top_not_mem_adjoin_lower` : `eₙ ∉ R[e₁,…,e_{n-1}]` — the sharp lower bound `β(Sₙ) ≥ n`.
* `esymm_lower_totalDegree_lt` : each lower generator `eⱼ₊₁` has total degree `< n`.
* `beta_sharp_witness` : the capstone — `eₙ` is a symmetric (invariant) polynomial,
  homogeneous of degree exactly `n`, that is not generated by the lower elementary symmetric
  polynomials (all of degree `< n`). So no generating family in degrees `< n` produces it,
  witnessing `β(Sₙ) = n`.
-/

namespace Hilbert14OQ02OQ01

open MvPolynomial Finset

variable {σ : Type*} [Fintype σ] [DecidableEq σ] {R : Type*} [CommRing R]

/-- **Optimal number of generators** (re-proved self-contained from the Fundamental Theorem of
    Symmetric Polynomials). The elementary symmetric polynomials `e₁,…,eₙ` are algebraically
    independent over `R` (when `|σ| = n`). -/
theorem esymm_algebraicIndependent {n : ℕ} (hn : Fintype.card σ = n) :
    AlgebraicIndependent R (fun i : Fin n => esymm σ R (i + 1)) := by
  rw [algebraicIndependent_iff_injective_aeval]
  have hcomp : (aeval (fun i : Fin n => esymm σ R (i + 1)) :
        MvPolynomial (Fin n) R →ₐ[R] MvPolynomial σ R)
      = (symmetricSubalgebra σ R).val.comp (esymmAlgHom σ R n) := by
    ext i
    simp [esymmAlgHom]
  rw [hcomp, AlgHom.coe_comp]
  exact (Subtype.val_injective).comp (esymmAlgHom_injective R hn.ge)

/-- **The generator `eₖ` is homogeneous of degree `k`** (re-proved self-contained). Each
    elementary symmetric polynomial `eₖ = ∑_{|t|=k} ∏_{i∈t} xᵢ` is a sum of squarefree
    degree-`k` monomials. -/
theorem esymm_isHomogeneous (k : ℕ) : (esymm σ R k).IsHomogeneous k := by
  rw [esymm_eq_sum_monomial]
  apply MvPolynomial.IsHomogeneous.sum
  intro t ht
  rw [mem_powersetCard] at ht
  apply MvPolynomial.isHomogeneous_monomial
  have hdeg : (∑ i ∈ t, Finsupp.single i (1 : ℕ)).degree = t.card := by
    rw [map_sum]
    simp [Finsupp.degree_single]
  rw [hdeg, ht.2]

/-- **Sharp lower bound (transcendence form).** When `|σ| = m + 1`, the top elementary
    symmetric polynomial `e_{m+1}` is *transcendental* over the subalgebra
    `R[e₁,…,e_m]` generated by the lower elementary symmetric polynomials. -/
theorem esymm_top_transcendental_over_lower {m : ℕ} (hσ : Fintype.card σ = m + 1) :
    Transcendental (Algebra.adjoin R (Set.range (fun j : Fin m => esymm σ R (j + 1))))
      (esymm σ R (m + 1)) := by
  have hind := esymm_algebraicIndependent (R := R) (n := m + 1) hσ
  -- The image of the "all but the last index" set is exactly the lower generators.
  have himg : (fun i : Fin (m + 1) => esymm σ R (i + 1)) '' Set.range Fin.castSucc
      = Set.range (fun j : Fin m => esymm σ R (j + 1)) := by
    rw [← Set.range_comp]
    apply congrArg
    funext j
    simp [Function.comp, Fin.coe_castSucc]
  -- The last index is not among the first `m`.
  have hi : Fin.last m ∉ Set.range (Fin.castSucc : Fin m → Fin (m + 1)) := by
    rintro ⟨j, hj⟩
    exact absurd hj (Fin.castSucc_lt_last j).ne
  have h := hind.transcendental_adjoin (s := Set.range Fin.castSucc) (i := Fin.last m) hi
  rw [himg] at h
  simpa [Fin.val_last] using h

/-- **Sharp lower bound (`β(Sₙ) ≥ n`).** When `|σ| = m + 1`, the top elementary symmetric
    polynomial `e_{m+1}` does **not** lie in the subalgebra `R[e₁,…,e_m]` generated by the
    lower elementary symmetric polynomials: it is a genuinely new generator at degree `m + 1`.
    The parent's upper bound `β(Sₙ) ≤ n` together with this gives `β(Sₙ) = n`. -/
theorem esymm_top_not_mem_adjoin_lower [Nontrivial R] {m : ℕ}
    (hσ : Fintype.card σ = m + 1) :
    esymm σ R (m + 1) ∉
      Algebra.adjoin R (Set.range (fun j : Fin m => esymm σ R (j + 1))) := by
  intro hmem
  haveI : Nontrivial ↥(Algebra.adjoin R (Set.range (fun j : Fin m => esymm σ R (j + 1)))) :=
    nontrivial_of_ne ⟨0, Subalgebra.zero_mem _⟩ ⟨1, Subalgebra.one_mem _⟩
      (by simp [Subtype.ext_iff])
  exact esymm_top_transcendental_over_lower hσ
    (isAlgebraic_algebraMap (⟨esymm σ R (m + 1), hmem⟩ :
      Algebra.adjoin R (Set.range (fun j : Fin m => esymm σ R (j + 1)))))

/-- Each lower generator `eⱼ₊₁` (with `j : Fin m`) has total degree `< m + 1`: the lower
    elementary symmetric polynomials all live in degrees `≤ m = n - 1`. -/
theorem esymm_lower_totalDegree_lt {m : ℕ} (j : Fin m) :
    (esymm σ R (j + 1) : MvPolynomial σ R).totalDegree < m + 1 :=
  lt_of_le_of_lt (esymm_isHomogeneous (j + 1)).totalDegree_le (by omega)

/-- **Capstone: `β(Sₙ) = n` is sharp, witnessed by `eₙ`.** When `|σ| = m + 1`, the top
    elementary symmetric polynomial `e_{m+1} = x₁⋯x_{m+1}` is simultaneously:

    1. a symmetric polynomial (an `Sₙ`-invariant);
    2. homogeneous of degree exactly `n = m + 1` (its degree is not below `n`); and
    3. **not** contained in the subalgebra generated by the lower elementary symmetric
       polynomials `e₁,…,eₘ`, each of which has total degree `< n`.

    Hence the optimal generating degree for the `Sₙ`-invariants cannot be reduced below `n`:
    combined with the parent's `β(Sₙ) ≤ n`, this gives `β(Sₙ) = n`. -/
theorem beta_sharp_witness [Nontrivial R] {m : ℕ} (hσ : Fintype.card σ = m + 1) :
    (esymm σ R (m + 1)).IsSymmetric ∧
      (esymm σ R (m + 1) : MvPolynomial σ R).IsHomogeneous (m + 1) ∧
      esymm σ R (m + 1) ∉
        Algebra.adjoin R (Set.range (fun j : Fin m => esymm σ R (j + 1))) :=
  ⟨esymm_isSymmetric σ R (m + 1), esymm_isHomogeneous (m + 1),
    esymm_top_not_mem_adjoin_lower hσ⟩

end Hilbert14OQ02OQ01
