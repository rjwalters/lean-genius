import Proofs.Erdos85Problem

/-!
# Connected binary edge-switch spans

The private-switch quotient in the Baer coupling argument is generated by
pair switches along an allowed-pair graph.  This module isolates the general
linear algebra: connectivity lets one transport an endpoint-pair switch
between any two vertices using adjacent switches.
-/

open SimpleGraph

namespace Erdos85

noncomputable section

/-- The binary vector supported on the two endpoints `u,v`. -/
def f2EndpointSwitch {U : Type*} [DecidableEq U] (u v : U) : U → ZMod 2 :=
  Pi.single u 1 + Pi.single v 1

/-- Adjacent endpoint switches of a graph. -/
def f2GraphEdgeSwitches {U : Type*} [DecidableEq U]
    (H : SimpleGraph U) : Set (U → ZMod 2) :=
  {z | ∃ u v, H.Adj u v ∧ z = f2EndpointSwitch u v}

/-- Sum of all binary coordinates. -/
def f2CoordinateSum (U : Type*) [Fintype U] :
    (U → ZMod 2) →ₗ[ZMod 2] ZMod 2 where
  toFun z := ∑ x, z x
  map_add' x y := by simp [Finset.sum_add_distrib]
  map_smul' a x := by simp [Finset.mul_sum]

private theorem zmod2_add_self (z : ZMod 2) : z + z = 0 := by
  calc
    z + z = (2 : ZMod 2) * z := by ring
    _ = 0 := by
      have h2 : (2 : ZMod 2) = 0 := CharP.cast_eq_zero (ZMod 2) 2
      rw [h2, zero_mul]

private theorem f2EndpointSwitch_chain
    {U : Type*} [DecidableEq U] (a b c : U) :
    f2EndpointSwitch a c =
      f2EndpointSwitch a b + f2EndpointSwitch b c := by
  ext x
  change (Pi.single a (1 : ZMod 2) : U → ZMod 2) x +
      (Pi.single c (1 : ZMod 2) : U → ZMod 2) x =
    ((Pi.single a (1 : ZMod 2) : U → ZMod 2) x +
      (Pi.single b (1 : ZMod 2) : U → ZMod 2) x) +
      ((Pi.single b (1 : ZMod 2) : U → ZMod 2) x +
        (Pi.single c (1 : ZMod 2) : U → ZMod 2) x)
  let A := (Pi.single a (1 : ZMod 2) : U → ZMod 2) x
  let B := (Pi.single b (1 : ZMod 2) : U → ZMod 2) x
  let C := (Pi.single c (1 : ZMod 2) : U → ZMod 2) x
  change A + C = (A + B) + (B + C)
  calc
    A + C = A + 0 + C := by simp
    _ = A + (B + B) + C := by rw [zmod2_add_self B]
    _ = (A + B) + (B + C) := by abel

private theorem f2_reachable_induction_of_adj_closed
    {U : Type*} (H : SimpleGraph U) (P : U → Prop)
    (hP : ∀ x y, H.Adj x y → P x → P y) {u v : U}
    (h : H.Reachable u v) (hu : P u) : P v := by
  obtain ⟨p⟩ := h
  induction p with
  | nil => exact hu
  | cons hadj _ ih => exact ih (hP _ _ hadj hu)

/-- Along a reachable pair, the endpoint switch belongs to the span of the
graph's adjacent endpoint switches. -/
theorem f2EndpointSwitch_mem_span_of_reachable
    {U : Type*} [DecidableEq U]
    (H : SimpleGraph U) {u v : U} (huv : H.Reachable u v) :
    f2EndpointSwitch u v ∈
      Submodule.span (ZMod 2) (f2GraphEdgeSwitches H) := by
  let M := Submodule.span (ZMod 2) (f2GraphEdgeSwitches H)
  let P : U → Prop := fun x => f2EndpointSwitch u x ∈ M
  have hu : P u := by
    dsimp only [P]
    have hz : f2EndpointSwitch u u = 0 := by
      ext x
      exact zmod2_add_self
        ((Pi.single u (1 : ZMod 2) : U → ZMod 2) x)
    rw [hz]
    exact M.zero_mem
  have hstep : ∀ x y, H.Adj x y → P x → P y := by
    intro x y hxy hx
    have hxyM : f2EndpointSwitch x y ∈ M := by
      apply Submodule.subset_span
      exact ⟨x, y, hxy, rfl⟩
    change f2EndpointSwitch u y ∈ M
    change f2EndpointSwitch u x ∈ M at hx
    rw [f2EndpointSwitch_chain u x y]
    exact M.add_mem hx hxyM
  exact f2_reachable_induction_of_adj_closed H P hstep huv hu

/-- In a connected graph every endpoint-pair switch is generated by adjacent
switches. -/
theorem f2EndpointSwitch_mem_span_of_connected
    {U : Type*} [Fintype U] [DecidableEq U]
    (H : SimpleGraph U) (hconnected : H.Connected) (u v : U) :
    f2EndpointSwitch u v ∈
      Submodule.span (ZMod 2) (f2GraphEdgeSwitches H) :=
  f2EndpointSwitch_mem_span_of_reachable H (hconnected u v)

/-- Every adjacent switch has zero coordinate sum. -/
theorem f2GraphEdgeSwitches_span_le_coordinateSum_ker
    {U : Type*} [Fintype U] [DecidableEq U]
    (H : SimpleGraph U) :
    Submodule.span (ZMod 2) (f2GraphEdgeSwitches H) ≤
      LinearMap.ker (f2CoordinateSum U) := by
  apply Submodule.span_le.mpr
  intro z hz
  obtain ⟨u, v, _huv, rfl⟩ := hz
  change f2CoordinateSum U (f2EndpointSwitch u v) = 0
  simp [f2CoordinateSum, f2EndpointSwitch, Finset.sum_add_distrib,
    zmod2_add_self]

/-- **Connected binary switch-span theorem.**  In a finite connected graph,
adjacent endpoint switches generate exactly all binary vectors of even
(zero) total coordinate sum. -/
theorem f2GraphEdgeSwitches_span_eq_coordinateSum_ker
    {U : Type*} [Fintype U] [DecidableEq U]
    (H : SimpleGraph U) (hconnected : H.Connected) :
    Submodule.span (ZMod 2) (f2GraphEdgeSwitches H) =
      LinearMap.ker (f2CoordinateSum U) := by
  apply le_antisymm (f2GraphEdgeSwitches_span_le_coordinateSum_ker H)
  intro z hz
  let root : U := Classical.choice hconnected.nonempty
  let w : U → ZMod 2 := ∑ x, z x • f2EndpointSwitch root x
  have hwmem : w ∈ Submodule.span (ZMod 2) (f2GraphEdgeSwitches H) := by
    dsimp only [w]
    apply Submodule.sum_mem
    intro x _
    exact Submodule.smul_mem _ _
      (f2EndpointSwitch_mem_span_of_connected H hconnected root x)
  have hsum : (∑ x, z x) = 0 := by
    exact (LinearMap.mem_ker.mp hz : f2CoordinateSum U z = 0)
  have hw : w = z := by
    ext y
    dsimp only [w]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      f2EndpointSwitch, Pi.add_apply, mul_add, Finset.sum_add_distrib]
    have hfirst : (∑ x, z x *
        (Pi.single root (1 : ZMod 2) : U → ZMod 2) y) = 0 := by
      rw [← Finset.sum_mul, hsum, zero_mul]
    have hsecond : (∑ x, z x *
        (Pi.single x (1 : ZMod 2) : U → ZMod 2) y) = z y := by
      simp [Pi.single_apply]
    rw [hfirst, hsecond, zero_add]
  rw [← hw]
  exact hwmem

end

end Erdos85

#print axioms Erdos85.f2EndpointSwitch_mem_span_of_reachable
#print axioms Erdos85.f2EndpointSwitch_mem_span_of_connected
#print axioms Erdos85.f2GraphEdgeSwitches_span_eq_coordinateSum_ker
