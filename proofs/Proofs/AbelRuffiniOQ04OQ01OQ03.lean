import Mathlib

/-!
# Abel–Ruffini OQ04·OQ01·OQ03 — Factoring the Sylow-elimination lemmas

The verified Abel–Ruffini proof that `x⁵ - 4x + 2` is not solvable by radicals
(`AbelRuffiniOQ04OQ01.lean`) rules out `|Gal| ∈ {10, 20, 40}` with three
essentially **verbatim** `private` lemmas `gal_card_ne_10 / _20 / _40`.  Each is
a Sylow argument on a subgroup `G ≤ S₅` of order `5·m` (`m = 2, 4, 8`):

* the Sylow 5-subgroup `P₅` has order `5` (since `5 ∥ |G|`);
* the number of Sylow 5-subgroups `n₅` divides the index `m` and satisfies
  `n₅ ≡ 1 (mod 5)`, forcing `n₅ = 1`;
* hence `P₅` is **normal** and equals `⟨c⟩` for any order-`5` element `c`,
  so every element normalizes `⟨c⟩`;
* but a transposition cannot normalize a 5-cycle — contradiction.

Only the last bullet is specific to `S₅`.  The first three bullets are a *pure
group-theory* statement depending solely on the **group order** `5·m`, and in
fact solely on the prime `5` being the exact power dividing the order.  This
file factors that shared core into a single generic lemma, and — going one step
beyond the three `S₅` instances — states it for an **arbitrary prime `p`**:

* `zpowers_orderP_normal` — in a finite group of order `p·m` with `p ∤ m` and no
  divisor `d ∣ m` with `d ≡ 1 (mod p)` other than `d = 1`, the cyclic subgroup
  generated by any order-`p` element is normal.  The only structure used is that
  `p` is prime and divides the order exactly once, so the Sylow `p`-subgroup has
  order `p`, the Sylow count `n_p` is forced to `1`, and `⟨c⟩` *is* that unique
  Sylow subgroup.

The Abel–Ruffini application (`p = 5`) is recovered verbatim as the corollary
`zpowers_order5_normal`, which is the shared skeleton of `gal_card_ne_10 / _20 /
_40`.

Everything here is fully abstract (no `Polynomial.Gal`, no permutations) and
avoids `native_decide`, so the file is `0`-sorry / `0`-axiom **verified**.  The
three original orders `10 = 5·2`, `20 = 5·4`, `40 = 5·8` are recovered as the
`example`s at the end, which discharge the `huniq` hypothesis for `m ∈ {2,4,8}`.

## Main results

* `zpowers_orderP_normal` — generic-prime core: in a finite group of order `p·m`
  (`p` prime, `p ∤ m`, `1` the only `≡ 1 (mod p)` divisor of `m`), `⟨c⟩` is
  normal for any order-`p` element `c`.
* `conj_mem_zpowers_orderP` — consequently every element normalizes `⟨c⟩`.
* `zpowers_order5_normal` / `conj_mem_zpowers_order5` — the `p = 5` specializations
  used by the Abel–Ruffini `x⁵-4x+2` proof.
-/

namespace AbelRuffiniSylowElim

open scoped Classical

/-- **Generic-prime Sylow-elimination core.**

In a finite group `G` of order `p·m` (`p` prime) where `p ∤ m` and the only
divisor `d` of `m` with `d ≡ 1 (mod p)` is `d = 1`, the Sylow `p`-subgroup is
unique, hence normal, and equals `⟨c⟩` for any element `c` of order `p`.
Therefore `⟨c⟩` is a normal subgroup.

This is the shared skeleton of the three `private` lemmas
`gal_card_ne_10 / _20 / _40` in the verified Abel–Ruffini `x⁵-4x+2` proof,
lifted to an arbitrary group and parameterized by an **arbitrary prime `p`** and
the order `p·m`.  The `p = 5` case is `zpowers_order5_normal` below. -/
theorem zpowers_orderP_normal {G : Type*} [Group G] [Finite G]
    (p m : ℕ) [hp : Fact p.Prime]
    (hcard : Nat.card G = p * m) (hmp : ¬ (p ∣ m))
    (huniq : ∀ d : ℕ, d ∣ m → d % p = 1 → d = 1)
    (c : G) (hc : orderOf c = p) :
    (Subgroup.zpowers c).Normal := by
  haveI : Fintype G := Fintype.ofFinite G
  have hm0 : m ≠ 0 := by rintro rfl; exact hmp (dvd_zero p)
  -- A Sylow `p`-subgroup has order exactly `p`, since `p ∥ |G|`.
  obtain ⟨P⟩ := Sylow.nonempty (p := p) (G := G)
  have hP_card : Nat.card (↑P : Subgroup G) = p := by
    have hpart : (p * m).factorization p = 1 := by
      rw [Nat.factorization_mul hp.out.ne_zero hm0, Finsupp.add_apply,
        Nat.Prime.factorization hp.out, Finsupp.single_eq_same,
        Nat.factorization_eq_zero_of_not_dvd hmp]
    rw [P.card_eq_multiplicity, hcard, hpart, pow_one]
  -- Sylow's third theorem: `n_p ∣ m` and `n_p ≡ 1 (mod p)`, forcing `n_p = 1`.
  have hsylow_one : Nat.card (Sylow p G) = 1 := by
    have h_mod := card_sylow_modEq_one p G
    have h_idx : (↑P : Subgroup G).index = m := by
      have hh := (↑P : Subgroup G).index_mul_card
      rw [hP_card, hcard] at hh
      -- `hh : P.index * p = p * m`; cancel the prime `p` on the right.
      exact Nat.eq_of_mul_eq_mul_right hp.out.pos (hh.trans (Nat.mul_comm p m))
    have h_dvd := Sylow.card_dvd_index P
    rw [h_idx] at h_dvd
    rw [Nat.ModEq, Nat.mod_eq_of_lt hp.out.one_lt] at h_mod
    exact huniq _ h_dvd h_mod
  -- Uniqueness ⇒ the Sylow `p`-subgroup is normal.
  haveI : Subsingleton (Sylow p G) := by
    haveI := Fintype.ofFinite (Sylow p G)
    rw [← Fintype.card_le_one_iff_subsingleton, ← Nat.card_eq_fintype_card]; omega
  haveI hNP : (↑P : Subgroup G).Normal := by
    apply Subgroup.Normal.mk; intro n hn g
    have hs : g • P = P := Subsingleton.elim _ _
    rw [Sylow.smul_eq_iff_mem_normalizer] at hs
    exact ((Subgroup.mem_normalizer_iff.mp hs) n).mp hn
  -- `⟨c⟩` is a subgroup of order `p`, hence equal to the (unique) `P`.
  have hc_P : c ∈ (↑P : Subgroup G) := by
    have h_pg : IsPGroup p (Subgroup.zpowers c) :=
      IsPGroup.iff_card.mpr ⟨1, by rw [pow_one, Nat.card_zpowers, hc]⟩
    obtain ⟨Q, hQ⟩ := h_pg.exists_le_sylow
    exact (Subsingleton.elim Q P : Q = P) ▸ hQ (Subgroup.mem_zpowers c)
  have hzpow_le : Subgroup.zpowers c ≤ ↑P := fun x hx => by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact (↑P : Subgroup G).zpow_mem hc_P k
  have hP_eq : (↑P : Subgroup G) = Subgroup.zpowers c := by
    apply le_antisymm _ hzpow_le
    intro x hx
    have hbij : Function.Bijective (Subgroup.inclusion hzpow_le) := by
      haveI := Fintype.ofFinite ↥(↑P : Subgroup G)
      haveI := Fintype.ofFinite ↥(Subgroup.zpowers c)
      exact (Fintype.bijective_iff_injective_and_card _).mpr
        ⟨Subgroup.inclusion_injective _, by
          rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
              Nat.card_zpowers, hc, hP_card]⟩
    obtain ⟨⟨y, hy⟩, hxy⟩ := hbij.surjective ⟨x, hx⟩
    rwa [show y = x from congr_arg Subtype.val hxy] at hy
  -- Transport normality along `P = ⟨c⟩`.
  rwa [hP_eq] at hNP

/-- Consequence of `zpowers_orderP_normal`: under the same hypotheses, **every**
element `g` normalizes `⟨c⟩`, i.e. `g c g⁻¹ ∈ ⟨c⟩`.  This is exactly the shared
`hconj_zpow` step of `gal_card_ne_10 / _20 / _40`, lifted to arbitrary `p`. -/
theorem conj_mem_zpowers_orderP {G : Type*} [Group G] [Finite G]
    (p m : ℕ) [Fact p.Prime]
    (hcard : Nat.card G = p * m) (hmp : ¬ (p ∣ m))
    (huniq : ∀ d : ℕ, d ∣ m → d % p = 1 → d = 1)
    (c : G) (hc : orderOf c = p) (g : G) :
    g * c * g⁻¹ ∈ Subgroup.zpowers c :=
  (zpowers_orderP_normal p m hcard hmp huniq c hc).conj_mem c (Subgroup.mem_zpowers c) g

/-! ### The `p = 5` specialization used by Abel–Ruffini

The three `private` lemmas in `AbelRuffiniOQ04OQ01.lean` are all the `p = 5`
instance of the generic core. -/

/-- **Sylow-elimination core, `p = 5`.**  The `p = 5` specialization of
`zpowers_orderP_normal`: in a finite group of order `5·m` with `5 ∤ m` and no
divisor `d ∣ m`, `d ≡ 1 (mod 5)` other than `d = 1`, `⟨c⟩` is normal for any
order-`5` element `c`.  This is the shared skeleton of `gal_card_ne_10 / _20 /
_40`. -/
theorem zpowers_order5_normal {G : Type*} [Group G] [Finite G] (m : ℕ)
    (hcard : Nat.card G = 5 * m) (hm5 : ¬ (5 ∣ m))
    (huniq : ∀ d : ℕ, d ∣ m → d % 5 = 1 → d = 1)
    (c : G) (hc : orderOf c = 5) :
    (Subgroup.zpowers c).Normal :=
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  zpowers_orderP_normal 5 m hcard hm5 huniq c hc

/-- Consequence of `zpowers_order5_normal`: under the same hypotheses, **every**
element `g` normalizes `⟨c⟩`, i.e. `g c g⁻¹ ∈ ⟨c⟩`.  This is exactly the shared
`hconj_zpow` step of `gal_card_ne_10 / _20 / _40`. -/
theorem conj_mem_zpowers_order5 {G : Type*} [Group G] [Finite G] (m : ℕ)
    (hcard : Nat.card G = 5 * m) (hm5 : ¬ (5 ∣ m))
    (huniq : ∀ d : ℕ, d ∣ m → d % 5 = 1 → d = 1)
    (c : G) (hc : orderOf c = 5) (g : G) :
    g * c * g⁻¹ ∈ Subgroup.zpowers c :=
  (zpowers_order5_normal m hcard hm5 huniq c hc).conj_mem c (Subgroup.mem_zpowers c) g

/-! ### Recovering the three original orders `10, 20, 40`

The three `private` lemmas in `AbelRuffiniOQ04OQ01.lean` instantiate the core at
`m = 2` (order `10`), `m = 4` (order `20`), and `m = 8` (order `40`).  Each such
instantiation needs the divisor hypothesis `huniq`, verified here once and for
all for the three relevant indices. -/

/-- Order `10 = 5·2`: the only divisor of `2` that is `≡ 1 (mod 5)` is `1`. -/
example : ∀ d : ℕ, d ∣ 2 → d % 5 = 1 → d = 1 := by
  intro d hd hmod; have := Nat.le_of_dvd (by norm_num) hd; interval_cases d <;> omega

/-- Order `20 = 5·4`: the only divisor of `4` that is `≡ 1 (mod 5)` is `1`. -/
example : ∀ d : ℕ, d ∣ 4 → d % 5 = 1 → d = 1 := by
  intro d hd hmod; have := Nat.le_of_dvd (by norm_num) hd; interval_cases d <;> omega

/-- Order `40 = 5·8`: the only divisor of `8` that is `≡ 1 (mod 5)` is `1`.
Note `6 ≡ 1 (mod 5)` but `6 ∤ 8`, so the divisibility hypothesis is essential. -/
example : ∀ d : ℕ, d ∣ 8 → d % 5 = 1 → d = 1 := by
  intro d hd hmod; have := Nat.le_of_dvd (by norm_num) hd; interval_cases d <;> omega

end AbelRuffiniSylowElim
