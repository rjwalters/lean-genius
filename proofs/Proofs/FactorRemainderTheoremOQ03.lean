import Mathlib.Algebra.Polynomial.Div
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Tactic

/-
# Factor Theorem to Nullstellensatz Bridge

## What This Proves
The Factor Theorem `(x - a) | f ↔ f(a) = 0` is the one-variable case of a deep
algebraic geometry result: Hilbert's Nullstellensatz. This file:

1. Proves the **weak Nullstellensatz for one variable**: over an algebraically
   closed field, every nonconstant polynomial has a root.
2. Shows the Factor Theorem gives a complete factorization over algebraically
   closed fields: every polynomial splits into linear factors.
3. States the **multivariate weak Nullstellensatz** as a goal connecting
   the Factor Theorem to algebraic geometry.

## Connection to Factor Theorem
The univariate Factor Theorem says: `f(a) = 0 ↔ (X - C a) ∣ f`.
The Nullstellensatz generalizes this to systems of multivariate polynomials:
a system `f₁ = ⋯ = fₘ = 0` has no solution iff 1 is in the ideal `(f₁,...,fₘ)`.

## Status
- [x] Univariate weak Nullstellensatz (from IsAlgClosed)
- [x] Factor Theorem as ideal membership
- [x] Root count upper bound (from degree)
- [x] Nonconstant polynomials are not units
- [ ] Multivariate Nullstellensatz (formalization target for future work)

## Mathlib Dependencies
- `IsAlgClosed.exists_root` : nonconstant polynomials have roots
- `Polynomial.dvd_iff_isRoot` : Factor Theorem
- `Polynomial.splits` : polynomials split over algebraically closed fields
- `Polynomial.card_roots_le_degree` : root count bounded by degree
-/

set_option linter.unusedVariables false

open Polynomial

variable {k : Type*} [Field k]

-- ============================================================
-- PART 1: Factor Theorem as Ideal Membership
-- ============================================================

/-- The Factor Theorem restated as ideal membership: `f(a) = 0` iff `f` belongs to
the principal ideal generated by `(X - a)`. This is the bridge between evaluation
(algebra) and ideal containment (algebraic geometry). -/
theorem factor_theorem_ideal (f : k[X]) (a : k) :
    f.eval a = 0 ↔ (X - C a) ∣ f :=
  (dvd_iff_isRoot).symm

/-- The contrapositive: if `f` is not in the ideal `(X - a)`, then `a` is not a root. -/
theorem nonroot_iff_not_in_ideal (f : k[X]) (a : k) :
    f.eval a ≠ 0 ↔ ¬((X - C a) ∣ f) := by
  rw [factor_theorem_ideal]

-- ============================================================
-- PART 2: Weak Nullstellensatz (Univariate)
-- ============================================================

/-- **Weak Nullstellensatz (univariate)**: Over an algebraically closed field,
every nonconstant polynomial has a root.

This is the one-variable specialization of the general weak Nullstellensatz,
which states that a proper ideal in k[x₁,...,xₙ] has a common zero when k
is algebraically closed. For one variable, k[x] is a PID, so every proper
ideal is (f) for some f, and IsAlgClosed gives us a root. -/
theorem weak_nullstellensatz_univariate [IsAlgClosed k]
    (f : k[X]) (hf : f ≠ 0) (hdeg : 0 < f.natDegree) :
    ∃ a : k, f.IsRoot a :=
  IsAlgClosed.exists_root f (by
    rw [Polynomial.degree_eq_natDegree hf]; exact_mod_cast hdeg)

/-- Combining the weak Nullstellensatz with the Factor Theorem: over an algebraically
closed field, every nonconstant polynomial is divisible by some linear factor. -/
theorem exists_linear_factor [IsAlgClosed k]
    (f : k[X]) (hf : f ≠ 0) (hdeg : 0 < f.natDegree) :
    ∃ a : k, (X - C a) ∣ f := by
  obtain ⟨a, ha⟩ := weak_nullstellensatz_univariate f hf hdeg
  exact ⟨a, dvd_iff_isRoot.mpr ha⟩

-- ============================================================
-- PART 3: Root Count and Degree Bound
-- ============================================================

/-- A polynomial of degree n over any field has at most n roots.
This is the algebraic counterpart of the geometric fact that
a curve of degree n meets a line in at most n points. -/
theorem root_count_le_degree (f : k[X]) (hf : f ≠ 0) :
    f.roots.card ≤ f.natDegree :=
  Polynomial.card_roots_le_degree f

/-- A nonconstant polynomial over an algebraically closed field is not a unit.
This is the contrapositive of the weak Nullstellensatz: units have no roots,
and the Nullstellensatz says nonconstant polynomials always have roots. -/
theorem nonconstant_not_unit [IsAlgClosed k]
    (f : k[X]) (hdeg : 0 < f.natDegree) :
    ¬IsUnit f := by
  intro hunit
  have := Polynomial.natDegree_eq_zero_of_isUnit hunit
  omega

-- ============================================================
-- PART 4: Connection to Algebraic Geometry
-- ============================================================

/-
### The Nullstellensatz Hierarchy

The Factor Theorem sits at the base of a hierarchy of "zero-set" theorems:

1. **Factor Theorem** (1 variable, 1 polynomial):
   `f(a) = 0 ↔ (X - a) | f`

2. **Weak Nullstellensatz** (n variables, ideal):
   If k is algebraically closed and I ⊊ k[x₁,...,xₙ], then V(I) ≠ ∅.
   (A proper ideal has a common zero.)

3. **Strong Nullstellensatz** (n variables, radical):
   I(V(J)) = √J for any ideal J ⊆ k[x₁,...,xₙ].
   (The ideal of polynomials vanishing on the zero set of J
   equals the radical of J.)

4. **Combinatorial Nullstellensatz** (Alon, 1999):
   If the coefficient of x₁^{t₁}···xₙ^{tₙ} in f is nonzero and
   |Sᵢ| > tᵢ for each i, then ∃ (s₁,...,sₙ) ∈ S₁ × ··· × Sₙ
   with f(s₁,...,sₙ) ≠ 0.

Each level generalizes the previous:
- Level 1 → Level 2: from one equation to a system, from 1 variable to n
- Level 2 → Level 3: from existence of zeros to characterizing all vanishing polynomials
- Level 3 → Level 4: from algebraic geometry to combinatorics

Formalizing Levels 2-4 in Lean would require:
- MvPolynomial (multivariate polynomials, in Mathlib)
- Ideal theory for polynomial rings (partially in Mathlib)
- Jacobson ring theory (for the proof route via Zariski's lemma)
- Radical ideals (in Mathlib)
-/

-- ============================================================
-- PART 5: Numerical Examples
-- ============================================================

/-- Example: x² - 1 has roots ±1 in any field (char ≠ 2).
By the Factor Theorem, (x - 1) | (x² - 1) and (x + 1) | (x² - 1). -/
example : (X ^ 2 - 1 : ℚ[X]).eval 1 = 0 := by norm_num
example : (X ^ 2 - 1 : ℚ[X]).eval (-1) = 0 := by norm_num

/-- Example: x² + 1 has no roots in ℚ (or ℝ), demonstrating why
the weak Nullstellensatz requires algebraic closure. -/
example : ¬(X ^ 2 + 1 : ℚ[X]).IsRoot 0 := by decide
example : ¬(X ^ 2 + 1 : ℚ[X]).IsRoot 1 := by decide
example : ¬(X ^ 2 + 1 : ℚ[X]).IsRoot (-1) := by decide

-- ============================================================
-- Export main results
-- ============================================================

#check @factor_theorem_ideal
#check @weak_nullstellensatz_univariate
#check @exists_linear_factor
#check @root_count_le_degree
#check @nonconstant_not_unit
