import Proofs.CramersRuleOQ05
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Tactic

/-
# Similarity is an Equivalence Relation, Preserved by Polynomial Evaluation (cramers-rule-oq-05-oq-01)

The parent entry `cramers-rule-oq-05` introduced conjugation `conj U N = U N U⁻¹`
of a square matrix by a unit `U` and the induced *similarity* relation

    IsSimilar M N  :=  ∃ U, N = conj U M

recording that similar matrices share their determinant, trace, and characteristic
polynomial.  It proved only reflexivity of `IsSimilar`.

This follow-up answers the parent's first open question:

> Prove that similarity is an equivalence relation (symmetry and transitivity)
> and that `IsSimilar` is preserved by polynomial evaluation `p(M)`.

We prove:

  * `IsSimilar.symm`  — conjugating back by `U⁻¹`;
  * `IsSimilar.trans` — conjugating by the product `V * U`;
  * `isSimilar_equivalence` / `isSimilarSetoid` — the bundled equivalence relation;
  * `IsSimilar.aeval` — if `M ~ N` then `p(M) ~ p(N)` for every polynomial `p : R[X]`,
    where `p(M)` is `Polynomial.aeval M p`.

The polynomial-evaluation invariance is the conceptual payoff: it says the
*entire* commutative subalgebra generated by a matrix (all its polynomial
expressions) is carried along by a change of basis.  The clean way to see this is
that conjugation by a unit is not merely a ring map but an **`R`-algebra
automorphism** `conjAlgEquiv U`, and evaluation of a polynomial commutes with any
algebra homomorphism (`Polynomial.aeval_algHom_apply`).  Combined with the
parent's invariants, this yields, e.g., that `p(M)` and `p(N)` have equal
characteristic polynomial for similar `M, N`.

Status: 0 axioms, 0 sorries
-/

namespace CramersRuleOQ05OQ01

open Matrix Polynomial
open CramersRuleOQ05

variable {n : Type*} [DecidableEq n] [Fintype n]
variable {R : Type*} [CommRing R]

-- ============================================================================
-- Part I: Similarity is an equivalence relation
-- ============================================================================

/-- **Symmetry of similarity.**  If `N = U M U⁻¹` then `M = U⁻¹ N U`, so the roles
of `M` and `N` can be swapped (conjugate back by the inverse unit). -/
theorem IsSimilar.symm {M N : Matrix n n R} (h : IsSimilar M N) : IsSimilar N M := by
  obtain ⟨U, rfl⟩ := h
  refine ⟨U⁻¹, ?_⟩
  have hiu : U⁻¹.val * U.val = (1 : Matrix n n R) := U.inv_mul
  simp only [conj_apply, inv_inv]
  calc M = 1 * M * 1 := by rw [one_mul, mul_one]
    _ = (U⁻¹.val * U.val) * M * (U⁻¹.val * U.val) := by rw [hiu]
    _ = U⁻¹.val * (U.val * M * U⁻¹.val) * U.val := by simp only [mul_assoc]

/-- **Transitivity of similarity.**  If `N = U M U⁻¹` and `P = V N V⁻¹` then
`P = (V U) M (V U)⁻¹`, so `M` is similar to `P` via the product unit `V * U`. -/
theorem IsSimilar.trans {M N P : Matrix n n R}
    (h₁ : IsSimilar M N) (h₂ : IsSimilar N P) : IsSimilar M P := by
  obtain ⟨U, rfl⟩ := h₁
  obtain ⟨V, rfl⟩ := h₂
  refine ⟨V * U, ?_⟩
  have hinv : ((V * U)⁻¹ : (Matrix n n R)ˣ) = U⁻¹ * V⁻¹ := _root_.mul_inv_rev V U
  simp only [conj_apply, Units.val_mul, hinv]
  simp only [mul_assoc]

/-- **Similarity is an equivalence relation** on `Matrix n n R`. -/
theorem isSimilar_equivalence : Equivalence (@IsSimilar n _ _ R _) :=
  ⟨IsSimilar.refl, IsSimilar.symm, IsSimilar.trans⟩

/-- The setoid of matrices up to similarity. -/
def isSimilarSetoid : Setoid (Matrix n n R) :=
  ⟨IsSimilar, isSimilar_equivalence⟩

-- ============================================================================
-- Part II: Conjugation by a unit as an R-algebra automorphism
-- ============================================================================

/-- **Conjugation by a unit is an `R`-algebra automorphism** of the matrix ring:
`A ↦ U A U⁻¹`.  Its underlying function is exactly the parent's `conj U`, but
packaging it as an `AlgEquiv` exposes that it preserves the entire algebra
structure (products, sums, and scalars), which is what lets it commute with
polynomial evaluation. -/
def conjAlgEquiv (U : (Matrix n n R)ˣ) : Matrix n n R ≃ₐ[R] Matrix n n R where
  toFun := fun A => U.val * A * U⁻¹.val
  invFun := fun A => U⁻¹.val * A * U.val
  left_inv := fun A => by
    show U⁻¹.val * (U.val * A * U⁻¹.val) * U.val = A
    calc U⁻¹.val * (U.val * A * U⁻¹.val) * U.val
        = (U⁻¹.val * U.val) * A * (U⁻¹.val * U.val) := by simp only [mul_assoc]
      _ = 1 * A * 1 := by rw [Units.inv_mul]
      _ = A := by simp
  right_inv := fun A => by
    show U.val * (U⁻¹.val * A * U.val) * U⁻¹.val = A
    calc U.val * (U⁻¹.val * A * U.val) * U⁻¹.val
        = (U.val * U⁻¹.val) * A * (U.val * U⁻¹.val) := by simp only [mul_assoc]
      _ = 1 * A * 1 := by rw [Units.mul_inv]
      _ = A := by simp
  map_mul' := fun A B => by
    show U.val * (A * B) * U⁻¹.val = (U.val * A * U⁻¹.val) * (U.val * B * U⁻¹.val)
    have h : U⁻¹.val * U.val = (1 : Matrix n n R) := U.inv_mul
    symm
    calc (U.val * A * U⁻¹.val) * (U.val * B * U⁻¹.val)
        = U.val * A * (U⁻¹.val * U.val) * B * U⁻¹.val := by simp only [mul_assoc]
      _ = U.val * A * 1 * B * U⁻¹.val := by rw [h]
      _ = U.val * (A * B) * U⁻¹.val := by simp only [mul_one, mul_assoc]
  map_add' := fun A B => by
    show U.val * (A + B) * U⁻¹.val = U.val * A * U⁻¹.val + U.val * B * U⁻¹.val
    rw [mul_add, add_mul]
  commutes' := fun c => by
    show U.val * (algebraMap R (Matrix n n R) c) * U⁻¹.val = algebraMap R (Matrix n n R) c
    rw [← Algebra.commutes c U.val, mul_assoc, Units.mul_inv, mul_one]

/-- The algebra automorphism `conjAlgEquiv U` agrees with the parent's `conj U`. -/
@[simp]
theorem conjAlgEquiv_apply (U : (Matrix n n R)ˣ) (A : Matrix n n R) :
    conjAlgEquiv U A = conj U A := rfl

-- ============================================================================
-- Part III: Similarity is preserved by polynomial evaluation
-- ============================================================================

/-- **Polynomial evaluation preserves similarity.**  If `M` and `N` are similar,
then for every polynomial `p : R[X]` the evaluations `p(M)` and `p(N)` are similar
(via the *same* unit).  In particular every power, and every polynomial
combination, of a matrix is a similarity invariant up to conjugation. -/
theorem IsSimilar.aeval {M N : Matrix n n R} (p : R[X]) (h : IsSimilar M N) :
    IsSimilar (Polynomial.aeval M p) (Polynomial.aeval N p) := by
  obtain ⟨U, rfl⟩ := h
  refine ⟨U, ?_⟩
  show Polynomial.aeval (conjAlgEquiv U M) p = conjAlgEquiv U (Polynomial.aeval M p)
  exact Polynomial.aeval_algHom_apply (conjAlgEquiv U).toAlgHom M p

/-- **Corollary: polynomial evaluations of similar matrices share the parent's
invariants.**  Combining `IsSimilar.aeval` with the parent's
`IsSimilar.charpoly_eq`, similar matrices have polynomial evaluations with equal
characteristic polynomial (hence equal determinant and trace as well). -/
theorem IsSimilar.charpoly_aeval {M N : Matrix n n R} (p : R[X]) (h : IsSimilar M N) :
    (Polynomial.aeval N p).charpoly = (Polynomial.aeval M p).charpoly :=
  IsSimilar.charpoly_eq (IsSimilar.aeval p h)

/-- **Corollary: powers preserve similarity.**  Specialising `IsSimilar.aeval` to
`p = X ^ k` (using `aeval_X_pow`), similar matrices have similar powers. -/
theorem IsSimilar.pow {M N : Matrix n n R} (k : ℕ) (h : IsSimilar M N) :
    IsSimilar (M ^ k) (N ^ k) := by
  have := IsSimilar.aeval (X ^ k) h
  simpa only [map_pow, Polynomial.aeval_X] using this

-- ============================================================================
-- Part IV: Summary
-- ============================================================================

/-
## Summary

| Result | Statement |
|--------|-----------|
| `IsSimilar.symm` | `M ~ N → N ~ M` (conjugate back by `U⁻¹`) |
| `IsSimilar.trans` | `M ~ N → N ~ P → M ~ P` (conjugate by `V * U`) |
| `isSimilar_equivalence` | `Equivalence IsSimilar` |
| `isSimilarSetoid` | the setoid of matrices up to similarity |
| `conjAlgEquiv` | `A ↦ U A U⁻¹` as an `R`-algebra automorphism |
| `IsSimilar.aeval` | `M ~ N → p(M) ~ p(N)` for all `p : R[X]` |
| `IsSimilar.charpoly_aeval` | similar matrices give `p`-evaluations with equal charpoly |
| `IsSimilar.pow` | `M ~ N → M^k ~ N^k` |

Together with the parent's `IsSimilar.refl`, symmetry and transitivity make
similarity a genuine equivalence relation, so "similarity class" is well defined.
The algebra-automorphism packaging `conjAlgEquiv` is the structural reason the
relation is preserved by *every* polynomial expression in the matrix — a strictly
stronger statement than invariance of any fixed quantity such as det or trace.
-/

end CramersRuleOQ05OQ01

#check @CramersRuleOQ05OQ01.IsSimilar.symm
#check @CramersRuleOQ05OQ01.IsSimilar.trans
#check @CramersRuleOQ05OQ01.isSimilar_equivalence
#check @CramersRuleOQ05OQ01.conjAlgEquiv
#check @CramersRuleOQ05OQ01.IsSimilar.aeval
#check @CramersRuleOQ05OQ01.IsSimilar.pow
