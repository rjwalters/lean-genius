import Mathlib.GroupTheory.Nilpotent
import Mathlib.Tactic
import Proofs.ThreeSubgroupsLemmaOQ01

/-
# The bilinear lower-central-series bound `⁅γᵢ, γⱼ⁆ ≤ γ₍ᵢ₊ⱼ₎`

## What this proves

For a group `G` with lower central series `γₙ`, the iterated commutators interleave
multiplicatively:

  `⁅γᵢ, γⱼ⁆ ≤ γ₍ᵢ₊ⱼ₎`.

This is the classical *bilinearity* (or *grading*) property of the lower central
series — the statement that makes `⨁ γₖ / γₖ₊₁` a graded Lie ring and that underlies
the structure theory of nilpotent groups (e.g. `γₙ` being generated by left-normed
commutators of weight `n`).

### Index convention

Mathlib's `lowerCentralSeries G n` is **0-indexed**:

  `lowerCentralSeries G 0 = ⊤ = G`,   `lowerCentralSeries G (n+1) = ⁅lowerCentralSeries G n, ⊤⁆`.

So Mathlib's `lowerCentralSeries G n` is the *standard* `γ₍ₙ₊₁₎`.  Translating the textbook
1-indexed bound `⁅γᵢ, γⱼ⁆ ≤ γ₍ᵢ₊ⱼ₎` (with `γ₁ = G`) via `i ↦ a+1`, `j ↦ b+1` gives the
clean 0-indexed form proved here:

  `⁅lowerCentralSeries G a, lowerCentralSeries G b⁆ ≤ lowerCentralSeries G (a + b + 1)`.

Sanity checks at the bottom corners: `a = b = 0` reads `⁅G, G⁆ ≤ ⁅G, ⊤⁆ = γ₁` (equality);
`a = 0` reads `⁅G, γᵦ⁆ ≤ γ₍ᵦ₊₁₎`, the defining recursion.

## What Mathlib has — and what this adds

Mathlib's `Mathlib/GroupTheory/Nilpotent.lean` develops the lower central series
(`lowerCentralSeries_succ`, `lowerCentralSeries_antitone`, the `Normal` instance,
products/pis, the `derivedSeries` comparison) but records **no** bilinear bound
`⁅γᵢ, γⱼ⁆ ≤ γ₍ᵢ₊ⱼ₎`.  This file supplies it.

The engine is the **three subgroups lemma** in its normal-subgroup `≤ N` form, proved in
the parent entry (`ThreeSubgroupsLemmaOQ01.commutator_le_of_rotate`):

  `N` normal, `⁅⁅H,K⁆,L⁆ ≤ N`, `⁅⁅K,L⁆,H⁆ ≤ N`  ⟹  `⁅⁅L,H⁆,K⁆ ≤ N`.

The proof is an induction on `b` (generalizing `a`, so the inductive hypothesis is available
at the shifted index `a+1`).  Base case `b = 0` is the defining recursion
`⁅γₐ, ⊤⁆ = γ₍ₐ₊₁₎`.  The inductive step writes `γ₍ᵦ₊₁₎ = ⁅γᵦ, ⊤⁆` and applies the three
subgroups lemma with `N = γ₍ₐ₊ᵦ₊₂₎` (normal by Mathlib's instance):

  * conclusion `⁅⁅γᵦ, ⊤⁆, γₐ⁆ = ⁅γₐ, γ₍ᵦ₊₁₎⁆` is the goal;
  * hypothesis `⁅⁅⊤, γₐ⁆, γᵦ⁆ = ⁅γ₍ₐ₊₁₎, γᵦ⁆ ≤ N` is the IH at index `a+1`;
  * hypothesis `⁅⁅γₐ, γᵦ⁆, ⊤⁆ ≤ ⁅γ₍ₐ₊ᵦ₊₁₎, ⊤⁆ = γ₍ₐ₊ᵦ₊₂₎ = N` is the IH at index `a`,
    pushed one step by `commutator_mono`.

Verified: 0 sorries, 0 `axiom` declarations, no `native_decide`.
-/

namespace ThreeSubgroupsLemmaOQ01OQ01

open Subgroup

variable {G : Type*} [Group G]

/-! ## The bilinear lower-central-series bound -/

/-- **Bilinear bound for the lower central series.**

`⁅γₐ, γᵦ⁆ ≤ γ₍ₐ₊ᵦ₊₁₎` in Mathlib's 0-indexed convention (the textbook 1-indexed
`⁅γᵢ, γⱼ⁆ ≤ γ₍ᵢ₊ⱼ₎`).

The proof is induction on `b`, generalized over `a` so the inductive step can invoke the
hypothesis at the shifted index `a + 1`. -/
theorem lowerCentralSeries_commutator_le (a b : ℕ) :
    ⁅lowerCentralSeries G a, lowerCentralSeries G b⁆
      ≤ lowerCentralSeries G (a + b + 1) := by
  induction b generalizing a with
  | zero =>
    -- `⁅γₐ, γ₀⁆ = ⁅γₐ, ⊤⁆ = γ₍ₐ₊₁₎` (the defining recursion), and `a + 0 + 1 = a + 1`.
    rw [lowerCentralSeries_zero, Nat.add_zero]
    exact le_of_eq rfl
  | succ b ih =>
    -- Present `γ₍ᵦ₊₁₎` as `⁅γᵦ, ⊤⁆` (definitional) and flip to the `⁅⁅L, H⁆, K⁆` shape.
    show ⁅lowerCentralSeries G a, ⁅lowerCentralSeries G b, ⊤⁆⁆
          ≤ lowerCentralSeries G (a + (b + 1) + 1)
    rw [commutator_comm (lowerCentralSeries G a) ⁅lowerCentralSeries G b, ⊤⁆]
    -- Three subgroups lemma with H = ⊤, K = γₐ, L = γᵦ, N = γ₍ₐ₊(ᵦ₊₁)₊₁₎ (normal instance).
    refine ThreeSubgroupsLemmaOQ01.commutator_le_of_rotate
      (H := (⊤ : Subgroup G)) (K := lowerCentralSeries G a)
      (L := lowerCentralSeries G b) ?_ ?_
    · -- `⁅⁅⊤, γₐ⁆, γᵦ⁆ = ⁅γ₍ₐ₊₁₎, γᵦ⁆ ≤ γ₍ₐ₊ᵦ₊₂₎`, the IH at index `a + 1`.
      rw [commutator_comm (⊤ : Subgroup G) (lowerCentralSeries G a)]
      have h := ih (a + 1)
      rw [show a + 1 + b + 1 = a + (b + 1) + 1 from by omega] at h
      exact h
    · -- `⁅⁅γₐ, γᵦ⁆, ⊤⁆ ≤ ⁅γ₍ₐ₊ᵦ₊₁₎, ⊤⁆ = γ₍ₐ₊ᵦ₊₂₎`, the IH at index `a` pushed one step.
      calc ⁅⁅lowerCentralSeries G a, lowerCentralSeries G b⁆, (⊤ : Subgroup G)⁆
          ≤ ⁅lowerCentralSeries G (a + b + 1), (⊤ : Subgroup G)⁆ :=
            commutator_mono (ih a) le_rfl
        _ = lowerCentralSeries G (a + (b + 1) + 1) := rfl

/-! ## Corollaries -/

/-- Textbook 1-indexed restatement: with `Γ i := γ₍ᵢ₋₁₎` so that `Γ 1 = G`, the bound reads
`⁅Γ i, Γ j⁆ ≤ Γ (i + j)` for `i, j ≥ 1`.  Stated here in the equivalent shifted-index form
`⁅γₐ, γᵦ⁆ ≤ γ₍ₐ₊ᵦ₊₁₎`, the symmetric companion obtained by swapping the two factors. -/
theorem lowerCentralSeries_commutator_le' (a b : ℕ) :
    ⁅lowerCentralSeries G b, lowerCentralSeries G a⁆
      ≤ lowerCentralSeries G (a + b + 1) := by
  rw [commutator_comm]
  exact lowerCentralSeries_commutator_le a b

/-- A commutator of a weight-`a` element of the lower central series with the whole group
lands one level deeper: `⁅γₐ, G⁆ ≤ γ₍ₐ₊₁₎`.  (This is the `b = 0` corner, recorded as the
familiar consequence; here `⊤ = γ₀`.) -/
theorem lowerCentralSeries_commutator_top_le (a : ℕ) :
    ⁅lowerCentralSeries G a, (⊤ : Subgroup G)⁆ ≤ lowerCentralSeries G (a + 1) :=
  le_of_eq rfl

/-- Weakened-target form: since the lower central series is *antitone* (decreasing), any
`c ≤ a + b + 1` gives the looser containment `⁅γₐ, γᵦ⁆ ≤ γ_c`, combining the bilinear bound
with `lowerCentralSeries_antitone`. -/
theorem lowerCentralSeries_commutator_le_of_le {a b c : ℕ} (h : c ≤ a + b + 1) :
    ⁅lowerCentralSeries G a, lowerCentralSeries G b⁆ ≤ lowerCentralSeries G c :=
  (lowerCentralSeries_commutator_le a b).trans (lowerCentralSeries_antitone h)

end ThreeSubgroupsLemmaOQ01OQ01
