import Mathlib

/-
# Pascal's hexagon theorem for the standard conic (OQ-01 of `brianchon-theorem-oq-01`)

`BrianchonTheorem.lean` proves Brianchon's theorem in the projective `ℝ³` model
modulo the single axiom `conic_implies_pascal`: six points on a symmetric conic
make the three intersections of opposite sides of the inscribed hexagon
collinear (Pascal's hexagon theorem). The companion `BrianchonTheoremAristotle.lean`
restates that axiom as a `sorry`-target. Eliminating it is the open frontier
recorded in the parent's knowledge: numerical evidence shows the conclusion is a
genuine **polynomial identity** — `det(P,Q,R)` lies in the ideal generated by the
six conic equations — and the parent suggested a direct `linear_combination` /
`polyrith` discharge (Aristotle territory; the service is currently unavailable).

This file establishes the result **for the standard conic** by the classical
device that makes the identity tractable: parametrise the conic by the
**rational normal curve** `t ↦ (1, t, t²)`. On this curve the cross-product
algebra factors, and Pascal collinearity reduces to a true polynomial identity in
the six parameters `a,…,f`, closed by `ring`. The result is **axiom-free and
`sorry`-free**.

## What is and is not proved

* **Proved (this file):** Pascal's hexagon theorem for the conic `y² = x z`
  (symmetric matrix `stdConic`), for the six points `(1, tᵢ, tᵢ²)`. This is the
  substantive computational core of the classical proof.
* **Still open (parent axiom):** the *general* `conic_implies_pascal` for an
  arbitrary symmetric conic. The gap is the projective-equivalence reduction
  (every nondegenerate symmetric conic is `PGL₃`-equivalent to `stdConic`, and
  the model's `collinear`/`pointOnConic` are equivariant). That reduction —
  together with the degenerate (rank `< 3`) cases, which the numerics show also
  satisfy the identity — is the scoped next step. The direct ideal-membership
  discharge remains the preferred route once Aristotle is reachable.

The model below is identical (up to defeq) to the one in
`BrianchonTheoremAristotle.lean`: projective points are vectors in `ℝ³`, the join
of points / meet of lines is the cross product, three points are collinear iff
their `3×3` row-determinant vanishes, and a conic is a symmetric `3×3` matrix `C`
with `p` on it iff `pᵀ C p = 0`.
-/

set_option linter.unusedVariables false

open Matrix

namespace BrianchonOQ01OQ01

/-- A projective point: a vector in `ℝ³`. -/
abbrev ProjPoint := Fin 3 → ℝ

/-- The line through two points is their cross product. -/
noncomputable def lineThrough (p q : ProjPoint) : ProjPoint := crossProduct p q

/-- The meet of two lines is their cross product. -/
noncomputable def lineIntersection (l m : ProjPoint) : ProjPoint := crossProduct l m

/-- The `3×3` matrix whose rows are the three given vectors (identical to the
companion's `threeVectorMatrix`). -/
def threeVectorMatrix (u v w : Fin 3 → ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  Matrix.of fun i j =>
    match i with
    | 0 => u j
    | 1 => v j
    | 2 => w j

/-- Three points are collinear iff their coordinate determinant vanishes. -/
def collinear (p q r : ProjPoint) : Prop := (threeVectorMatrix p q r).det = 0

/-- A conic is a symmetric `3×3` matrix `C`. -/
abbrev Conic := Matrix (Fin 3) (Fin 3) ℝ

/-- The conic's quadratic form `pᵀ C p`. -/
noncomputable def conicQuadraticForm (C : Conic) (p : ProjPoint) : ℝ :=
  ∑ i, ∑ j, C i j * p i * p j

/-- A point lies on a conic iff its quadratic form vanishes. -/
def pointOnConic (p : ProjPoint) (C : Conic) : Prop := conicQuadraticForm C p = 0

/-- `C` is symmetric (`Cᵢⱼ = Cⱼᵢ`). -/
def Conic.symmetric (C : Conic) : Prop := ∀ i j, C i j = C j i

/-- Explicit `3×3` determinant of three row vectors. Provided so the main
identity is a pure `ring` goal, sidestepping reduction of the `match` in
`threeVectorMatrix` under `Matrix.det_fin_three`. -/
theorem threeVectorMatrix_det (p q r : ProjPoint) :
    (threeVectorMatrix p q r).det
      = p 0 * q 1 * r 2 - p 0 * q 2 * r 1 - p 1 * q 0 * r 2
        + p 1 * q 2 * r 0 + p 2 * q 0 * r 1 - p 2 * q 1 * r 0 := by
  have e : threeVectorMatrix p q r = !![p 0, p 1, p 2; q 0, q 1, q 2; r 0, r 1, r 2] := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  rw [e, Matrix.det_fin_three]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_fin_const, Matrix.cons_val_fin_one]
  ring

-- ============================================================
-- The standard conic and the rational normal curve
-- ============================================================

/-- The standard conic `y² = x z`, as the symmetric matrix of the quadratic form
`y² - x z` (so `pᵀ C p = p₁² - p₀ p₂`). -/
def stdConic : Conic := !![(0 : ℝ), 0, -1/2; 0, 1, 0; -1/2, 0, 0]

/-- `stdConic` is symmetric. -/
theorem stdConic_symmetric : stdConic.symmetric := by
  intro i j
  fin_cases i <;> fin_cases j <;> rfl

/-- The rational normal curve point `(1, t, t²)`. -/
def rncPoint (t : ℝ) : ProjPoint := ![1, t, t ^ 2]

/-- Every rational-normal-curve point lies on the standard conic. -/
theorem rncPoint_on_stdConic (t : ℝ) : pointOnConic (rncPoint t) stdConic := by
  simp only [pointOnConic, conicQuadraticForm, stdConic, rncPoint, Fin.sum_univ_three,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.tail_cons, Matrix.head_fin_const, Matrix.cons_val_fin_one]
  ring

-- ============================================================
-- Pascal's hexagon theorem for the standard conic
-- ============================================================

set_option maxHeartbeats 1000000 in
/-- **Pascal's hexagon theorem for the standard conic** (`sorry`-free, axiom-free).

For six points `(1, tᵢ, tᵢ²)` on the conic `y² = x z`, labelled
`A,B,C,D,E,F = a,b,c,d,e,f`, the three intersections of opposite sides of the
hexagon `A B C D E F`,

* `AB ∩ DE`,
* `BC ∩ EF`,
* `CD ∩ FA`,

are collinear (they lie on the Pascal line). This is the standard-conic instance
of the parent's `conic_implies_pascal` axiom. -/
theorem pascal_std_conic (a b c d e f : ℝ) :
    collinear
      (lineIntersection (lineThrough (rncPoint a) (rncPoint b))
                        (lineThrough (rncPoint d) (rncPoint e)))
      (lineIntersection (lineThrough (rncPoint b) (rncPoint c))
                        (lineThrough (rncPoint e) (rncPoint f)))
      (lineIntersection (lineThrough (rncPoint c) (rncPoint d))
                        (lineThrough (rncPoint f) (rncPoint a))) := by
  simp only [collinear, threeVectorMatrix_det, lineIntersection, lineThrough, rncPoint,
    cross_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_fin_const, Matrix.cons_val_fin_one,
    Fin.isValue]
  ring

/-- Restatement emphasising that the three opposite-side intersections genuinely
arise from six points on a symmetric conic: `stdConic` is symmetric and each
`rncPoint tᵢ` lies on it (`stdConic_symmetric`, `rncPoint_on_stdConic`), and the
resulting Pascal points are collinear. -/
theorem pascal_std_conic_full (a b c d e f : ℝ)
    (hsymm : stdConic.symmetric := stdConic_symmetric)
    (ha : pointOnConic (rncPoint a) stdConic := rncPoint_on_stdConic a)
    (hb : pointOnConic (rncPoint b) stdConic := rncPoint_on_stdConic b)
    (hc : pointOnConic (rncPoint c) stdConic := rncPoint_on_stdConic c)
    (hd : pointOnConic (rncPoint d) stdConic := rncPoint_on_stdConic d)
    (he : pointOnConic (rncPoint e) stdConic := rncPoint_on_stdConic e)
    (hf : pointOnConic (rncPoint f) stdConic := rncPoint_on_stdConic f) :
    collinear
      (lineIntersection (lineThrough (rncPoint a) (rncPoint b))
                        (lineThrough (rncPoint d) (rncPoint e)))
      (lineIntersection (lineThrough (rncPoint b) (rncPoint c))
                        (lineThrough (rncPoint e) (rncPoint f)))
      (lineIntersection (lineThrough (rncPoint c) (rncPoint d))
                        (lineThrough (rncPoint f) (rncPoint a))) :=
  pascal_std_conic a b c d e f

end BrianchonOQ01OQ01
