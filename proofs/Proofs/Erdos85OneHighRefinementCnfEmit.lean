import Proofs.Erdos85OneHighRefinementPinnedCnf

/-! # Proof-grade refinement-pinned CNF emitter

`lake exe refinementcnf emit <profile> <refinement-file>` emits the exact
DIMACS generated by `oneHighFamilyRefinementClauses`.  The input is one JSON
style eight-row canonical-slot refinement.  `check` regenerates the formula
and compares it clausewise with a supplied DIMACS file.
-/

namespace Erdos85.RefinementCnfEmit

def parseNats (s : String) : List Nat := Id.run do
  let mut out : List Nat := []
  let mut cur : Option Nat := none
  for c in s.data do
    if c.isDigit then
      cur := some ((cur.getD 0) * 10 + (c.toNat - '0'.toNat))
    else
      if let some n := cur then
        out := n :: out
      cur := none
  if let some n := cur then
    out := n :: out
  return out.reverse

def parsePairs : Nat → List Nat → Option (List OneHighLabelPair × List Nat)
  | 0, rest => some ([], rest)
  | n + 1, a :: b :: rest =>
      if ha : a < 8 then
        if hb : b < 8 then
          if a ≤ b then
            match parsePairs n rest with
            | some (pairs, tail) =>
                some (((⟨a, ha⟩, ⟨b, hb⟩) :: pairs), tail)
            | none => none
          else none
        else none
      else none
  | _ + 1, _ => none

def parseRows : List Nat → List Nat →
    Option (List (List OneHighLabelPair) × List Nat)
  | [], rest => some ([], rest)
  | count :: counts, input =>
      match parsePairs count input with
      | none => none
      | some (row, rest) =>
          match parseRows counts rest with
          | none => none
          | some (rows, tail) => some (row :: rows, tail)

def rowLengths (profile : Nat) : List Nat :=
  (List.range 8).map fun source =>
    if source % 2 = 0 ∧ source / 2 < profile then 1 else 2

def slotRowValid : List OneHighLabelPair → Bool
  | [p, q] => decide (p.1 ≤ q.1)
  | [_] => true
  | _ => false

def parseRefinement (profile : Nat) (raw : String) :
    Option (List (List OneHighLabelPair)) :=
  match parseRows (rowLengths profile) (parseNats raw) with
  | some (rows, []) => if rows.all slotRowValid then some rows else none
  | _ => none

def clauseLine (clause : DimacsClause) : String :=
  String.intercalate " " (clause.map toString) ++ " 0"

def emitDimacs (st : OneHighFamilyGenState) : IO Unit := do
  IO.print s!"p cnf {st.top} {st.clauses.size}\n"
  let mut chunk := ""
  for i in [0:st.clauses.size] do
    chunk := chunk ++ clauseLine st.clauses[i]! ++ "\n"
    if i % 4096 = 4095 then
      IO.print chunk
      chunk := ""
  if !chunk.isEmpty then
    IO.print chunk

def parseDimacs (contents : String) : Array (List Int) := Id.run do
  let mut clauses : Array (List Int) := #[]
  for line in contents.splitOn "\n" do
    let t := line.trim
    if t.isEmpty || t.startsWith "c" || t.startsWith "p" then
      continue
    let lits := (t.splitOn " ").filterMap (fun w =>
      if w.isEmpty then none else w.toInt?)
    clauses := clauses.push (lits.takeWhile (· ≠ 0))
  return clauses

def load (profileStr refinementPath : String) :
    IO (Option (Nat × List (List OneHighLabelPair))) := do
  let some profile := profileStr.toNat? | do
    IO.eprintln "bad profile"
    return none
  if profile > 4 then
    IO.eprintln "bad profile (expected 0..4)"
    return none
  let raw ← IO.FS.readFile refinementPath
  let some refinement := parseRefinement profile raw | do
    IO.eprintln "bad refinement (expected exact profile-shaped canonical pairs)"
    return none
  return some (profile, refinement)

def run (args : List String) : IO UInt32 := do
  match args with
  | ["emit", profileStr, refinementPath] =>
      let some (profile, refinement) ← load profileStr refinementPath |
        return 2
      emitDimacs (oneHighFamilyRefinementClauses profile refinement)
      return 0
  | ["check", profileStr, refinementPath, cnfPath] =>
      let some (profile, refinement) ← load profileStr refinementPath |
        return 2
      let st := oneHighFamilyRefinementClauses profile refinement
      let supplied := parseDimacs (← IO.FS.readFile cnfPath)
      if st.clauses.size ≠ supplied.size then
        IO.eprintln
          s!"MISMATCH: clause count {st.clauses.size} vs {supplied.size}"
        return 1
      for i in [0:st.clauses.size] do
        if st.clauses[i]! ≠ supplied[i]! then
          IO.eprintln s!"MISMATCH at clause {i + 1}:"
          IO.eprintln s!"  lean:     {clauseLine st.clauses[i]!}"
          IO.eprintln s!"  supplied: {clauseLine supplied[i]!}"
          return 1
      IO.println s!"MATCH ({st.clauses.size} clauses, top {st.top})"
      return 0
  | _ => do
      IO.eprintln "usage: refinementcnf emit <profile> <refinement-file>"
      IO.eprintln "       refinementcnf check <profile> <refinement-file> <cnf-file>"
      return 2

end Erdos85.RefinementCnfEmit

def main (args : List String) : IO UInt32 :=
  Erdos85.RefinementCnfEmit.run args
