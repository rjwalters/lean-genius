theorem oneHighAllEvenCapacityKnownCheckedTables_nodup
    (profile : Fin 5) :
    (oneHighAllEvenCapacityKnownCheckedTables profile).Nodup := by
  apply nodup_of_map_nodup oneHighMissTableFullCode
  fin_cases profile <;> native_decide

