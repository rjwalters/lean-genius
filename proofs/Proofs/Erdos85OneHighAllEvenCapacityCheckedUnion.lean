private theorem nodup_of_map_nodup
    {α β : Type*} (f : α → β) (xs : List α)
    (h : (xs.map f).Nodup) : xs.Nodup := by
  induction xs with
  | nil => simp
  | cons head tail ih =>
      simp only [List.map_cons, List.nodup_cons] at h ⊢
      exact ⟨fun hmem => h.1 (List.mem_map.mpr ⟨head, hmem, rfl⟩), ih h.2⟩

