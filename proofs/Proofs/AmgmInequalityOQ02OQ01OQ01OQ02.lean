import Mathlib.RingTheory.MvPolynomial.Symmetric.NewtonIdentities
import Mathlib.Tactic

/-!
# AM-GM OQ-02 → OQ-01 → OQ-01 → OQ-02: dual Newton–Girard

Power sums and elementary symmetric polynomials generate the same ℚ-subalgebra.

The parent (`amgm-inequality-oq-02-oq-01-oq-01`) proved the *forward* Newton–Girard recurrence
`k·eₖ = (−1)^{k+1} Σ_{i+j=k, i<k} (−1)ⁱ eᵢ pⱼ` (Mathlib `mul_esymm_eq_sum`), expressing `k·eₖ`
through lower-degree elementary symmetric polynomials and power sums.  Its first open question
asks to **invert** the recurrence over a ℚ-algebra, expressing each `eₖ` as a polynomial in the
power sums `p₁, …, pₖ` — the *dual* Newton–Girard formulae.

Over a ℚ-algebra the integer `k` is invertible, so the forward recurrence can be solved for `eₖ`.
Running the resulting recursion to completion shows that every elementary symmetric polynomial
lies in the ℚ-subalgebra generated by the power sums.  The converse — every power sum lies in the
ℚ-subalgebra generated by the elementary symmetric polynomials — needs no division and follows
from Mathlib's `psum_eq_mul_esymm_sub_sum`.  Together they give the symmetric-function identity

> over a ℚ-algebra the power sums and the elementary symmetric polynomials generate the **same**
> ℚ-subalgebra of `MvPolynomial σ R`.

We also record the classical low-degree dual formula `2·e₂ = p₁² − p₂`, which holds over an
arbitrary commutative ring.

## Main results

* `psum_mem_adjoin_esymm` : `pₖ ∈ ℚ⟪e₀, e₁, …⟫` for every `k` (forward recurrence).
* `esymm_mem_adjoin_psum` : `eₖ ∈ ℚ⟪p₀, p₁, …⟫` for every `k` (inverted recurrence; dual N–G).
* `adjoin_psum_eq_adjoin_esymm` : the two ℚ-subalgebras coincide.
* `esymm_one_eq_psum`, `two_mul_esymm_two` : explicit low-degree formulae.
-/

namespace AmgmInequalityOQ02OQ01OQ01OQ02

open MvPolynomial Finset

variable (σ : Type*) [Fintype σ] (R : Type*) [CommRing R]

/-! ### Forward direction: power sums lie in the algebra generated by elementary symmetrics

This direction is division-free: `psum_eq_mul_esymm_sub_sum` expresses `pₖ` through the
elementary symmetric polynomials and *strictly lower* power sums, so a strong induction places
every power sum inside the ℚ-subalgebra generated by the elementary symmetric polynomials. -/

variable [Algebra ℚ R]

theorem psum_mem_adjoin_esymm (k : ℕ) :
    psum σ R k ∈ Algebra.adjoin ℚ (Set.range (esymm σ R)) := by
  induction k using Nat.strongRecOn with
  | ind k ih =>
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      rw [psum_zero]
      exact natCast_mem _ _
    · rw [psum_eq_mul_esymm_sub_sum σ R k hk]
      refine Subalgebra.sub_mem _ ?_ ?_
      · refine Subalgebra.mul_mem _
          (Subalgebra.mul_mem _ (pow_mem (neg_mem (one_mem _)) _) (natCast_mem _ _)) ?_
        exact Algebra.subset_adjoin (Set.mem_range_self k)
      · refine Subalgebra.sum_mem _ fun a ha => ?_
        rw [mem_filter, mem_antidiagonal, Set.mem_Ioo] at ha
        obtain ⟨hsum, h0, _⟩ := ha
        have ha2 : a.2 < k := by omega
        refine Subalgebra.mul_mem _
          (Subalgebra.mul_mem _ (pow_mem (neg_mem (one_mem _)) _) ?_) ?_
        · exact Algebra.subset_adjoin (Set.mem_range_self a.1)
        · exact ih a.2 ha2

/-! ### Inverted direction: elementary symmetrics lie in the algebra generated by power sums

Over a ℚ-algebra `(k : ℚ)` is a unit, so `mul_esymm_eq_sum` can be divided by `k`, expressing
`eₖ` through *strictly lower* elementary symmetric polynomials and power sums.  A strong induction
then places every elementary symmetric polynomial inside the ℚ-subalgebra generated by the power
sums — the dual Newton–Girard statement. -/

theorem esymm_mem_adjoin_psum (k : ℕ) :
    esymm σ R k ∈ Algebra.adjoin ℚ (Set.range (psum σ R)) := by
  induction k using Nat.strongRecOn with
  | ind k ih =>
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      rw [esymm_zero]
      exact one_mem _
    · have hk0 : (k : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hk.ne'
      have hcancel : algebraMap ℚ (MvPolynomial σ R) ((k : ℚ)⁻¹) * (k : MvPolynomial σ R) = 1 := by
        rw [← map_natCast (algebraMap ℚ (MvPolynomial σ R)) k, ← map_mul,
          inv_mul_cancel₀ hk0, map_one]
      have hrec : esymm σ R k = algebraMap ℚ (MvPolynomial σ R) ((k : ℚ)⁻¹) *
          ((-1) ^ (k + 1) * ∑ a ∈ antidiagonal k with a.1 < k,
            (-1) ^ a.1 * esymm σ R a.1 * psum σ R a.2) := by
        rw [← mul_esymm_eq_sum σ R k, ← mul_assoc, hcancel, one_mul]
      rw [hrec]
      refine Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) ?_
      refine Subalgebra.mul_mem _ (pow_mem (neg_mem (one_mem _)) _) ?_
      refine Subalgebra.sum_mem _ fun a ha => ?_
      rw [mem_filter, mem_antidiagonal] at ha
      obtain ⟨_, hlt⟩ := ha
      refine Subalgebra.mul_mem _
        (Subalgebra.mul_mem _ (pow_mem (neg_mem (one_mem _)) _) (ih a.1 hlt)) ?_
      exact Algebra.subset_adjoin (Set.mem_range_self a.2)

/-- **Newton's theorem on symmetric functions, multiplicative form.** Over a ℚ-algebra the power
sums and the elementary symmetric polynomials generate the *same* ℚ-subalgebra of
`MvPolynomial σ R`. The forward inclusion is the (division-free) Newton recurrence; the reverse is
its inversion over ℚ. -/
theorem adjoin_psum_eq_adjoin_esymm :
    Algebra.adjoin ℚ (Set.range (psum σ R)) = Algebra.adjoin ℚ (Set.range (esymm σ R)) := by
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff]
    rintro x ⟨k, rfl⟩
    exact psum_mem_adjoin_esymm σ R k
  · rw [Algebra.adjoin_le_iff]
    rintro x ⟨k, rfl⟩
    exact esymm_mem_adjoin_psum σ R k

end AmgmInequalityOQ02OQ01OQ01OQ02

/-! ### Explicit low-degree dual formulae (over an arbitrary commutative ring) -/

namespace AmgmInequalityOQ02OQ01OQ01OQ02

open MvPolynomial Finset

variable (σ : Type*) [Fintype σ] (R : Type*) [CommRing R]

/-- The first dual formula `e₁ = p₁`: the first elementary symmetric polynomial and the first
power sum are both `∑ᵢ Xᵢ`. -/
theorem esymm_one_eq_psum : esymm σ R 1 = psum σ R 1 := by
  rw [esymm_one, psum_one]

/-- The second dual formula `2·e₂ = p₁² − p₂`, valid over any commutative ring (cleared of
denominators).  Over a ℚ-algebra it gives `e₂ = (p₁² − p₂)/2`. -/
theorem two_mul_esymm_two :
    2 * esymm σ R 2 = psum σ R 1 ^ 2 - psum σ R 2 := by
  have hrec := mul_esymm_eq_sum σ R 2
  have hfilter : {a ∈ antidiagonal 2 | a.1 < 2} = {(0, 2), (1, 1)} := by decide
  rw [hfilter, Finset.sum_insert (by decide), Finset.sum_singleton,
    esymm_zero, esymm_one_eq_psum] at hrec
  push_cast at hrec
  linear_combination hrec

end AmgmInequalityOQ02OQ01OQ01OQ02
