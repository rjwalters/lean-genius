import Proofs.Erdos85EulerianCutParity

/-!
# Relay graph from witness-indexed local pairings

At every witness `w`, the Baer construction pairs the eligible endpoints in
that witness star.  The global relay graph is the union of all these local
matching edges, retaining the witness label.  Unique common witnesses ensure
that the same edge is not produced twice.  This file formalizes exactly that
construction and its degree count.
-/

open SimpleGraph

namespace Erdos85

noncomputable section

/-- Global graph generated by a family of local fixed-point-free
involutions, one on each witness fiber. -/
def witnessPairingRelayGraph
    {W V : Type*} (eligible : W → V → Prop) (mate : W → V → V)
    (hclosed : ∀ w v, eligible w v → eligible w (mate w v))
    (hinvol : ∀ w v, eligible w v → mate w (mate w v) = v)
    (hfixed : ∀ w v, eligible w v → mate w v ≠ v) : SimpleGraph V where
  Adj u v := ∃ w, eligible w u ∧ mate w u = v
  symm := by
    constructor
    intro u v h
    obtain ⟨w, hu, rfl⟩ := h
    exact ⟨w, hclosed w u hu, hinvol w u hu⟩
  loopless := by
    constructor
    intro v h
    obtain ⟨w, hv, hmate⟩ := h
    exact hfixed w v hv hmate

instance witnessPairingRelayGraph_decidableAdj
    {W V : Type*} [Fintype W] [DecidableEq V]
    (eligible : W → V → Prop) [DecidableRel eligible]
    (mate : W → V → V)
    (hclosed : ∀ w v, eligible w v → eligible w (mate w v))
    (hinvol : ∀ w v, eligible w v → mate w (mate w v) = v)
    (hfixed : ∀ w v, eligible w v → mate w v ≠ v) :
    DecidableRel
      (witnessPairingRelayGraph eligible mate hclosed hinvol hfixed).Adj := by
  intro u v
  change Decidable (∃ w, eligible w u ∧ mate w u = v)
  infer_instance

/-- The neighbors of `v` are exactly the images of the witnesses whose
local fibers contain `v`. -/
theorem witnessPairingRelayGraph_neighborFinset
    {W V : Type*} [Fintype W] [Fintype V]
    [DecidableEq W] [DecidableEq V]
    (eligible : W → V → Prop) [DecidableRel eligible]
    (mate : W → V → V)
    (hclosed : ∀ w v, eligible w v → eligible w (mate w v))
    (hinvol : ∀ w v, eligible w v → mate w (mate w v) = v)
    (hfixed : ∀ w v, eligible w v → mate w v ≠ v) (v : V) :
    (witnessPairingRelayGraph eligible mate hclosed hinvol hfixed).neighborFinset v =
      (Finset.univ.filter fun w => eligible w v).image (fun w => mate w v) := by
  ext u
  simp [SimpleGraph.mem_neighborFinset, witnessPairingRelayGraph]

/-- If a paired edge has a unique witness label, the relay degree at `v` is
exactly the number of witness fibers containing `v`. -/
theorem witnessPairingRelayGraph_degree_eq_fiberCount
    {W V : Type*} [Fintype W] [Fintype V]
    [DecidableEq W] [DecidableEq V]
    (eligible : W → V → Prop) [DecidableRel eligible]
    (mate : W → V → V)
    (hclosed : ∀ w v, eligible w v → eligible w (mate w v))
    (hinvol : ∀ w v, eligible w v → mate w (mate w v) = v)
    (hfixed : ∀ w v, eligible w v → mate w v ≠ v)
    (hunique : ∀ v w w', eligible w v → eligible w' v →
      mate w v = mate w' v → w = w') (v : V) :
    (witnessPairingRelayGraph eligible mate hclosed hinvol hfixed).degree v =
      (Finset.univ.filter fun w => eligible w v).card := by
  let R := witnessPairingRelayGraph eligible mate hclosed hinvol hfixed
  calc
    R.degree v = (R.neighborFinset v).card :=
      (R.card_neighborFinset_eq_degree v).symm
    _ = ((Finset.univ.filter fun w => eligible w v).image
        (fun w => mate w v)).card := by
      rw [witnessPairingRelayGraph_neighborFinset]
    _ = (Finset.univ.filter fun w => eligible w v).card := by
      apply Finset.card_image_of_injOn
      intro w hw w' hw' heq
      exact hunique v w w' (Finset.mem_filter.mp hw).2
        (Finset.mem_filter.mp hw').2 heq

/-- Uniformly `q` witness stars through every vertex make the relay graph
`q`-regular. -/
theorem witnessPairingRelayGraph_degree_eq
    {W V : Type*} [Fintype W] [Fintype V]
    [DecidableEq W] [DecidableEq V]
    (eligible : W → V → Prop) [DecidableRel eligible]
    (mate : W → V → V)
    (hclosed : ∀ w v, eligible w v → eligible w (mate w v))
    (hinvol : ∀ w v, eligible w v → mate w (mate w v) = v)
    (hfixed : ∀ w v, eligible w v → mate w v ≠ v)
    (hunique : ∀ v w w', eligible w v → eligible w' v →
      mate w v = mate w' v → w = w')
    (q : ℕ) (hcount : ∀ v,
      (Finset.univ.filter fun w => eligible w v).card = q) (v : V) :
    (witnessPairingRelayGraph eligible mate hclosed hinvol hfixed).degree v = q := by
  rw [witnessPairingRelayGraph_degree_eq_fiberCount
    eligible mate hclosed hinvol hfixed hunique, hcount]

/-- For even `q`, the witness-pairing relay graph is Eulerian. -/
theorem witnessPairingRelayGraph_even_degree
    {W V : Type*} [Fintype W] [Fintype V]
    [DecidableEq W] [DecidableEq V]
    (eligible : W → V → Prop) [DecidableRel eligible]
    (mate : W → V → V)
    (hclosed : ∀ w v, eligible w v → eligible w (mate w v))
    (hinvol : ∀ w v, eligible w v → mate w (mate w v) = v)
    (hfixed : ∀ w v, eligible w v → mate w v ≠ v)
    (hunique : ∀ v w w', eligible w v → eligible w' v →
      mate w v = mate w' v → w = w')
    (q : ℕ) (hcount : ∀ v,
      (Finset.univ.filter fun w => eligible w v).card = q)
    (hq : Even q) (v : V) :
    Even ((witnessPairingRelayGraph eligible mate hclosed hinvol hfixed).degree v) := by
  rw [witnessPairingRelayGraph_degree_eq
    eligible mate hclosed hinvol hfixed hunique q hcount]
  exact hq

end

end Erdos85

#print axioms Erdos85.witnessPairingRelayGraph_neighborFinset
#print axioms Erdos85.witnessPairingRelayGraph_degree_eq_fiberCount
#print axioms Erdos85.witnessPairingRelayGraph_even_degree
