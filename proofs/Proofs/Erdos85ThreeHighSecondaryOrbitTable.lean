import Proofs.Erdos85ThreeHighSecondaryDomain

namespace Erdos85

def threeHighSecondaryCode (m : Fin 3) (a b : Fin 7) (e : Bool) : ThreeHighSecondaryTuple :=
  (m,![Fin.cases none some a,Fin.cases none some b],e)

def threeHighSecondaryRepresentative : Fin 21 → ThreeHighSecondaryTuple :=
  ![threeHighSecondaryCode 0 0 1 true,
    threeHighSecondaryCode 0 0 3 true,
    threeHighSecondaryCode 0 1 1 false,
    threeHighSecondaryCode 0 1 1 true,
    threeHighSecondaryCode 0 1 2 false,
    threeHighSecondaryCode 0 1 3 false,
    threeHighSecondaryCode 0 1 3 true,
    threeHighSecondaryCode 0 3 3 false,
    threeHighSecondaryCode 0 3 3 true,
    threeHighSecondaryCode 0 3 4 false,
    threeHighSecondaryCode 0 3 4 true,
    threeHighSecondaryCode 1 0 0 true,
    threeHighSecondaryCode 1 0 1 true,
    threeHighSecondaryCode 1 0 5 true,
    threeHighSecondaryCode 1 1 1 false,
    threeHighSecondaryCode 1 1 2 false,
    threeHighSecondaryCode 1 1 3 false,
    threeHighSecondaryCode 1 1 5 false,
    threeHighSecondaryCode 1 5 5 false,
    threeHighSecondaryCode 1 5 6 false,
    threeHighSecondaryCode 2 0 0 true]

