set_option maxRecDepth 100000 in
private theorem permutationCode_left (p : Fin 120) (i : Fin 5) :
    permutationCodeInverse p (permutationCodeForward p i) = i := by decide +revert
set_option maxRecDepth 100000 in
private theorem permutationCode_right (p : Fin 120) (i : Fin 5) :
    permutationCodeForward p (permutationCodeInverse p i) = i := by decide +revert

/-- The 120 permutations in lexicographic order, with checked inverse data. -/
def finFivePermutationCode (p : Fin 120) : Equiv.Perm (Fin 5) :=
  ⟨permutationCodeForward p,permutationCodeInverse p,permutationCode_left p,permutationCode_right p⟩

def finFivePermutationRank (π : Equiv.Perm (Fin 5)) : Nat :=
  ∑ i : Fin 5, ((Finset.univ : Finset (Fin 5)).filter
    (fun j => i < j ∧ π j < π i)).card * (4-i.val).factorial

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 10000000 in
theorem finFivePermutationRank_code (p : Fin 120) :
    finFivePermutationRank (finFivePermutationCode p) = p.val := by decide +revert

theorem finFivePermutationCode_injective : Function.Injective finFivePermutationCode := by
  intro p q h
  have hr := congrArg finFivePermutationRank h
  rw [finFivePermutationRank_code,finFivePermutationRank_code] at hr
  exact Fin.ext hr

/-- Equal finite cardinalities turn the checked rank retraction into exhaustive coverage. -/
theorem finFivePermutationCode_surjective : Function.Surjective finFivePermutationCode := by
  classical
  by_contra h
  have hc := Fintype.card_lt_of_injective_not_surjective
    finFivePermutationCode finFivePermutationCode_injective h
  norm_num [Fintype.card_perm] at hc

end Erdos85
