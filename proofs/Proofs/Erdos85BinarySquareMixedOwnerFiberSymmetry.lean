import Proofs.Erdos85BinarySquareMixedOwnerComponentSplit

/-! # Quantitative symmetries of mixed owner component fibers -/

open SimpleGraph

namespace Erdos85

noncomputable section

/-- Expanded membership criterion for one component fiber. -/
theorem mem_cyclicColoredTriplesInComponent_iff
    {V : Type*} [Fintype V] [DecidableEq V]
    (D A B C : SimpleGraph V) [DecidableRel D.Adj]
    [Fintype D.ConnectedComponent] [DecidableEq D.ConnectedComponent]
    [DecidableRel A.Adj] [DecidableRel B.Adj] [DecidableRel C.Adj]
    (d : D.ConnectedComponent) (p : V × V × V) :
    p ∈ cyclicColoredTriplesInComponent D A B C d ↔
      A.Adj p.1 p.2.2 ∧ B.Adj p.2.2 p.2.1 ∧ C.Adj p.2.1 p.1 ∧
      D.connectedComponentMk p.1 = d ∧
      D.connectedComponentMk p.2.2 = d ∧
      D.connectedComponentMk p.2.1 = d := by
  classical
  simp only [cyclicColoredTriplesInComponent, sameComponentCyclicColoredTriples,
    cyclicColoredTriples, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨⟨⟨hA, hB, hC⟩, hxy, hyz⟩, hx⟩
    exact ⟨hA, hB, hC, hx, hxy.symm.trans hx, hyz.symm.trans (hxy.symm.trans hx)⟩
  · rintro ⟨hA, hB, hC, hx, hy, hz⟩
    exact ⟨⟨⟨hA, hB, hC⟩, hx.trans hy.symm, hy.trans hz.symm⟩, hx⟩

/-- Cyclic rotation of vertices gives a cardinality-preserving cyclic
rotation of the three owner colors inside every fixed component. -/
theorem card_cyclicColoredTriplesInComponent_rotate
    {V : Type*} [Fintype V] [DecidableEq V]
    (D A B C : SimpleGraph V) [DecidableRel D.Adj]
    [Fintype D.ConnectedComponent] [DecidableEq D.ConnectedComponent]
    [DecidableRel A.Adj] [DecidableRel B.Adj] [DecidableRel C.Adj]
    (d : D.ConnectedComponent) :
    (cyclicColoredTriplesInComponent D A B C d).card =
      (cyclicColoredTriplesInComponent D B C A d).card := by
  classical
  apply Finset.card_bij (fun p _ => (p.2.2, p.1, p.2.1))
  · intro p hp
    rw [mem_cyclicColoredTriplesInComponent_iff] at hp ⊢
    exact ⟨hp.2.1, hp.2.2.1, hp.1, hp.2.2.2.2.1,
      hp.2.2.2.2.2, hp.2.2.2.1⟩
  · intro p hp q hq hpq
    rcases p with ⟨x, z, y⟩
    rcases q with ⟨x', z', y'⟩
    simp only at hpq
    cases hpq
    rfl
  · intro p hp
    refine ⟨(p.2.1, p.2.2, p.1), ?_, ?_⟩
    · rw [mem_cyclicColoredTriplesInComponent_iff] at hp ⊢
      exact ⟨hp.2.2.1, hp.1, hp.2.1, hp.2.2.2.2.2,
        hp.2.2.2.1, hp.2.2.2.2.1⟩
    · rcases p with ⟨x, z, y⟩
      rfl

/-- Reversing vertices gives a cardinality-preserving transposition of the
first two owner colors inside every fixed component. -/
theorem card_cyclicColoredTriplesInComponent_swap_first_two
    {V : Type*} [Fintype V] [DecidableEq V]
    (D A B C : SimpleGraph V) [DecidableRel D.Adj]
    [Fintype D.ConnectedComponent] [DecidableEq D.ConnectedComponent]
    [DecidableRel A.Adj] [DecidableRel B.Adj] [DecidableRel C.Adj]
    (d : D.ConnectedComponent) :
    (cyclicColoredTriplesInComponent D A B C d).card =
      (cyclicColoredTriplesInComponent D B A C d).card := by
  classical
  apply Finset.card_bij (fun p _ => (p.2.1, p.1, p.2.2))
  · intro p hp
    rw [mem_cyclicColoredTriplesInComponent_iff] at hp ⊢
    exact ⟨hp.2.1.symm, hp.1.symm, hp.2.2.1.symm,
      hp.2.2.2.2.2, hp.2.2.2.2.1, hp.2.2.2.1⟩
  · intro p hp q hq hpq
    rcases p with ⟨x, z, y⟩
    rcases q with ⟨x', z', y'⟩
    simp only at hpq
    cases hpq
    rfl
  · intro p hp
    refine ⟨(p.2.1, p.1, p.2.2), ?_, ?_⟩
    · rw [mem_cyclicColoredTriplesInComponent_iff] at hp ⊢
      exact ⟨hp.2.1.symm, hp.1.symm, hp.2.2.1.symm,
        hp.2.2.2.2.2, hp.2.2.2.2.1, hp.2.2.2.1⟩
    · rcases p with ⟨x, z, y⟩
      rfl

/-- The final two colors may likewise be exchanged; hence the component-fiber
cardinality is invariant under all permutations generated by these swaps. -/
theorem card_cyclicColoredTriplesInComponent_swap_last_two
    {V : Type*} [Fintype V] [DecidableEq V]
    (D A B C : SimpleGraph V) [DecidableRel D.Adj]
    [Fintype D.ConnectedComponent] [DecidableEq D.ConnectedComponent]
    [DecidableRel A.Adj] [DecidableRel B.Adj] [DecidableRel C.Adj]
    (d : D.ConnectedComponent) :
    (cyclicColoredTriplesInComponent D A B C d).card =
      (cyclicColoredTriplesInComponent D A C B d).card := by
  calc
    _ = (cyclicColoredTriplesInComponent D B C A d).card :=
      card_cyclicColoredTriplesInComponent_rotate D A B C d
    _ = (cyclicColoredTriplesInComponent D C A B d).card :=
      card_cyclicColoredTriplesInComponent_rotate D B C A d
    _ = (cyclicColoredTriplesInComponent D A C B d).card :=
      card_cyclicColoredTriplesInComponent_swap_first_two D C A B d

end

end Erdos85
