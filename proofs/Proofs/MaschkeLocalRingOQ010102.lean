import Mathlib

/-
# `𝔽_p[ℤ/p]` is a local ring with nilpotent augmentation ideal = Jacobson radical

This file answers the open question `maschke-theorem-oq-01-oq-01-oq-02`, the **Jacobson-radical
viewpoint** on the modular failure of Maschke's theorem, and completes the identification flagged
by the parent's first open question ("identify `g - 1` with a generator of the augmentation
ideal").

The parent entry `maschke-theorem-oq-01-oq-01` (`MaschkeModularCounterexampleOQ01`) proves that
`A = 𝔽_p[ℤ/p]` is **not** semisimple by exhibiting the nonzero nilpotent `g - 1`
(`(g-1)^p = 0`).  Its sibling `MaschkeAugmentationNoSplitOQ010101` shows the augmentation short
exact sequence does not split.  Neither identifies the augmentation ideal as principal, nor
computes the Jacobson radical, nor records the local structure.

This file supplies the full local-ring picture:

* `MaschkeLocalRing.ker_eq_span` — the **augmentation ideal is principal**, generated by the
  nilpotent `g - 1`: `ker ε = (g - 1)`.  (Every element of `𝔽_p[ℤ/p]` differs from a scalar
  by a multiple of `g - 1`, because every group element is a power of the generator and
  `g - 1 ∣ gⁿ - 1`.)
* `MaschkeLocalRing.ker_pow_card` — the augmentation ideal is **nilpotent of index `≤ p`**:
  `(ker ε)^p = ⊥`, via `(span {s})^n = span {sⁿ}` and `(g-1)^p = 0`.
* `MaschkeLocalRing.isLocalRing` — `𝔽_p[ℤ/p]` is a **local ring**: its unique maximal ideal is
  the augmentation ideal (it is maximal as the kernel of the surjection `ε` onto the field
  `𝔽_p`, and it contains every maximal ideal because it equals the nilradical).
* `MaschkeLocalRing.jacobson_eq_ker` — the **Jacobson radical equals the augmentation ideal**
  `Ring.jacobson A = ker ε`, and `MaschkeLocalRing.jacobson_ne_bot` records that it is nonzero.
* `MaschkeLocalRing.not_isSemisimpleRing` — a **second, radical-theoretic proof** that
  `𝔽_p[ℤ/p]` is not semisimple, via `IsSemisimpleRing R ↔ Ring.jacobson R = ⊥` (the
  Artin–Wedderburn obstruction), independent of the parent's "non-reduced" route.

The clean structural slogan: `𝔽_p[ℤ/p] ≅ 𝔽_p[X]/((X-1)^p)` is a local Artinian ring whose
maximal ideal `(g-1)` is nonzero and nilpotent — its Jacobson radical does not vanish, which is
exactly why semisimplicity (and hence Maschke's theorem) fails in characteristic `p`.

## References

* Curtis–Reiner, *Representation Theory of Finite Groups and Associative Algebras*, §5 and §54
  (modular group algebras, the radical of `k[G]`).
* Mathlib: `Mathlib/RingTheory/Artinian/Module.lean` (`isSemisimpleRing_iff_jacobson`),
  `Mathlib/RingTheory/LocalRing/MaximalIdeal/Basic.lean`, `Mathlib/Algebra/CharP/Lemmas.lean`.
-/

open scoped MonoidAlgebra

namespace MaschkeLocalRing

variable (p : ℕ) [Fact p.Prime]

/-- The group `G = ℤ/p` written multiplicatively. -/
abbrev G : Type := Multiplicative (ZMod p)

/-- The modular group algebra `A = 𝔽_p[ℤ/p]`. -/
abbrev A : Type := MonoidAlgebra (ZMod p) (G p)

/-- `A = 𝔽_p[ℤ/p]` has characteristic `p` (a `ZMod p`-algebra with injective structure map). -/
instance charP : CharP (A p) p :=
  charP_of_injective_algebraMap (algebraMap (ZMod p) (A p)).injective p

/-- The image of the standard generator of `ℤ/p`. -/
noncomputable def g : A p := MonoidAlgebra.of (ZMod p) (G p) (Multiplicative.ofAdd 1)

/-- The **augmentation map** `ε : 𝔽_p[ℤ/p] → 𝔽_p`, `∑ a_h h ↦ ∑ a_h`. -/
noncomputable def ε : A p →ₐ[ZMod p] ZMod p :=
  MonoidAlgebra.lift (ZMod p) (G p) (ZMod p) 1

@[simp] theorem ε_of (a : G p) : ε p (MonoidAlgebra.of (ZMod p) (G p) a) = 1 := by
  simp [ε]

@[simp] theorem ε_g : ε p (g p) = 1 := by unfold g; exact ε_of p _

/-! ## The generator and its nilpotent difference -/

/-- `g ^ p = 1`: the exponent `p • (1 : ZMod p) = 0` collapses the generator to the identity. -/
theorem g_pow_card : (g p) ^ p = 1 := by
  have hz : p • (1 : ZMod p) = 0 := by simp
  unfold g
  rw [← map_pow, ← ofAdd_nsmul, hz, ofAdd_zero, map_one]

/-- **Frobenius collapse.** `(g - 1) ^ p = 0` in characteristic `p`. -/
theorem g_sub_one_pow_card : (g p - 1) ^ p = 0 := by
  rw [sub_pow_char, one_pow, g_pow_card, sub_self]

/-- `g - 1` is nilpotent. -/
theorem isNilpotent_g_sub_one : IsNilpotent (g p - 1) :=
  ⟨p, g_sub_one_pow_card p⟩

/-- The generator differs from the identity, so `g - 1 ≠ 0`. -/
theorem g_sub_one_ne_zero : g p - 1 ≠ 0 := by
  rw [sub_ne_zero]
  unfold g
  intro h
  rw [show (1 : A p) = MonoidAlgebra.of (ZMod p) (G p) 1 from (map_one _).symm] at h
  have h2 := MonoidAlgebra.of_injective h
  exact one_ne_zero (ofAdd_eq_one.mp h2)

/-! ## The augmentation ideal is principal, generated by `g - 1` -/

/-- Every basis element is a power of the generator: `of (ofAdd m) = gᵐ` (exponent `m.val`). -/
theorem of_eq_g_pow (m : ZMod p) :
    MonoidAlgebra.of (ZMod p) (G p) (Multiplicative.ofAdd m) = (g p) ^ m.val := by
  haveI : NeZero p := ⟨(Fact.out : Nat.Prime p).pos.ne'⟩
  rw [g, ← map_pow, ← ofAdd_nsmul, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

/-- For each group element `h`, `of h - 1` is a multiple of `g - 1` (since `g - 1 ∣ gⁿ - 1`). -/
theorem of_sub_one_mem (h : G p) :
    MonoidAlgebra.of (ZMod p) (G p) h - 1 ∈ Ideal.span ({g p - 1} : Set (A p)) := by
  rw [Ideal.mem_span_singleton]
  obtain ⟨m, rfl⟩ : ∃ m : ZMod p, Multiplicative.ofAdd m = h := ⟨Multiplicative.toAdd h, rfl⟩
  rw [of_eq_g_pow]
  simpa using sub_dvd_pow_sub_pow (g p) 1 m.val

/-- Linearity bridge: every element differs from its scalar `ε`-value by a multiple of `g - 1`. -/
theorem sub_smul_one_mem (y : A p) :
    y - (ε p y) • (1 : A p) ∈ Ideal.span ({g p - 1} : Set (A p)) := by
  induction y using MonoidAlgebra.induction_on with
  | hM m =>
      rw [ε_of, one_smul]
      exact of_sub_one_mem p m
  | hadd x y hx hy =>
      have : (x + y) - (ε p (x + y)) • (1 : A p)
          = (x - (ε p x) • (1 : A p)) + (y - (ε p y) • (1 : A p)) := by
        rw [map_add, add_smul]; ring
      rw [this]; exact Submodule.add_mem _ hx hy
  | hsmul r x hx =>
      have : r • x - (ε p (r • x)) • (1 : A p) = r • (x - (ε p x) • (1 : A p)) := by
        rw [map_smul, smul_sub, smul_assoc]
      rw [this, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hx

/-- **The augmentation ideal is principal.** `ker ε = (g - 1)`: the nilpotent `g - 1` generates
the codimension-one augmentation ideal. -/
theorem ker_eq_span :
    RingHom.ker (ε p).toRingHom = Ideal.span ({g p - 1} : Set (A p)) := by
  apply le_antisymm
  · intro y hy
    rw [RingHom.mem_ker] at hy
    have hy0 : ε p y = 0 := hy
    have hmem := sub_smul_one_mem p y
    rwa [hy0, zero_smul, sub_zero] at hmem
  · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
    show ε p (g p - 1) = 0
    rw [map_sub, ε_g, map_one, sub_self]

/-- **The augmentation ideal is nilpotent of index `≤ p`.** `(ker ε)^p = ⊥`. -/
theorem ker_pow_card : (RingHom.ker (ε p).toRingHom) ^ p = ⊥ := by
  rw [ker_eq_span, Ideal.span_singleton_pow, g_sub_one_pow_card]
  simp

/-! ## Maximality, locality, and the Jacobson radical -/

/-- The augmentation map is surjective (it splits the unit `𝔽_p ↪ 𝔽_p[ℤ/p]`). -/
theorem ε_surjective : Function.Surjective (ε p).toRingHom := fun c =>
  ⟨algebraMap (ZMod p) (A p) c, by
    show ε p (algebraMap (ZMod p) (A p) c) = c
    rw [AlgHom.commutes]; simp⟩

/-- The augmentation ideal is **maximal** (kernel of a surjection onto the field `𝔽_p`). -/
theorem ker_isMaximal : (RingHom.ker (ε p).toRingHom).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective (ε p).toRingHom (ε_surjective p)

/-- The augmentation ideal is **nonzero** (it contains `g - 1 ≠ 0`). -/
theorem ker_ne_bot : RingHom.ker (ε p).toRingHom ≠ ⊥ := by
  rw [ker_eq_span]
  intro h
  have hmem : g p - 1 ∈ Ideal.span ({g p - 1} : Set (A p)) :=
    Ideal.mem_span_singleton_self _
  rw [h, Ideal.mem_bot] at hmem
  exact g_sub_one_ne_zero p hmem

/-- **`𝔽_p[ℤ/p]` is a local ring.** Its unique maximal ideal is the augmentation ideal: that
ideal is maximal, and any maximal ideal `M` contains the nilradical `= (g-1) = ker ε`, hence
equals it. -/
theorem isLocalRing : IsLocalRing (A p) := by
  apply IsLocalRing.of_unique_max_ideal
  refine ⟨RingHom.ker (ε p).toRingHom, ker_isMaximal p, ?_⟩
  intro M hM
  haveI := hM.isPrime
  have hmem : g p - 1 ∈ M :=
    nilradical_le_prime M (mem_nilradical.mpr (isNilpotent_g_sub_one p))
  have hsub : RingHom.ker (ε p).toRingHom ≤ M := by
    rw [ker_eq_span, Ideal.span_singleton_le_iff_mem]; exact hmem
  exact ((ker_isMaximal p).eq_of_le hM.ne_top hsub).symm

/-- **The Jacobson radical equals the augmentation ideal.** `Ring.jacobson A = ker ε`. -/
theorem jacobson_eq_ker :
    Ring.jacobson (A p) = RingHom.ker (ε p).toRingHom := by
  haveI := isLocalRing p
  rw [IsLocalRing.ringJacobson_eq_maximalIdeal,
    IsLocalRing.ker_eq_maximalIdeal (ε p).toRingHom (ε_surjective p)]

/-- The Jacobson radical of `𝔽_p[ℤ/p]` is **nonzero** — the precise obstruction to
semisimplicity. -/
theorem jacobson_ne_bot : Ring.jacobson (A p) ≠ ⊥ := by
  rw [jacobson_eq_ker]; exact ker_ne_bot p

/-- **Radical-theoretic proof of the modular counterexample.** Since `𝔽_p[ℤ/p]` is Artinian,
`IsSemisimpleRing ↔ Ring.jacobson = ⊥`; the nonzero radical therefore forbids semisimplicity —
an independent route to the failure of Maschke's theorem in characteristic `p`. -/
theorem not_isSemisimpleRing : ¬ IsSemisimpleRing (A p) := by
  haveI : Finite (A p) :=
    Finite.of_equiv _ (Finsupp.equivFunOnFinite (α := G p) (M := ZMod p)).symm
  haveI : IsArtinianRing (A p) := isArtinian_of_finite
  rw [IsArtinianRing.isSemisimpleRing_iff_jacobson]
  exact jacobson_ne_bot p

end MaschkeLocalRing
