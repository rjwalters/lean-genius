/-!
# A sharp finite conductor for degree seven

Besides the checked order-48 graph, `ER(7)` supplies degree-seven witnesses
at orders 56 and 57.  The numerical semigroup generated by `48,56,57`
contains every integer from 632 onward.  We certify one complete residue band
and then add copies of the order-48 graph.
-/

namespace Erdos85

def er7DegreeSevenDelete1 : Finset (Fin 57) := {0}

theorem er7_delete1_degreeSeven_witness : C4FreeMinDegreeWitness 56 7 := by
  apply c4FreeMinDegreeWitness_of_card_eq
    (er7DeleteGraph er7DegreeSevenDelete1)
  · native_decide
  · native_decide
  · exact er7DeleteGraph_not_containsC4 er7DegreeSevenDelete1

theorem er7_degreeSeven_witness : C4FreeMinDegreeWitness 57 7 := by
  refine ⟨er7Graph, inferInstance, ?_, er7Graph_not_containsC4⟩
  apply SimpleGraph.le_minDegree_of_forall_le_degree
  exact er7Graph_degree_ge_seven

theorem degreeSeven_witness_linear_two
    (a c : ℕ) (ha : 0 < a) (hc : 0 < c) :
    C4FreeMinDegreeWitness (a * 48 + c * 57) 7 := by
  have hA : C4FreeMinDegreeWitness (a * 48) 7 := by
    simpa [Nat.mul_comm] using
      boza48_degreeSeven_witness.nsmul (by norm_num) ha
  have hC : C4FreeMinDegreeWitness (c * 57) 7 := by
    simpa [Nat.mul_comm] using
      er7_degreeSeven_witness.nsmul (by norm_num) hc
  exact C4FreeMinDegreeWitness.add (by positivity) (by positivity) hA hC

/-- Positive copies of the order-56 witness, with optional order-48 and
order-57 summands. -/
theorem degreeSeven_witness_linear_three
    (a b c : ℕ) (hb : 0 < b) :
    C4FreeMinDegreeWitness (a * 48 + b * 56 + c * 57) 7 := by
  have hB : C4FreeMinDegreeWitness (b * 56) 7 := by
    simpa [Nat.mul_comm] using
      er7_delete1_degreeSeven_witness.nsmul (by norm_num) hb
  by_cases ha : a = 0
  · subst a
    simp only [zero_mul, zero_add]
    by_cases hc : c = 0
    · simpa [hc] using hB
    · have hC : C4FreeMinDegreeWitness (c * 57) 7 := by
        simpa [Nat.mul_comm] using
          er7_degreeSeven_witness.nsmul (by norm_num) (Nat.pos_of_ne_zero hc)
      exact C4FreeMinDegreeWitness.add (by positivity) (by positivity) hB hC
  · have hA : C4FreeMinDegreeWitness (a * 48) 7 := by
      simpa [Nat.mul_comm] using
        boza48_degreeSeven_witness.nsmul (by norm_num) (Nat.pos_of_ne_zero ha)
    have hAB : C4FreeMinDegreeWitness (a * 48 + b * 56) 7 :=
      C4FreeMinDegreeWitness.add (by positivity) (by positivity) hA hB
    by_cases hc : c = 0
    · simpa [hc] using hAB
    · have hC : C4FreeMinDegreeWitness (c * 57) 7 := by
        simpa [Nat.mul_comm] using
          er7_degreeSeven_witness.nsmul (by norm_num) (Nat.pos_of_ne_zero hc)
      exact C4FreeMinDegreeWitness.add (by positivity) (by positivity) hAB hC

