import Mathlib

/-
# The subfield lattice of `GF(pⁿ)`: the embedding–divisibility criterion

The parent entry `little-wedderburn-oq-02` classifies finite fields up to
isomorphism: for each prime power `q` there is exactly one field `GF(q)`.  That
records *which* finite fields exist but says nothing about how they sit inside
one another.  This entry establishes the next structural fact — the rigid
divisibility pattern governing embeddings of Galois fields of a fixed
characteristic:

> `GF(pᵐ)` embeds in `GF(pⁿ)` (as `𝔽ₚ`-algebras) **iff** `m ∣ n`.

and its refinements:

* the number of `𝔽ₚ`-algebra embeddings `GF(pᵐ) →ₐ GF(pⁿ)` is exactly `m`
  whenever `m ∣ n` (in particular the number of `𝔽ₚ`-algebra endomorphisms of
  `GF(pⁿ)` is `n`);
* **subfield degrees are exactly the divisors of `n`**: every divisor `d ∣ n`
  is realised as the degree of a subfield of `GF(pⁿ)`
  (`exists_subalgebra_finrank_of_dvd`), and conversely the degree of *any*
  intermediate field `𝔽ₚ ⊆ K ⊆ GF(pⁿ)` divides `n`
  (`intermediateField_finrank_dvd`).

So for `GF(2¹²)` the subfield degrees are precisely `{1, 2, 3, 4, 6, 12}`, the
divisor lattice of `12`.

The cyclic Frobenius–Galois group story (`Gal(GF(pⁿ)/𝔽ₚ) ≅ ℤ/nℤ`, generated by
`x ↦ xᵖ`, of order exactly `n`) is developed in the sibling entries
`frobenius-endomorphism-oq-01-oq-01` and `little-wedderburn-oq-01-oq-01-oq-01`;
here we focus on the embedding criterion and the subfield-degree lattice, which
those entries do not address.

The engine is Mathlib's `FieldTheory/Finite/GaloisField.lean`:
`FiniteField.nonempty_algHom_iff_finrank_dvd`,
`FiniteField.natCard_algHom_of_finrank_dvd`, and `GaloisField.finrank`
(`[GF(pⁿ) : 𝔽ₚ] = n`).  Everything is fully machine-checked, no axioms, no
sorries.
-/

open Module

namespace LittleWedderburnOQ02OQ01

variable (p : ℕ) [Fact p.Prime]

/-- **Embedding criterion (divisor lattice).**  For `m, n ≥ 1`, the Galois field
`GF(pᵐ)` admits an `𝔽ₚ = ℤ/p`-algebra homomorphism into `GF(pⁿ)` — equivalently,
embeds as a subfield — **iff** `m ∣ n`.  (A homomorphism of fields is
automatically injective, so "nonempty hom set" is the same as "embeds".) -/
theorem galoisField_embeds_iff_dvd {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    Nonempty (GaloisField p m →ₐ[ZMod p] GaloisField p n) ↔ m ∣ n := by
  rw [FiniteField.nonempty_algHom_iff_finrank_dvd, GaloisField.finrank p hm,
    GaloisField.finrank p hn]

/-- **Counting embeddings.**  When `m ∣ n` there are exactly `m` distinct
`𝔽ₚ`-algebra embeddings `GF(pᵐ) →ₐ GF(pⁿ)` — one for each conjugate of a
primitive generator under the Frobenius action. -/
theorem galoisField_natCard_algHom {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (hmn : m ∣ n) :
    Nat.card (GaloisField p m →ₐ[ZMod p] GaloisField p n) = m := by
  have h : finrank (ZMod p) (GaloisField p m) ∣ finrank (ZMod p) (GaloisField p n) := by
    rw [GaloisField.finrank p hm, GaloisField.finrank p hn]; exact hmn
  rw [FiniteField.natCard_algHom_of_finrank_dvd h, GaloisField.finrank p hm]

/-- The number of `𝔽ₚ`-algebra endomorphisms of `GF(pⁿ)` is `n` (the special case
`m = n` of the count; these endomorphisms are exactly the automorphisms, the
powers of Frobenius). -/
theorem galoisField_natCard_endo {n : ℕ} (hn : n ≠ 0) :
    Nat.card (GaloisField p n →ₐ[ZMod p] GaloisField p n) = n :=
  galoisField_natCard_algHom p hn hn dvd_rfl

/-- **Every divisor is realised.**  For `d ∣ n` (`d, n ≥ 1`) there is a subfield
(here: an `𝔽ₚ`-subalgebra) of `GF(pⁿ)` of degree exactly `d` over `𝔽ₚ` — namely
the image of an embedding `GF(pᵈ) ↪ GF(pⁿ)`, isomorphic to `GF(pᵈ)`. -/
theorem exists_subalgebra_finrank_of_dvd {n d : ℕ} (hn : n ≠ 0) (hd : d ≠ 0)
    (hdn : d ∣ n) :
    ∃ K : Subalgebra (ZMod p) (GaloisField p n), finrank (ZMod p) K = d := by
  obtain ⟨f⟩ := (galoisField_embeds_iff_dvd p hd hn).2 hdn
  refine ⟨f.range, ?_⟩
  have e : GaloisField p d ≃ₗ[ZMod p] f.range :=
    (AlgEquiv.ofInjectiveField f).toLinearEquiv
  rw [← e.finrank_eq, GaloisField.finrank p hd]

/-- The corresponding cardinality statement: a subfield of degree `d` over `𝔽ₚ`
has exactly `pᵈ` elements. -/
theorem exists_subalgebra_card_of_dvd {n d : ℕ} (hn : n ≠ 0) (hd : d ≠ 0)
    (hdn : d ∣ n) :
    ∃ K : Subalgebra (ZMod p) (GaloisField p n), Nat.card K = p ^ d := by
  obtain ⟨K, hK⟩ := exists_subalgebra_finrank_of_dvd p hn hd hdn
  refine ⟨K, ?_⟩
  rw [Module.natCard_eq_pow_finrank (K := ZMod p), Nat.card_zmod, hK]

/-- **Subfield degrees divide `n`.**  The degree over `𝔽ₚ` of *any* intermediate
field `𝔽ₚ ⊆ K ⊆ GF(pⁿ)` divides `n`, by the tower law
`[K : 𝔽ₚ] · [GF(pⁿ) : K] = [GF(pⁿ) : 𝔽ₚ] = n`.  Together with
`exists_subalgebra_finrank_of_dvd` this says the subfield degrees of `GF(pⁿ)` are
*exactly* the divisors of `n`. -/
theorem intermediateField_finrank_dvd {n : ℕ} (hn : n ≠ 0)
    (K : IntermediateField (ZMod p) (GaloisField p n)) :
    finrank (ZMod p) K ∣ n := by
  have htower := Module.finrank_mul_finrank (ZMod p) K (GaloisField p n)
  rw [GaloisField.finrank p hn] at htower
  exact ⟨finrank K (GaloisField p n), htower.symm⟩

/-! ### Concrete instances -/

/-- `GF(2²)` embeds in `GF(2⁴)` because `2 ∣ 4`. -/
example : Nonempty (GaloisField 2 2 →ₐ[ZMod 2] GaloisField 2 4) :=
  (galoisField_embeds_iff_dvd 2 (by norm_num) (by norm_num)).2 (by norm_num)

/-- `GF(2²)` does **not** embed in `GF(2³)` because `2 ∤ 3`. -/
example : IsEmpty (GaloisField 2 2 →ₐ[ZMod 2] GaloisField 2 3) := by
  rw [← not_nonempty_iff, galoisField_embeds_iff_dvd 2 (by norm_num) (by norm_num)]
  decide

/-- There are exactly `2` embeddings `GF(2²) →ₐ GF(2⁴)`. -/
example : Nat.card (GaloisField 2 2 →ₐ[ZMod 2] GaloisField 2 4) = 2 :=
  galoisField_natCard_algHom 2 (by norm_num) (by norm_num) (by norm_num)

/-- `GF(2¹²)` has a degree-`6` subfield (a copy of `GF(2⁶)`), since `6 ∣ 12`. -/
example : ∃ K : Subalgebra (ZMod 2) (GaloisField 2 12), finrank (ZMod 2) K = 6 :=
  exists_subalgebra_finrank_of_dvd 2 (by norm_num) (by norm_num) (by norm_num)

/-- `GF(2¹²)` has **no** degree-`5` subfield, since `5 ∤ 12`. -/
example (K : IntermediateField (ZMod 2) (GaloisField 2 12)) :
    finrank (ZMod 2) K ≠ 5 := by
  intro h
  have : (5 : ℕ) ∣ 12 := h ▸ intermediateField_finrank_dvd 2 (by norm_num) K
  norm_num at this

end LittleWedderburnOQ02OQ01
