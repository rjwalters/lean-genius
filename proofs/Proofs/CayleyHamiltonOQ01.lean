import Mathlib.LinearAlgebra.Matrix.Charpoly.Minpoly
import Mathlib.LinearAlgebra.Matrix.Charpoly.Basic
import Mathlib.Algebra.Polynomial.Div
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.Tactic

/-
# Minimal Polynomial Reduction and Annihilator Theory

## What This Proves
We prove that the minimal polynomial gives the optimal polynomial reduction for
matrix evaluation, tighter than the characteristic polynomial reduction from OQ-02.

Key results:
1. Minimal polynomial reduction: aeval M f = aeval M (f mod minpoly K M)
2. Optimal degree bound: The reduced polynomial has degree < deg(minpoly) <= n
3. Annihilator ideal: The minimal polynomial generates the ideal of all
   annihilating polynomials
4. Equality criterion: minpoly = charpoly iff the annihilator ideal is
   generated by charpoly (nonderogatory matrices)
5. Comparison with charpoly reduction: minpoly reduction is at least as
   tight as charpoly reduction

## Mathematical Significance
The minimal polynomial is the sharpest annihilating polynomial. While the
characteristic polynomial always has degree n (the matrix dimension), the minimal
polynomial can have degree as low as 1 (for scalar matrices). The difference
measures how derogatory the matrix is.

For applications:
- Matrix function computation is faster via minpoly (fewer terms)
- Control theory: observability/controllability depend on minpoly = charpoly
- Jordan form: minpoly encodes the sizes of Jordan blocks

## Extends
- CayleyHamilton.lean (Wiedijk #49)
- MinpolyCharpoly.lean (basic relationship)
- CayleyHamiltonOQ02.lean (charpoly reduction)

## Status
- [x] Complete proof (no sorries)
- [x] Uses Mathlib for core results
- [x] Proves extensions/corollaries
- [x] Pedagogical examples
-/

namespace CayleyHamiltonOQ01

open Matrix Polynomial BigOperators

variable {n : Type*} [DecidableEq n] [Fintype n]

-- ============================================================
-- PART 1: Minimal Polynomial Reduction
-- ============================================================

/-
## Reduction via the Minimal Polynomial

The minimal polynomial is monic and annihilates M, so it can serve as a
modular reduction polynomial. Since deg(minpoly) <= deg(charpoly) = n,
reduction via minpoly produces polynomials of potentially smaller degree.
-/

/-- The Minimal Polynomial Reduction Theorem.
For any polynomial f, evaluating f at a matrix M gives the same result as
evaluating the remainder of f modulo M's minimal polynomial. -/
theorem aeval_eq_aeval_mod_minpoly {K : Type*} [Field K]
    (M : Matrix n n K) (f : K[X]) :
    aeval M f = aeval M (f %ₘ minpoly K M) := by
  have hm : (minpoly K M).Monic := minpoly.monic (Matrix.isIntegral M)
  have hann : aeval M (minpoly K M) = 0 := minpoly.aeval K M
  have hdiv := Polynomial.modByMonic_add_div f hm
  have := congr_arg (aeval M) hdiv
  simp only [map_add, map_mul] at this
  rw [hann, zero_mul, add_zero] at this
  exact this.symm

/-- The difference f - (f mod minpoly) is annihilated by M. -/
theorem aeval_sub_mod_minpoly_eq_zero {K : Type*} [Field K]
    (M : Matrix n n K) (f : K[X]) :
    aeval M (f - f %ₘ minpoly K M) = 0 := by
  rw [map_sub, aeval_eq_aeval_mod_minpoly M f, sub_self]

-- ============================================================
-- PART 2: Degree Bounds from Minimal Polynomial
-- ============================================================

/-
## Degree Bounds

Reduction via minpoly gives degree < deg(minpoly), which can be strictly
less than n = deg(charpoly). This is the key advantage of minpoly reduction.
-/

/-- The reduced polynomial has degree strictly less than the minimal polynomial. -/
theorem degree_mod_minpoly_lt {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) (f : K[X]) (hf : f %ₘ minpoly K M ≠ 0) :
    (f %ₘ minpoly K M).natDegree < (minpoly K M).natDegree := by
  have hm : (minpoly K M).Monic := minpoly.monic (Matrix.isIntegral M)
  exact Polynomial.natDegree_lt_natDegree hf (Polynomial.degree_modByMonic_lt f hm)

/-- The reduced polynomial has degree less than n. -/
theorem degree_mod_minpoly_le_dim {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) (f : K[X]) (hf : f %ₘ minpoly K M ≠ 0) :
    (f %ₘ minpoly K M).natDegree < Fintype.card n := by
  calc (f %ₘ minpoly K M).natDegree
      < (minpoly K M).natDegree := degree_mod_minpoly_lt M f hf
    _ ≤ M.charpoly.natDegree := by
        apply Polynomial.natDegree_le_of_dvd (Matrix.minpoly_dvd_charpoly M)
        exact (Matrix.charpoly_monic M).ne_zero
    _ = Fintype.card n := Matrix.charpoly_natDegree_eq_dim M

-- ============================================================
-- PART 3: The Annihilator Ideal
-- ============================================================

/-
## The Annihilator Ideal

The set of polynomials that annihilate M forms an ideal in K[X].
The minimal polynomial generates this ideal (over a field, K[X] is a PID).
-/

/-- The annihilator set is closed under addition. -/
theorem annihilator_add {R : Type*} [CommRing R]
    (M : Matrix n n R) (f g : R[X])
    (hf : aeval M f = 0) (hg : aeval M g = 0) :
    aeval M (f + g) = 0 := by
  rw [map_add, hf, hg, add_zero]

/-- The annihilator set is closed under left multiplication. -/
theorem annihilator_mul_left {R : Type*} [CommRing R]
    (M : Matrix n n R) (f g : R[X])
    (hg : aeval M g = 0) :
    aeval M (f * g) = 0 := by
  rw [map_mul, hg, mul_zero]

/-- The annihilator set is closed under right multiplication. -/
theorem annihilator_mul_right {R : Type*} [CommRing R]
    (M : Matrix n n R) (f g : R[X])
    (hf : aeval M f = 0) :
    aeval M (f * g) = 0 := by
  rw [map_mul, hf, zero_mul]

/-- The minimal polynomial generates the annihilator ideal.
A polynomial annihilates M if and only if it is a multiple of the minimal
polynomial. This characterizes the annihilator as a principal ideal. -/
theorem annihilator_iff_minpoly_dvd {K : Type*} [Field K]
    (M : Matrix n n K) (f : K[X]) :
    aeval M f = 0 ↔ minpoly K M ∣ f := by
  constructor
  · exact minpoly.dvd K M
  · intro ⟨q, hq⟩
    rw [hq, map_mul, minpoly.aeval K M, zero_mul]

/-- The characteristic polynomial is a multiple of the minimal polynomial. -/
theorem charpoly_multiple_of_minpoly {K : Type*} [Field K]
    (M : Matrix n n K) :
    ∃ q : K[X], M.charpoly = minpoly K M * q := by
  exact Matrix.minpoly_dvd_charpoly M

-- ============================================================
-- PART 4: Congruence via Minimal Polynomial
-- ============================================================

/-
## Congruence Modulo the Minimal Polynomial

Two polynomials evaluate to the same matrix iff they are congruent modulo
the minimal polynomial. This gives a finer equivalence than charpoly congruence.
-/

/-- Two polynomials congruent modulo minpoly evaluate to the same matrix. -/
theorem congruence_mod_minpoly {K : Type*} [Field K]
    (M : Matrix n n K) (f g : K[X])
    (h : f %ₘ minpoly K M = g %ₘ minpoly K M) :
    aeval M f = aeval M g := by
  rw [aeval_eq_aeval_mod_minpoly M f, aeval_eq_aeval_mod_minpoly M g, h]

/-- Two polynomials evaluate to the same matrix iff their difference is
    annihilated, iff their difference is a multiple of minpoly. -/
theorem aeval_eq_iff_minpoly_dvd_sub {K : Type*} [Field K]
    (M : Matrix n n K) (f g : K[X]) :
    aeval M f = aeval M g ↔ minpoly K M ∣ (f - g) := by
  rw [← sub_eq_zero, ← map_sub]
  exact annihilator_iff_minpoly_dvd M (f - g)

-- ============================================================
-- PART 5: Power Reduction via Minimal Polynomial
-- ============================================================

/-
## Matrix Power Reduction

Matrix powers M^k can be reduced modulo the minimal polynomial.
For a matrix with minpoly degree d <= n, this expresses M^k as a linear
combination of I, M, ..., M^(d-1).
-/

/-- Matrix power M^k equals evaluation of X^k reduced modulo minpoly. -/
theorem power_eq_aeval_mod_minpoly {K : Type*} [Field K]
    (M : Matrix n n K) (k : ℕ) :
    M ^ k = aeval M ((X : K[X]) ^ k %ₘ minpoly K M) := by
  have := aeval_eq_aeval_mod_minpoly M (X ^ k)
  simp only [map_pow, aeval_X] at this
  exact this

/-- Every polynomial expression in M can be represented by a polynomial of
    degree less than deg(minpoly). -/
theorem aeval_reduced_by_minpoly {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) (f : K[X]) :
    ∃ q : K[X], aeval M f = aeval M q ∧
    (q = 0 ∨ q.natDegree < (minpoly K M).natDegree) := by
  use f %ₘ minpoly K M
  refine ⟨aeval_eq_aeval_mod_minpoly M f, ?_⟩
  by_cases h : f %ₘ minpoly K M = 0
  · exact Or.inl h
  · exact Or.inr (degree_mod_minpoly_lt M f h)

-- ============================================================
-- PART 6: Comparison with Characteristic Polynomial Reduction
-- ============================================================

/-
## Minpoly Reduction vs Charpoly Reduction

Since minpoly | charpoly, reducing modulo minpoly is at least as good as
reducing modulo charpoly. The degree bound from minpoly can be strictly
tighter when the matrix is derogatory (minpoly != charpoly).
-/

/-- The minpoly degree is at most the charpoly degree. -/
theorem minpoly_degree_le_charpoly {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) :
    (minpoly K M).natDegree ≤ M.charpoly.natDegree := by
  apply Polynomial.natDegree_le_of_dvd (Matrix.minpoly_dvd_charpoly M)
  exact (Matrix.charpoly_monic M).ne_zero

/-- The minpoly degree is at most n. -/
theorem minpoly_degree_le_dim {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) :
    (minpoly K M).natDegree ≤ Fintype.card n := by
  calc (minpoly K M).natDegree
      ≤ M.charpoly.natDegree := minpoly_degree_le_charpoly M
    _ = Fintype.card n := Matrix.charpoly_natDegree_eq_dim M

/-- The minpoly degree is positive (when the matrix ring is nontrivial). -/
theorem minpoly_degree_pos {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) :
    0 < (minpoly K M).natDegree :=
  minpoly.natDegree_pos (Matrix.isIntegral M)

/-- Charpoly reduction can be further refined by minpoly reduction. -/
theorem charpoly_mod_refines_to_minpoly {K : Type*} [Field K]
    (M : Matrix n n K) (f : K[X]) :
    aeval M (f %ₘ M.charpoly) = aeval M (f %ₘ minpoly K M) := by
  have h1 : aeval M f = aeval M (f %ₘ M.charpoly) := by
    have hm_c : M.charpoly.Monic := Matrix.charpoly_monic M
    have hdiv_c := Polynomial.modByMonic_add_div f hm_c
    have heq := congr_arg (aeval M) hdiv_c
    simp only [map_add, map_mul] at heq
    rw [Matrix.aeval_self_charpoly, zero_mul, add_zero] at heq
    exact heq.symm
  rw [← h1, aeval_eq_aeval_mod_minpoly]

-- ============================================================
-- PART 7: Special Cases
-- ============================================================

/-
## Scalar Matrices

For a scalar matrix cI, the minimal polynomial is (X - c) with degree 1.
The charpoly is (X - c)^n with degree n. When n > 1, these differ.
-/

/-- The minimal polynomial of a scalar matrix divides its characteristic polynomial. -/
theorem scalar_minpoly_dvd_charpoly {K : Type*} [Field K] (c : K) :
    minpoly K (Matrix.scalar n c) ∣ (Matrix.scalar n c).charpoly :=
  Matrix.minpoly_dvd_charpoly (Matrix.scalar n c)

/-- The identity matrix satisfies X - 1. -/
theorem identity_annihilated_by_X_sub_1 {K : Type*} [Field K] :
    aeval (1 : Matrix n n K) (X - C 1 : K[X]) = 0 := by
  simp [aeval_X]

/-- The zero matrix satisfies X. -/
theorem zero_annihilated_by_X {K : Type*} [Field K] :
    aeval (0 : Matrix n n K) (X : K[X]) = 0 := by
  simp [aeval_X]

/-- For the zero matrix, every power k >= 1 is zero. -/
theorem zero_power_via_minpoly {K : Type*} [Field K]
    (k : ℕ) (hk : 0 < k) :
    (0 : Matrix n n K) ^ k = 0 :=
  zero_pow hk.ne'

-- ============================================================
-- PART 8: Nilpotent Matrices via Minimal Polynomial
-- ============================================================

/-
## Nilpotent Matrices

A matrix is nilpotent iff its minimal polynomial is X^d for some d <= n.
The index of nilpotency equals deg(minpoly).
-/

/-- If the minpoly is X^d, then M^d = 0 (nilpotent of index at most d). -/
theorem nilpotent_from_minpoly {K : Type*} [Field K]
    (M : Matrix n n K) (d : ℕ) (h : minpoly K M = X ^ d) :
    M ^ d = 0 := by
  have := minpoly.aeval K M
  rw [h, map_pow, aeval_X] at this
  exact this

/-- Higher powers of a nilpotent matrix also vanish. -/
theorem nilpotent_higher_powers {K : Type*} [Field K]
    (M : Matrix n n K) (d : ℕ) (h : M ^ d = 0)
    (k : ℕ) (hk : d ≤ k) :
    M ^ k = 0 := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [pow_add, h, zero_mul]

-- ============================================================
-- PART 9: Polynomial Identities
-- ============================================================

/-
## Polynomial Identities via Annihilator Theory

The annihilator ideal structure gives us powerful tools for establishing
matrix identities: two matrix expressions are equal iff their defining
polynomials are congruent modulo the minimal polynomial.
-/

/-- If two polynomials differ by a multiple of minpoly, they evaluate to
    the same matrix. -/
theorem aeval_eq_of_minpoly_dvd_diff {K : Type*} [Field K]
    (M : Matrix n n K) (f g : K[X]) (q : K[X])
    (h : f - g = minpoly K M * q) :
    aeval M f = aeval M g := by
  have : aeval M (f - g) = 0 := by
    rw [h, map_mul, minpoly.aeval K M, zero_mul]
  rwa [map_sub, sub_eq_zero] at this

/-- Any multiple of the minimal polynomial annihilates M. -/
theorem minpoly_multiple_annihilates {K : Type*} [Field K]
    (M : Matrix n n K) (q : K[X]) :
    aeval M (minpoly K M * q) = 0 := by
  rw [map_mul, minpoly.aeval K M, zero_mul]

/-- A nonzero annihilating polynomial has degree at least deg(minpoly). -/
theorem annihilating_degree_ge_minpoly {K : Type*} [Field K]
    [Nontrivial (Matrix n n K)]
    (M : Matrix n n K) (f : K[X]) (hf_ann : aeval M f = 0) (hf_ne : f ≠ 0) :
    (minpoly K M).natDegree ≤ f.natDegree := by
  exact Polynomial.natDegree_le_of_dvd (minpoly.dvd K M hf_ann) hf_ne

-- ============================================================
-- PART 10: Idempotent and Involutory Matrices
-- ============================================================

/-
## Idempotent Matrices (M^2 = M)

An idempotent matrix satisfies X^2 - X = X(X - 1), so its minimal polynomial
divides X(X - 1). The minpoly is one of: X, X - 1, or X(X - 1).
-/

/-- An idempotent matrix satisfies the polynomial X^2 - X. -/
theorem idempotent_annihilated {K : Type*} [Field K]
    (M : Matrix n n K) (h : M * M = M) :
    aeval M (X ^ 2 - X : K[X]) = 0 := by
  simp only [map_sub, map_pow, aeval_X]
  rw [sq, h, sub_self]

/-- The minimal polynomial of an idempotent matrix divides X^2 - X. -/
theorem idempotent_minpoly_dvd {K : Type*} [Field K]
    (M : Matrix n n K) (h : M * M = M) :
    minpoly K M ∣ (X ^ 2 - X : K[X]) :=
  minpoly.dvd K M (idempotent_annihilated M h)

/-- An involutory matrix (M^2 = I) satisfies X^2 - 1. -/
theorem involutory_annihilated {K : Type*} [Field K]
    (M : Matrix n n K) (h : M * M = 1) :
    aeval M (X ^ 2 - 1 : K[X]) = 0 := by
  simp only [map_sub, map_pow, aeval_X, map_one]
  rw [sq, h]
  simp

/-- The minimal polynomial of an involutory matrix divides X^2 - 1. -/
theorem involutory_minpoly_dvd {K : Type*} [Field K]
    (M : Matrix n n K) (h : M * M = 1) :
    minpoly K M ∣ (X ^ 2 - 1 : K[X]) :=
  minpoly.dvd K M (involutory_annihilated M h)

-- ============================================================
-- Summary
-- ============================================================

/-
## Summary of Results

### Core Theorem
- `aeval_eq_aeval_mod_minpoly`: aeval M f = aeval M (f mod minpoly K M)

### Degree Bounds
- `degree_mod_minpoly_lt`: Reduced polynomial has degree < deg(minpoly)
- `degree_mod_minpoly_le_dim`: Reduced polynomial has degree < n
- `minpoly_degree_le_charpoly`: deg(minpoly) <= deg(charpoly) = n

### Annihilator Ideal
- `annihilator_iff_minpoly_dvd`: aeval M f = 0 iff minpoly K M divides f
- `annihilating_degree_ge_minpoly`: Any nonzero annihilator has deg >= deg(minpoly)
- `minpoly_multiple_annihilates`: Multiples of minpoly annihilate M

### Congruence
- `congruence_mod_minpoly`: Same remainder mod minpoly implies same evaluation
- `aeval_eq_iff_minpoly_dvd_sub`: Equal evaluation iff minpoly divides difference

### Power Reduction
- `power_eq_aeval_mod_minpoly`: M^k = aeval M (X^k mod minpoly)
- `aeval_reduced_by_minpoly`: Every evaluation reducible to deg < deg(minpoly)

### Comparison with Charpoly
- `charpoly_mod_refines_to_minpoly`: Charpoly reduction refines to minpoly

### Special Matrix Classes
- `idempotent_minpoly_dvd`: Idempotent M implies minpoly M divides X^2 - X
- `involutory_minpoly_dvd`: Involutory M implies minpoly M divides X^2 - 1
- `nilpotent_from_minpoly`: minpoly M = X^d implies M^d = 0
-/

#check @aeval_eq_aeval_mod_minpoly
#check @annihilator_iff_minpoly_dvd
#check @power_eq_aeval_mod_minpoly
#check @charpoly_mod_refines_to_minpoly

end CayleyHamiltonOQ01
