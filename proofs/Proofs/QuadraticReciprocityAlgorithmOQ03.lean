namespace QuadraticReciprocityAlgorithmOQ03

open Equiv Equiv.Perm

/-! ## The missing producer lemma: left-multiplication by a generator is a cycle -/

/-- **The one lemma Mathlib lacks** (confirmed absent @ rev `2df2f01`). In a finite group
generated by `g` with at least two elements, left multiplication by `g` is a single cycle.

Proof (per knowledge.md S9): discharge the `IsCycle` constructor with witness `x = 1`.
- `mulLeft g` moves `1` (to `g`, and `g ≠ 1` because `g` generates a group of card ≥ 2).
- every `y` is on the same cycle as `1`: from `y ∈ zpowers g` get `i` with `g ^ i = y`,
  and `(mulLeft g) ^ i` applied to `1` is `g ^ i * 1 = g ^ i = y`. -/
theorem isCycle_mulLeft_of_generator {G : Type*} [Group G] [Fintype G] [DecidableEq G]
    {g : G} (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (hG : 2 ≤ Fintype.card G) :
    (Equiv.mulLeft g).IsCycle := by
  -- `g ≠ 1`: otherwise `zpowers g = ⊥`, so generation forces every element to be `1`,
  -- contradicting `2 ≤ card G`.
  have hg1 : g ≠ 1 := by
    rintro rfl
    have hg' := hg
    simp only [Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot] at hg'
    have hnt : Nontrivial G := Fintype.one_lt_card_iff_nontrivial.1 (by omega)
    obtain ⟨a, b, hab⟩ := exists_pair_ne G
    exact hab ((hg' a).trans (hg' b).symm)
  -- key wiring: `(mulLeft g) ^ i` applied to `1` equals `g ^ i`.
  -- `a ↦ Equiv.mulLeft a` is a monoid hom `G →* Perm G`, so it commutes with `zpow`
  -- via `map_zpow`. Mathlib has no `mulLeft_zpow`/`mulLeft_pow` lemma (confirmed absent
  -- @ rev 2df2f01), so bundle the hom inline rather than name a nonexistent lemma.
  have hpow : ∀ i : ℤ, (Equiv.mulLeft g ^ i) 1 = g ^ i := by
    intro i
    have key : (Equiv.mulLeft g ^ i) = Equiv.mulLeft (g ^ i) := by
      have hz := map_zpow
        ({ toFun := Equiv.mulLeft
           map_one' := by ext x; simp [Equiv.coe_mulLeft]
           map_mul' := fun a b => by
             ext x; simp [Equiv.coe_mulLeft, Equiv.Perm.mul_apply, mul_assoc] } :
          G →* Equiv.Perm G) g i
      simpa using hz.symm
    rw [key]; simp [Equiv.coe_mulLeft]
  refine ⟨1, ?_, ?_⟩
  · -- `mulLeft g` moves the point `1`.
    simpa using hg1
  · -- every fixed-point-free `y` (here: every `y`) shares the cycle of `1`.
    intro y _
    obtain ⟨i, hi⟩ := (Subgroup.mem_zpowers_iff).1 (hg y)
    exact ⟨i, by rw [hpow i]; exact hi⟩

/-! ## Sign of multiplication by a generator is `-1` -/

/-- For a finite group of even order generated by `g`, `sign (mulLeft g) = -1`.
(The units group `(ℤ/p)ˣ` has order `p − 1`, even for odd `p`.) -/
theorem sign_mulLeft_generator {G : Type*} [Group G] [Fintype G] [DecidableEq G]
    {g : G} (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (hG : 2 ≤ Fintype.card G)
    (heven : Even (Fintype.card G)) :
    Equiv.Perm.sign (Equiv.mulLeft g) = -1 := by
  have hcyc : (Equiv.mulLeft g).IsCycle := isCycle_mulLeft_of_generator hg hG
  -- the support of `mulLeft g` is all of `G` (it has no fixed points)
  have hsupp : (Equiv.mulLeft g).support = Finset.univ := by
    ext x
    simp only [Finset.mem_univ, iff_true, Equiv.Perm.mem_support, Equiv.coe_mulLeft]
    -- `g * x = x ↔ g = 1`, false since `g ≠ 1`
    intro hx
    have : g = 1 := by
      have := mul_right_cancel (a := g) (b := x) (c := 1) (by simpa using hx)
      simpa using this
    -- contradiction with generation + card ≥ 2
    have hg1 : g ≠ 1 := by
      rintro rfl
      have hg' := hg
      simp only [Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot] at hg'
      have hnt : Nontrivial G := Fintype.one_lt_card_iff_nontrivial.1 (by omega)
      obtain ⟨a, b, hab⟩ := exists_pair_ne G
      exact hab ((hg' a).trans (hg' b).symm)
    exact hg1 this
  -- `IsCycle.sign : sign f = -(-1) ^ f.support.card`
  rw [hcyc.sign, hsupp, Finset.card_univ]
  rcases heven with ⟨k, hk⟩
  -- card even ⇒ `(-1)^card = 1` ⇒ `-(1) = -1`
  have : ((-1 : ℤˣ)) ^ (Fintype.card G) = 1 := by
    rw [hk]; simp [pow_add, pow_mul]
  rw [this]

end QuadraticReciprocityAlgorithmOQ03
