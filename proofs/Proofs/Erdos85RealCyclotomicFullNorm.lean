import Proofs.Erdos85RealCyclotomicIndexTwo

/-!
# Full cyclotomic norm of a real trace translate

For a primitive root `z` of order at least three, the full cyclotomic field
has degree two over the field generated by `μ = z + z⁻¹`.  Consequently the
full norm of `c - μ` is the square of the real minimal-polynomial value.
-/

namespace Erdos85

noncomputable section

/-- **Primitive real-trace full norm.**  In a cyclotomic field generated by
a primitive root of order at least three,

`Norm_{K/ℚ}(c - (z+z⁻¹)) = minpoly_ℚ(z+z⁻¹)(c)²`.

This is the precise theoretical quantity which the executable Möbius
certificate must identify. -/
theorem norm_rat_sub_primitiveTrace_eq_minpoly_eval_sq
    {K : Type*} [Field K] [CharZero K]
    {ell : ℕ} {z : K} (hz : IsPrimitiveRoot z ell) (hell : 3 ≤ ell)
    [IsCyclotomicExtension {ell} ℚ K] (c : ℚ) :
    let μ := z + z⁻¹
    Algebra.norm ℚ
        (algebraMap (IntermediateField.adjoin ℚ {μ}) K
          (⟨(c : K) - μ, rat_sub_mem_adjoin c μ⟩ :
            IntermediateField.adjoin ℚ {μ})) =
      (minpoly ℚ μ).eval c * (minpoly ℚ μ).eval c := by
  dsimp only
  have hellpos : 0 < ell := lt_of_lt_of_le (by norm_num) hell
  have hzint : IsIntegral ℚ z := (hz.isIntegral hellpos).tower_top
  have hzinv : IsIntegral ℚ z⁻¹ :=
    (hz.inv.isIntegral hellpos).tower_top
  have hμint : IsIntegral ℚ (z + z⁻¹) := hzint.add hzinv
  have hfinrank :=
    finrank_adjoin_add_inv_eq_two_of_isCyclotomicExtension hz hell
  letI : FiniteDimensional
      (IntermediateField.adjoin ℚ {z + z⁻¹}) K :=
    FiniteDimensional.of_finrank_pos (by rw [hfinrank]; norm_num)
  exact norm_rat_sub_eq_minpoly_eval_sq_of_finrank_two
    (z + z⁻¹) c hμint
    hfinrank

end

end Erdos85
