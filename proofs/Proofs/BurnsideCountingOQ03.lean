open BigOperators Finset MulAction Nat

/-!
# Pólya Enumeration Theorem for Cyclic Groups

## Overview

This file develops the Pólya enumeration theorem (PET) for cyclic group actions,
generalizing the fixed-point counting results in `BurnsideCounting.lean`.

**The Key Insight**: For cyclic rotation by r on n positions with k colors:
  |Fix(r)| = k ^ gcd(r, n)

**Why**: The orbit of position i under rotation by r in Z/nZ is exactly
  {j : Fin n | j ≡ i mod gcd(r, n)}
because the subgroup generated by r in Z/nZ is gcd(r,n)·Z_{n/gcd(r,n)}.
Hence there are gcd(r, n) orbits, each of size n/gcd(r, n),
and a fixed coloring assigns one color per orbit.

**Combined with Burnside's lemma**, this yields the Pólya formula for necklaces:
  n · (#distinct k-colorings) = Σ_{r : Fin n} k^gcd(r, n)
                               = Σ_{d | n} φ(n/d) · k^d

## Main Contributions

1. `fp_sum_binary4`: Burnside fixed-point sum for binary 4-necklaces = 24 (proved by computation)
2. `polya_sum_Z4_binary`, `polya_divisor_sum_Z4_binary`: The Pólya sum identities
3. `addOrderOf_rotation`: Connection to additive order in ZMod n via Mathlib
4. `polya_cyclic_fixed_count`: |Fix(r)| = k^gcd(r.val, n) (general, proved for n=4)

## Key Mathlib Fact Used

  `ZMod.addOrderOf_coe (a : ℕ) {n : ℕ} (n0 : n ≠ 0) : addOrderOf (↑a : ZMod n) = n / n.gcd a`

The additive order of r in ZMod n is n/gcd(n, r).
This equals the orbit size, so there are gcd(n, r) orbits,
and the number of fixed colorings is k^gcd(n, r).
-/

namespace BurnsideCountingOQ03

/-! ## §1: Cyclic Rotation Definitions -/

/-- A coloring c : Fin n → Fin k is fixed by rotation r ∈ Fin n if every position
    maps to the same color as its rotated-back position (rotate backward by r). -/
def IsFixed (n k : ℕ) [NeZero n] (r : Fin n) (c : Fin n → Fin k) : Prop :=
  ∀ i : Fin n, c i = c ⟨(i.val + n - r.val) % n, Nat.mod_lt _ (NeZero.pos n)⟩

/-- Fixed coloring predicate is decidable. -/
instance {n k : ℕ} [NeZero n] {r : Fin n} : DecidablePred (IsFixed n k r) :=
  fun c => Fintype.decidableForallFintype

/-! ## §2: Connection to addOrderOf -/

/-- The additive order of r in ZMod n is n / gcd(n, r.val).
    This is the **orbit size** under rotation by r on Fin n.
    The **number of orbits** = n / (orbit size) = gcd(n, r.val). -/
theorem addOrderOf_rotation {n : ℕ} [NeZero n] (r : ZMod n) :
    addOrderOf r = n / Nat.gcd n r.val := by
  conv_lhs => rw [← ZMod.natCast_zmod_val r]
  exact ZMod.addOrderOf_coe r.val (NeZero.ne n)

-- Note: addOrderOf is noncomputable, so examples are proved via the formula, not decide.
-- addOrderOf (1 : ZMod 4) = 4 / gcd(4, 1) = 4 / 1 = 4 (ZMod 4 has characteristic 4)
-- addOrderOf (2 : ZMod 4) = 4 / gcd(4, 2) = 4 / 2 = 2 (period-2 element)
-- addOrderOf (3 : ZMod 4) = 4 / gcd(4, 3) = 4 / 1 = 4 (unit mod 4)
-- addOrderOf (0 : ZMod 4) = 4 / gcd(4, 0) = 4 / 4 = 1 (identity has order 1)
-- Number of orbits = gcd(r.val, n): for r=0, gcd(0,4)=4 → 4 orbits of size 1 (identity fixes all).

/-! ## §3: Orbit Structure of Cyclic Rotation -/

/-- **Key Lemma** (proof sketch):
    For rotation by r on Fin n, a coloring is fixed iff it is constant on the
    cosets of the subgroup <r> in Z/nZ.

    The subgroup <r> = {k·r mod n | k : ℕ} has order addOrderOf r = n/gcd(n,r).
    The cosets of <r> in Z/nZ biject with Z/(gcd(n,r)·Z) = Fin gcd(n,r).
    Two positions i, j are in the same coset iff i ≡ j mod gcd(n, r).

    Therefore: a fixed coloring factors through (i ↦ i.val mod gcd(n,r)).

    **Proof**:
    i ≡ j mod d iff d | (i - j) iff (i - j) ∈ <d> = <gcd(r,n)> ⊆ <r, n>.
    Since d = gcd(r, n), we have d | r, so r ∈ <d>, hence <d> ⊆ <r> (in Z/nZ).
    Also <r> ⊆ <d> since every multiple of r is divisible by gcd(r,n) = d.
    So <r> = <d> in Z/nZ, and i ≡ j mod d iff i and j are in the same orbit. -/
theorem fixed_factors_through_mod {n k : ℕ} [NeZero n] (r : Fin n)
    (c : Fin n → Fin k) (hc : IsFixed n k r c) (i j : Fin n)
    (hij : i.val % Nat.gcd r.val n = j.val % Nat.gcd r.val n) : c i = c j := by
  sorry

/-- **Fixed-Point Count**: The bijection between fixed colorings and (Fin d → Fin k)
    (where d = gcd(r.val, n)) gives |Fix(r)| = k^gcd(r.val, n).

    **Proof outline**:
    - Forward map: c ↦ (j ↦ c ⟨j.val, j.val_lt_n⟩) for j : Fin d
      (defined on d ≤ n representative positions)
    - Backward map: f ↦ (i ↦ f ⟨i.val % d, mod_lt_d⟩)
      (color by orbit representative)
    - This is well-defined since i.val % d is in the same orbit as i
      (by Bezout: gcd(r,n)·Z ⊆ <r, n>, so d | (i - (i%d)) implies reachability)
    - Cardinality: |(Fin d → Fin k)| = k^d = k^gcd(r.val, n) -/
theorem polya_cyclic_fixed_count (n k : ℕ) [NeZero n] (r : Fin n) :
    Fintype.card {c : Fin n → Fin k // IsFixed n k r c} = k ^ Nat.gcd r.val n := by
  sorry

/-! ## §4: Concrete Verification for n = 4, k = 2 (Proved by native_decide) -/

/-- All 16 binary 4-colorings are fixed by the identity rotation r=0.
    Verification: k^gcd(0, 4) = 2^4 = 16 ✓ -/
theorem fp_count_rot0_4_2 :
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨0, by norm_num⟩ c} = 16 := by
  native_decide

/-- Only 2 binary 4-colorings are fixed by rotation r=1 (constant colorings).
    Verification: k^gcd(1, 4) = 2^1 = 2 ✓ -/
theorem fp_count_rot1_4_2 :
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨1, by norm_num⟩ c} = 2 := by
  native_decide

/-- 4 binary 4-colorings are fixed by rotation r=2 (period-2: c(0)=c(2), c(1)=c(3)).
    Verification: k^gcd(2, 4) = 2^2 = 4 ✓ -/
theorem fp_count_rot2_4_2 :
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨2, by norm_num⟩ c} = 4 := by
  native_decide

/-- Only 2 binary 4-colorings are fixed by rotation r=3 (constant colorings).
    Verification: k^gcd(3, 4) = 2^1 = 2 ✓ -/
theorem fp_count_rot3_4_2 :
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨3, by norm_num⟩ c} = 2 := by
  native_decide

/-- **Burnside sum** for Z_4 acting on binary 4-colorings = 24.
    This verifies: Σ_{r ∈ Z_4} |Fix(r)| = 16 + 2 + 4 + 2 = 24 -/
theorem fp_sum_binary4 :
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨0, by norm_num⟩ c} +
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨1, by norm_num⟩ c} +
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨2, by norm_num⟩ c} +
    Fintype.card {c : Fin 4 → Fin 2 // IsFixed 4 2 ⟨3, by norm_num⟩ c} = 24 := by
  simp only [fp_count_rot0_4_2, fp_count_rot1_4_2, fp_count_rot2_4_2, fp_count_rot3_4_2]

/-! ## §5: The Pólya Sum Formula -/

/-- **Pólya's Fixed-Point Sum for Z_4 on binary colorings**:
    Σ_{r : Fin 4} 2^gcd(r, 4) = 2^gcd(0,4) + 2^gcd(1,4) + 2^gcd(2,4) + 2^gcd(3,4)
                               = 2^4 + 2^1 + 2^2 + 2^1 = 16 + 2 + 4 + 2 = 24 -/
theorem polya_sum_Z4_binary : ∑ r : Fin 4, (2 : ℕ) ^ Nat.gcd r.val 4 = 24 := by
  native_decide

/-- **Divisor sum form of the Pólya formula** for n=4, k=2:
    Σ_{d | 4} φ(4/d) · 2^d = φ(4)·2^1 + φ(2)·2^2 + φ(1)·2^4
                             = 2·2 + 1·4 + 1·16 = 4 + 4 + 16 = 24
    (Note: divisors of 4 are {1, 2, 4}) -/
theorem polya_divisor_sum_Z4_binary :
    ∑ d ∈ Nat.divisors 4, Nat.totient (4 / d) * 2 ^ d = 24 := by
  native_decide

/-- The two formulations agree for n=4, k=2 (a special case of the Pólya sum identity). -/
theorem polya_sum_equiv_4_2 :
    ∑ r : Fin 4, (2 : ℕ) ^ Nat.gcd r.val 4 =
    ∑ d ∈ Nat.divisors 4, Nat.totient (4 / d) * 2 ^ d := by
  native_decide

/-- The general Pólya sum identity for cyclic Z_n:
    Σ_{r : Fin n} k^gcd(r, n) = Σ_{d | n} φ(n/d) · k^d
    Proof: reindex by d = gcd(r, n); for each d|n, there are φ(n/d) rotations r
    with gcd(r, n) = d (these are the r with gcd(r/d, n/d) = 1, i.e., r/d coprime to n/d). -/
theorem polya_sum_identity (n k : ℕ) (hn : 0 < n) :
    ∑ r : Fin n, k ^ Nat.gcd r.val n =
    ∑ d ∈ Nat.divisors n, Nat.totient (n / d) * k ^ d := by
  sorry  -- General reindexing argument via Nat.sum_totient structure

/-! ## §6: Application to Binary 4-Necklaces -/

/-- Arithmetic verification: 24 / 4 = 6. -/
theorem burnside_count_6 : 24 / 4 = 6 := by norm_num

/-- The Pólya formula gives 6 binary necklaces of length 4.
    By Burnside: #orbits = (Σ |Fix(r)|) / |G| = 24 / 4 = 6.
    This is consistent with the 6 equivalence classes:
    {0000}, {0001,0010,0100,1000}, {0011,0110,1100,1001},
    {0101,1010}, {0111,1110,1101,1011}, {1111}. -/
theorem polya_binary4_necklace_count : (∑ r : Fin 4, (2 : ℕ) ^ Nat.gcd r.val 4) / 4 = 6 := by
  simp [polya_sum_Z4_binary]

/-- The divisor sum form also gives 6. -/
theorem polya_binary4_divisor_form :
    (∑ d ∈ Nat.divisors 4, Nat.totient (4 / d) * 2 ^ d) / 4 = 6 := by
  simp [polya_divisor_sum_Z4_binary]

/-! ## §7: General Pólya Necklace Formula (Statement) -/

/-- **Pólya's Theorem for Cyclic Necklaces** (general statement):
    For cyclic rotation of Z_n on Fin n → Fin k (k-colorings of n positions):

      n · (#distinct k-necklaces) = Σ_{r : Fin n} k^gcd(r, n)
                                   = Σ_{d | n} φ(n/d) · k^d

    **Proof outline** (using Burnside + Pólya fixed-point formula):
    1. `polya_cyclic_fixed_count`: |Fix(r)| = k^gcd(r,n) for each r
    2. Burnside: n · #orbits = Σ_r |Fix(r)| = Σ_r k^gcd(r,n)
    3. `polya_sum_identity`: Σ_r k^gcd(r,n) = Σ_{d|n} φ(n/d) · k^d -/
theorem polya_necklace_formula_statement (n k : ℕ) [NeZero n] :
    -- This is the Pólya counting formula; proof requires Burnside connection
    ∀ (necklace_count : ℕ),
    (∀ r : Fin n, Fintype.card {c : Fin n → Fin k // IsFixed n k r c} = k ^ Nat.gcd r.val n) →
    n * necklace_count = ∑ r : Fin n, k ^ Nat.gcd r.val n := by
  intro necklace_count hfixed
  -- This requires connecting IsFixed to fixedBy and applying Burnside's lemma
  sorry

