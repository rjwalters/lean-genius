/-
## Scanl Infrastructure
-/

private theorem scanl_add_ge_init (a : ℕ) (l : List ℕ) :
    ∀ x ∈ List.scanl (· + ·) a l, x ≥ a := by
  induction l generalizing a with
  | nil => intro x hx; simp [List.scanl] at hx; omega
  | cons d ds ih =>
    intro x hx; simp [List.scanl] at hx
    rcases hx with rfl | hx
    · omega
    · exact le_trans (Nat.le_add_right a d) (ih (a + d) x hx)

theorem scanl_tail_dichotomy (d₁ d₂ : ℕ) (rest : List ℕ) (n : ℕ)
    (hmem : n ∈ (List.scanl (· + ·) 0 (d₁ :: d₂ :: rest)).tail) :
    n = d₁ ∨ n ≥ d₁ + d₂ := by
  simp [List.scanl] at hmem
  rcases hmem with rfl | hmem
  · left; omega
  · right; have := scanl_add_ge_init (0 + d₁ + d₂) rest n hmem; omega

/-
## Sorted Divisor Properties
-/

theorem mem_sortedDivisors_iff (m d : ℕ) :
    d ∈ sortedDivisors m ↔ d ∈ m.divisors := by
  unfold sortedDivisors
  exact ⟨fun h => List.mem_sort.mp h, fun h => List.mem_sort.mpr (Finset.mem_toList.mpr h)⟩

theorem sortedDivisors_sorted (m : ℕ) : (sortedDivisors m).Sorted (· ≤ ·) := by
  unfold sortedDivisors; exact List.sorted_sort (· ≤ ·) m.divisors.val

theorem sortedDivisors_nodup (m : ℕ) : (sortedDivisors m).Nodup := by
  unfold sortedDivisors; exact List.Nodup.sort _ (Finset.sort_nodup _ _)

theorem sortedDivisors_nonempty (m : ℕ) (hm : m ≥ 1) : sortedDivisors m ≠ [] := by
  intro h
  have h1 : (1 : ℕ) ∈ m.divisors := by rw [Nat.mem_divisors]; exact ⟨one_dvd m, by omega⟩
  have h1s : (1 : ℕ) ∈ sortedDivisors m := by
    unfold sortedDivisors; exact List.mem_sort.mpr (Finset.mem_toList.mpr h1)
  rw [h] at h1s; exact List.not_mem_nil _ h1s

theorem sortedDivisors_pos (m : ℕ) (hm : m ≥ 1) (d : ℕ) (hd : d ∈ sortedDivisors m) :
    d ≥ 1 := by
  rw [mem_sortedDivisors_iff] at hd
  have := (Nat.mem_divisors.mp hd).1
  exact Nat.pos_of_ne_zero (fun h => by simp [h] at this; omega)

theorem sortedDivisors_head_eq_one (m : ℕ) (hm : m ≥ 1)
    (hne : sortedDivisors m ≠ []) : (sortedDivisors m).head hne = 1 := by
  have hsorted := sortedDivisors_sorted m
  have h1 : 1 ∈ sortedDivisors m := by
    rw [mem_sortedDivisors_iff, Nat.mem_divisors]; exact ⟨one_dvd m, by omega⟩
  have hle := List.Sorted.head_le_of_mem hsorted h1
  have hge := sortedDivisors_pos m hm _ (List.head_mem hne)
  omega

theorem sortedDivisors_cons_one (m : ℕ) (hm : m ≥ 1) :
    ∃ rest, sortedDivisors m = 1 :: rest := by
  have hne := sortedDivisors_nonempty m hm
  exact ⟨(sortedDivisors m).tail, by rw [← sortedDivisors_head_eq_one m hm hne, List.head_cons_tail]⟩

theorem sortedDivisors_length_ge_two (m : ℕ) (hm : m ≥ 2) :
    (sortedDivisors m).length ≥ 2 := by
  unfold sortedDivisors; rw [List.length_sort]
  have h1 : (1 : ℕ) ∈ m.divisors := by rw [Nat.mem_divisors]; exact ⟨one_dvd m, by omega⟩
  have hm_mem : m ∈ m.divisors := by rw [Nat.mem_divisors]; exact ⟨dvd_refl m, by omega⟩
  have hsub : ({1, m} : Finset ℕ) ⊆ m.divisors := by
    intro x hx; simp at hx; rcases hx with rfl | rfl <;> assumption
  calc m.divisors.card ≥ ({1, m} : Finset ℕ).card := Finset.card_le_card hsub
    _ = 2 := by rw [Finset.card_pair (by omega : (1 : ℕ) ≠ m)]

theorem sortedDivisors_second_ge_minFac (m : ℕ) (hm : m ≥ 2) :
    ∃ d₂ rest, sortedDivisors m = 1 :: d₂ :: rest ∧ d₂ ≥ m.minFac := by
  obtain ⟨rest, hrest⟩ := sortedDivisors_cons_one m (by omega)
  have hlen := sortedDivisors_length_ge_two m hm
  rw [hrest] at hlen; simp at hlen
  match rest, hlen with
  | d₂ :: rest', _ =>
    refine ⟨d₂, rest', hrest ▸ rfl, ?_⟩
    have hnodup := sortedDivisors_nodup m
    rw [hrest] at hnodup
    have hd₂_ne_1 : d₂ ≠ 1 := by
      intro h; rw [h] at hnodup
      exact (List.nodup_cons.mp hnodup).1 (List.mem_cons_self _ _)
    have hd₂_mem : d₂ ∈ sortedDivisors m := by
      rw [hrest]; exact List.mem_cons_of_mem _ (List.mem_cons_self _ _)
    have hd₂_div := (mem_sortedDivisors_iff m d₂).mp hd₂_mem
    exact Nat.minFac_le_of_dvd (by omega) (Nat.mem_divisors.mp hd₂_div).1

/-
## Structural Non-Representability Proofs
-/

theorem partial_sums_skip_2 (m : ℕ) (hm : m ≥ 1) : 2 ∉ partialDivisorSums m := by
  intro hmem
  by_cases hm2 : m = 1
  · rw [hm2] at hmem; exact (by native_decide : (2 : ℕ) ∉ partialDivisorSums 1) hmem
  · obtain ⟨d₂, rest, hsd, hd₂_ge⟩ := sortedDivisors_second_ge_minFac m (by omega)
    have := (Nat.minFac_prime (by omega : m ≠ 1)).two_le
    unfold partialDivisorSums at hmem; rw [hsd] at hmem
    rcases scanl_tail_dichotomy 1 d₂ rest 2 hmem with h | h <;> omega

private theorem even_third_divisor_ge_three (m : ℕ) (_hm : m ≥ 4)
    (_hmin2 : m.minFac = 2) (d₃ : ℕ) (_rest' : List ℕ)
    (hsd : sortedDivisors m = 1 :: 2 :: d₃ :: _rest') : d₃ ≥ 3 := by
  have hsorted := sortedDivisors_sorted m
  have hnodup := sortedDivisors_nodup m
  rw [hsd] at hsorted hnodup
  have hd₃_ge2 : d₃ ≥ 2 := List.Sorted.rel_of_mem_of_mem hsorted
    (List.mem_cons_of_mem _ (List.mem_cons_self _ _))
    (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_self _ _)))
  have hd₃_ne2 : d₃ ≠ 2 := by
    intro h; exact (List.nodup_cons.mp (List.nodup_cons.mp hnodup).2).1 (h ▸ List.mem_cons_self _ _)
  omega

theorem partial_sums_skip_5 (m : ℕ) (hm : m ≥ 1) : 5 ∉ partialDivisorSums m := by
  intro hmem
  by_cases hm4 : m ≤ 3
  · interval_cases m <;> revert hmem <;> native_decide
  · push_neg at hm4
    obtain ⟨d₂, rest, hsd, hd₂_ge⟩ := sortedDivisors_second_ge_minFac m (by omega)
    have hmf_ge2 := (Nat.minFac_prime (by omega : m ≠ 1)).two_le
    unfold partialDivisorSums at hmem; rw [hsd] at hmem
    rcases scanl_tail_dichotomy 1 d₂ rest 5 hmem with h | h
    · omega
    · have hd₂_ne4 : d₂ ≠ 4 := by
        intro hd₂_eq
        have hd₂_mem : d₂ ∈ sortedDivisors m := by
          rw [hsd]; exact List.mem_cons_of_mem _ (List.mem_cons_self _ _)
        have hd₂_dvd := (Nat.mem_divisors.mp ((mem_sortedDivisors_iff m d₂).mp hd₂_mem)).1
        rw [hd₂_eq] at hd₂_dvd
        have h2_dvd : 2 ∣ m := dvd_trans ⟨2, by ring⟩ hd₂_dvd
        have h2_in : (2 : ℕ) ∈ sortedDivisors m := by
          rw [mem_sortedDivisors_iff, Nat.mem_divisors]; exact ⟨h2_dvd, by omega⟩
        rw [hsd] at h2_in; simp at h2_in
        rcases h2_in with h | h | h
        · omega
        · omega
        · have hsorted := sortedDivisors_sorted m
          rw [hsd, hd₂_eq] at hsorted
          exact absurd (List.Sorted.rel_of_mem_of_mem hsorted
            (List.mem_cons_of_mem _ (List.mem_cons_self _ _))
            (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ h))) (by omega)
      rcases (show d₂ = 2 ∨ d₂ = 3 by omega) with rfl | rfl
      · match rest with
        | [] => simp [List.scanl] at hmem; omega
        | d₃ :: rest' =>
          simp [List.scanl] at hmem
          rcases hmem with rfl | rfl | hmem
          · omega
          · omega
          · exact absurd (scanl_add_ge_init (0 + 1 + 2 + d₃) rest' 5 hmem)
              (by have := even_third_divisor_ge_three m (by omega) (by omega) d₃ rest' (by rw [hsd]); omega)
      · match rest with
        | [] => simp [List.scanl] at hmem; omega
        | d₃ :: rest' =>
          simp [List.scanl] at hmem
          rcases hmem with rfl | rfl | hmem
          · omega
          · omega
          · have hsorted := sortedDivisors_sorted m
            have hnodup := sortedDivisors_nodup m
            rw [hsd] at hsorted hnodup
            have hd₃_ge3 := List.Sorted.rel_of_mem_of_mem hsorted
              (List.mem_cons_of_mem _ (List.mem_cons_self _ _))
              (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_self _ _)))
            have hd₃_ne3 : d₃ ≠ 3 := by
              intro heq; exact (List.nodup_cons.mp (List.nodup_cons.mp hnodup).2).1
                (heq ▸ List.mem_cons_self _ _)
            exact absurd (scanl_add_ge_init (0 + 1 + 3 + d₃) rest' 5 hmem) (by omega)

theorem not_representable_2 : ¬IsRepresentable 2 := by
  intro ⟨m, hm, hmem⟩; exact partial_sums_skip_2 m hm hmem

theorem not_representable_5 : ¬IsRepresentable 5 := by
  intro ⟨m, hm, hmem⟩; exact partial_sums_skip_5 m hm hmem

/-
## The Open Problem
-/

def erdos_1054_part_i : Prop :=
  ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, (computeF n : ℝ) < ε * n

def erdos_1054_part_ii : Prop :=
  ∀ ε > 0, ∀ δ > 0, ∃ N : ℕ, ∀ M ≥ N,
    ((Finset.filter (fun n => decide ((computeF n : ℝ) ≥ ε * n)) (Finset.range M)).card : ℝ) < δ * M

def erdos_1054_part_iii : Prop :=
  ∀ C : ℝ, ∃ n : ℕ, n ≥ 1 ∧ (computeF n : ℝ) ≥ C * n

axiom tao_disproves_part_i : ¬erdos_1054_part_i

/-
## Structural Lemmas
-/

theorem dvd_4_implies_dvd_2 (m : ℕ) (h : 4 ∣ m) : 2 ∣ m := by
  obtain ⟨k, hk⟩ := h; exact ⟨2 * k, by omega⟩

theorem exists_prime_factor_ge_2 (m : ℕ) (hm : m ≥ 2) :
    ∃ p, p.Prime ∧ p ∣ m ∧ p ≥ 2 := by
  obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd (by omega : m ≠ 1)
  exact ⟨p, hp, hpm, hp.two_le⟩

theorem smallest_nontrivial_divisor (m : ℕ) (_hm : m ≥ 2) (d : ℕ)
    (hd : d ∈ m.divisors) (hd1 : d > 1) : d ≥ m.minFac := by
  exact Nat.minFac_le_of_dvd hd1 (Nat.mem_divisors.mp hd).1

