import Mathlib

/-
# OQ-07: The inverse of an invertible matrix is a polynomial in the matrix

A direct corollary of Cayley–Hamilton (`Matrix.aeval_self_charpoly`) in the
`cayley-hamilton-minpoly` family.

## Mathematical content

Let `A` be an `n × n` matrix over a field `K` with `det A ≠ 0`, and let
`p = charpoly A` be its characteristic polynomial.  Cayley–Hamilton gives
`p(A) = 0`.  Splitting off the constant term,

    p = (divX p) · X + C c₀,        c₀ = p.coeff 0,

and evaluating at `A` turns `p(A) = 0` into

    (divX p)(A) · A + c₀ • 1 = 0,   i.e.   (divX p)(A) · A = (−c₀) • 1.

By `Matrix.det_eq_sign_charpoly_coeff`, `det A = (−1)ⁿ c₀`, so `det A ≠ 0`
forces `c₀ ≠ 0`.  Dividing by the unit `−c₀` yields an explicit **left inverse
that is a polynomial in `A`**:

    A⁻¹ = (−c₀)⁻¹ • (divX p)(A) = (aeval A) r,
    r = C (−c₀)⁻¹ · divX p,   deg r < n.

Hence the inverse of any invertible matrix lies in `K[A]`, the subalgebra
generated by `A`, and is given by a polynomial of degree `< n`.  This is the
matrix-theoretic content behind "the inverse is a polynomial in the matrix",
and is the constructive companion to the abstract `minpoly`-based results in the
sibling entries.

Self-contained: imports only `Mathlib`.  Sorry-free and axiom-free
(`#print axioms` below: only `propext`, `Classical.choice`, `Quot.sound`).
-/

namespace CayleyHamiltonMinpolyOQ07

open Polynomial Matrix

variable {n : Type*} [DecidableEq n] [Fintype n]
variable {K : Type*} [Field K]

/-- The **inverse polynomial** of `A`: `r = C (−c₀)⁻¹ · divX (charpoly A)`, where
`c₀ = (charpoly A).coeff 0`.  Evaluating it at `A` produces `A⁻¹` (see
`inv_eq_aeval_invPoly`). -/
noncomputable def invPoly (A : Matrix n n K) : K[X] :=
  C (-(A.charpoly.coeff 0))⁻¹ * A.charpoly.divX

/-- If `det A ≠ 0`, the constant term of the characteristic polynomial is nonzero.
This is what makes the leading `c₀` a unit, so we can divide by it. -/
theorem charpoly_coeff_zero_ne_zero (A : Matrix n n K) (hA : A.det ≠ 0) :
    A.charpoly.coeff 0 ≠ 0 := by
  intro h
  apply hA
  rw [Matrix.det_eq_sign_charpoly_coeff, h, mul_zero]

/-- **Cayley–Hamilton in additive form.** Evaluating the decomposition
`charpoly A = divX (charpoly A) · X + C c₀` at `A` gives
`(divX p)(A) · A + c₀ • 1 = 0`. -/
theorem aeval_divX_mul_self (A : Matrix n n K) :
    (aeval A) A.charpoly.divX * A
      + algebraMap K (Matrix n n K) (A.charpoly.coeff 0) = 0 := by
  have hCH : (aeval A) A.charpoly = 0 := Matrix.aeval_self_charpoly A
  have hdec : A.charpoly.divX * X + C (A.charpoly.coeff 0) = A.charpoly :=
    divX_mul_X_add A.charpoly
  have h2 : (aeval A) (A.charpoly.divX * X + C (A.charpoly.coeff 0)) = 0 := by
    rw [hdec]; exact hCH
  rwa [map_add, map_mul, aeval_X, aeval_C] at h2

/-- **The inverse polynomial is a left inverse.** `(aeval A) (invPoly A) · A = 1`. -/
theorem aeval_invPoly_mul_self (A : Matrix n n K) (hA : A.det ≠ 0) :
    (aeval A) (invPoly A) * A = 1 := by
  have hc₀ : A.charpoly.coeff 0 ≠ 0 := charpoly_coeff_zero_ne_zero A hA
  have hc : (-(A.charpoly.coeff 0)) ≠ 0 := neg_ne_zero.mpr hc₀
  -- (divX p)(A) · A = (−c₀) • 1
  have hBA : (aeval A) A.charpoly.divX * A
      = (-(A.charpoly.coeff 0)) • (1 : Matrix n n K) := by
    have h := eq_neg_of_add_eq_zero_left (aeval_divX_mul_self A)
    rw [h, Algebra.algebraMap_eq_smul_one, neg_smul]
  -- (aeval A) (invPoly A) = (−c₀)⁻¹ • (divX p)(A)
  have hexp : (aeval A) (invPoly A)
      = (-(A.charpoly.coeff 0))⁻¹ • (aeval A) A.charpoly.divX := by
    rw [invPoly, map_mul, aeval_C, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  rw [hexp, smul_mul_assoc, hBA, smul_smul, inv_mul_cancel₀ hc, one_smul]

/-- **Main result.** For an invertible matrix `A` over a field, the inverse is
the evaluation at `A` of an explicit polynomial: `A⁻¹ = (aeval A) (invPoly A)`. -/
theorem inv_eq_aeval_invPoly (A : Matrix n n K) (hA : A.det ≠ 0) :
    A⁻¹ = (aeval A) (invPoly A) :=
  Matrix.inv_eq_left_inv (aeval_invPoly_mul_self A hA)

/-- **Degree bound.** The inverse polynomial has degree `< n` (`= Fintype.card n`).
No invertibility hypothesis is needed for the bound itself. -/
theorem invPoly_natDegree_lt [Nonempty n] (A : Matrix n n K) :
    (invPoly A).natDegree < Fintype.card n := by
  have hp_ne : A.charpoly ≠ 0 := A.charpoly_monic.ne_zero
  have hdim : A.charpoly.natDegree = Fintype.card n := Matrix.charpoly_natDegree_eq_dim A
  have h1 : (invPoly A).natDegree ≤ A.charpoly.divX.natDegree := by
    rw [invPoly]; exact natDegree_C_mul_le _ _
  have h2 : A.charpoly.divX.natDegree < A.charpoly.natDegree := by
    by_cases hdv : A.charpoly.divX = 0
    · rw [hdv, natDegree_zero, hdim]; exact Fintype.card_pos
    · exact natDegree_lt_natDegree hdv (degree_divX_lt hp_ne)
  omega

/-- **The inverse lies in the subalgebra generated by `A`.** `A⁻¹ ∈ K[A]`. -/
theorem inv_mem_adjoin (A : Matrix n n K) (hA : A.det ≠ 0) :
    A⁻¹ ∈ Algebra.adjoin K {A} := by
  rw [inv_eq_aeval_invPoly A hA, Algebra.adjoin_singleton_eq_range_aeval]
  exact ⟨invPoly A, rfl⟩

/-- **Right-inverse companion.** `A · (aeval A) (invPoly A) = 1`. -/
theorem self_mul_aeval_invPoly (A : Matrix n n K) (hA : A.det ≠ 0) :
    A * (aeval A) (invPoly A) = 1 := by
  have h := aeval_invPoly_mul_self A hA
  exact Matrix.mul_eq_one_comm.mp h

/-- **Packaged existence statement.** Every invertible matrix over a field has an
inverse expressible as a polynomial of degree `< n` in the matrix. -/
theorem exists_inv_eq_aeval [Nonempty n] (A : Matrix n n K) (hA : A.det ≠ 0) :
    ∃ r : K[X], r.natDegree < Fintype.card n ∧ A⁻¹ = (aeval A) r :=
  ⟨invPoly A, invPoly_natDegree_lt A, inv_eq_aeval_invPoly A hA⟩

end CayleyHamiltonMinpolyOQ07
