import Proofs.Erdos85OneHighV2Cnf

/-!
# Proof-grade exact v2 CNF regeneration tool

`lake exe v2cnf emit <profile> <table-file>` prints the byte-exact
`sweep_worker.py` v2 DIMACS for the given profile (`0..4` = number of
A pairs) and miss table, generated by the certified Lean generator.

`lake exe v2cnf check <profile> <table-file> <cnf-file>` regenerates
and compares clausewise against a supplied DIMACS file, printing
`MATCH` (exit 0) or the first divergence (exit 1).

The table file holds the verdict `table:` payload: a list of
`[[c, j], count]` entries in any whitespace format, e.g.
`[[[0, 5], 1], [[1, 3], 2]]`.  Unlisted pairs default to zero.
-/

namespace Erdos85

namespace V2CnfEmit

/-- Extract all natural-number literals from a bracketed listing. -/
def parseNats (s : String) : List Nat := Id.run do
  let mut out : List Nat := []
  let mut cur : Option Nat := none
  for c in s.data do
    if c.isDigit then
      cur := some ((cur.getD 0) * 10 + (c.toNat - '0'.toNat))
    else
      if let some n := cur then
        out := n :: out
      cur := none
  if let some n := cur then
    out := n :: out
  return out.reverse

/-- Group the flat number stream into `((c, j), count)` triples. -/
def parseTableEntries : List Nat → List ((Nat × Nat) × Nat)
  | c :: j :: n :: rest => ((c, j), n) :: parseTableEntries rest
  | _ => []

def tableOfEntries (entries : List ((Nat × Nat) × Nat)) :
    OneHighMissTable := fun c j =>
  match entries.find? (fun e => e.1.1 = c ∧ e.1.2 = j) with
  | some e => e.2
  | none => 0

def clauseLine (clause : DimacsClause) : String :=
  String.intercalate " " (clause.map toString) ++ " 0"

def renderDimacs (st : OneHighFamilyGenState) : String := Id.run do
  let mut out := s!"p cnf {st.top} {st.clauses.size}\n"
  for clause in st.clauses do
    out := out ++ clauseLine clause ++ "\n"
  return out

/-- Parse a DIMACS file into its clause list (ignoring `c`/`p` lines). -/
def parseDimacs (contents : String) : Array (List Int) := Id.run do
  let mut clauses : Array (List Int) := #[]
  for line in contents.splitOn "\n" do
    let t := line.trim
    if t.isEmpty || t.startsWith "c" || t.startsWith "p" then
      continue
    let lits := (t.splitOn " ").filterMap (fun w =>
      if w.isEmpty then none else w.toInt?)
    let lits := lits.takeWhile (· ≠ 0)
    if !lits.isEmpty then
      clauses := clauses.push lits
  return clauses

def run (args : List String) : IO UInt32 := do
  match args with
  | ["emit", profileStr, tablePath] =>
      let some profile := profileStr.toNat? | do
        IO.eprintln "bad profile"; return 2
      let raw ← IO.FS.readFile tablePath
      let table := tableOfEntries (parseTableEntries (parseNats raw))
      let st := oneHighFamilyV2Clauses profile table
      IO.print (renderDimacs st)
      return 0
  | ["check", profileStr, tablePath, cnfPath] =>
      let some profile := profileStr.toNat? | do
        IO.eprintln "bad profile"; return 2
      let raw ← IO.FS.readFile tablePath
      let table := tableOfEntries (parseTableEntries (parseNats raw))
      let st := oneHighFamilyV2Clauses profile table
      let supplied := parseDimacs (← IO.FS.readFile cnfPath)
      if st.clauses.size ≠ supplied.size then
        IO.eprintln
          s!"MISMATCH: clause count {st.clauses.size} vs {supplied.size}"
        return 1
      for i in [0:st.clauses.size] do
        if st.clauses[i]! ≠ supplied[i]! then
          IO.eprintln s!"MISMATCH at clause {i + 1}:"
          IO.eprintln s!"  lean:     {clauseLine st.clauses[i]!}"
          IO.eprintln s!"  supplied: {clauseLine supplied[i]!}"
          return 1
      IO.println s!"MATCH ({st.clauses.size} clauses, top {st.top})"
      return 0
  | _ => do
      IO.eprintln "usage: v2cnf emit <profile> <table-file>"
      IO.eprintln "       v2cnf check <profile> <table-file> <cnf-file>"
      return 2

end V2CnfEmit

end Erdos85

def main (args : List String) : IO UInt32 :=
  Erdos85.V2CnfEmit.run args
