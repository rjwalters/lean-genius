      ∃ (g : K ≃ₐ[ℚ] K), g ^ 3 ≠ 1 := by
  haveI : NeZero (21 : ℕ) := ⟨by omega⟩
  obtain ⟨K, _, _, _, hgal, ⟨iso⟩⟩ := units_zmod_realizable 21
