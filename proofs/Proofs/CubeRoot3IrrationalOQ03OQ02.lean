/-
Proof: ∛3 is **not ruler-and-compass constructible** — the impossibility of
"doubling the cube" — obtained as a corollary of the field degree
[ℚ(∛3) : ℚ] = 3 not being a power of 2.
Research: cube-root-3-irrational-oq-03-oq-02
Date: 2026-06-24

Open question (child of `cube-root-3-irrational-oq-03`): the parent established
that ∛3 has degree 3 over ℚ (`finrank_adjoin_cbrt3`). Here we draw the classical
geometric corollary: ∛3 cannot be constructed with ruler and compass, so the
cube cannot be doubled.

## The algebraic characterization of constructibility

Mathlib does not (yet) contain a development of ruler-and-compass constructibility
as a geometric notion. We therefore work with the standard **algebraic
characterization**, which is the content of the classical theorem reducing
straightedge-and-compass constructions to field theory:

> A real number is constructible iff it lies in a field obtained from ℚ by a
> finite tower of quadratic (degree-2) extensions.

We take this characterization as the *definition* of `IsConstructible`
(`IsQuadraticTower` + membership). The geometric ⟺ algebraic equivalence — that
each ruler/compass step intersects lines and circles and so adjoins at most a
square root — is the part **not** formalized here; it is the universally accepted
classical reduction. Everything downstream of the definition is fully verified.

## The mathematical heart

The substantive, fully-proved content is the **degree obstruction**:

  * `IsQuadraticTower.finrank_eq_two_pow` — every quadratic tower has degree a
    power of 2 over ℚ (induction on the tower, multiplicativity of degrees in a
    field tower via `IntermediateField.finrank_bot_mul_relfinrank`);
  * `finrank_adjoin_eq_two_pow_of_constructible` — hence the degree of any
    constructible number over ℚ is a power of 2 (its minimal field ℚ⟮α⟯ sits
    inside the tower, so [ℚ⟮α⟯ : ℚ] divides 2ⁿ and a divisor of 2ⁿ is a power
    of 2);
  * `not_constructible_of_finrank_ne_two_pow` — the general obstruction: any α
    whose degree over ℚ is not a power of 2 is non-constructible;
  * `cbrt3_not_constructible` — the headline: ∛3 has degree 3, and `3 ≠ 2ⁿ`, so
    ∛3 is not constructible. **The cube cannot be doubled.**
-/

import Mathlib
import Proofs.CubeRoot3IrrationalOQ03

open CubeRoot3Irrational CubeRoot3IrrationalOQ03 Polynomial IntermediateField Module

namespace CubeRoot3IrrationalOQ03OQ02

/-! ### Quadratic towers over ℚ inside ℝ -/

/-- A **quadratic tower** over ℚ inside ℝ: an intermediate field reachable from
ℚ by finitely many degree-2 (quadratic) extensions. This is the algebraic shape
of the fields generated by ruler-and-compass constructions: each constructive
step adjoins (at most) a square root, i.e. forms a degree-2 extension. -/
inductive IsQuadraticTower : IntermediateField ℚ ℝ → Prop
  | base : IsQuadraticTower ⊥
  | step {K L : IntermediateField ℚ ℝ} (hK : IsQuadraticTower K)
      (hKL : K ≤ L) (hdeg : relfinrank K L = 2) : IsQuadraticTower L

/-- **Every quadratic tower has degree a power of 2 over ℚ.** Induction on the
tower: the base field ℚ has degree `1 = 2⁰`, and each quadratic step multiplies
the degree by `2` (multiplicativity of degrees in a field tower). -/
theorem IsQuadraticTower.finrank_eq_two_pow {K : IntermediateField ℚ ℝ}
    (h : IsQuadraticTower K) : ∃ n : ℕ, Module.finrank ℚ K = 2 ^ n := by
  induction h with
  | base => exact ⟨0, by simp [IntermediateField.finrank_bot]⟩
  | step hK hKL hdeg ih =>
      obtain ⟨n, hn⟩ := ih
      refine ⟨n + 1, ?_⟩
      have hmul := IntermediateField.finrank_bot_mul_relfinrank hKL
      rw [hn, hdeg] at hmul
      rw [pow_succ]
      exact hmul.symm

/-! ### Constructible real numbers -/

/-- A real number is **(ruler-and-compass) constructible** if it lies in some
quadratic tower over ℚ. (Algebraic characterization — see the file header.) -/
def IsConstructible (α : ℝ) : Prop :=
  ∃ K : IntermediateField ℚ ℝ, IsQuadraticTower K ∧ α ∈ K

/-- **The degree of a constructible number over ℚ is a power of 2.** Its minimal
field `ℚ⟮α⟯` lies inside the ambient tower `K`, so `[ℚ⟮α⟯ : ℚ]` divides
`[K : ℚ] = 2ⁿ`; a divisor of `2ⁿ` is itself a power of `2`. -/
theorem finrank_adjoin_eq_two_pow_of_constructible {α : ℝ} (h : IsConstructible α) :
    ∃ n : ℕ, Module.finrank ℚ ℚ⟮α⟯ = 2 ^ n := by
  obtain ⟨K, hK, hαK⟩ := h
  obtain ⟨n, hn⟩ := hK.finrank_eq_two_pow
  have hle : ℚ⟮α⟯ ≤ K := by
    rw [adjoin_simple_le_iff]; exact hαK
  have hdvd : Module.finrank ℚ ℚ⟮α⟯ ∣ Module.finrank ℚ K :=
    ⟨_, (IntermediateField.finrank_bot_mul_relfinrank hle).symm⟩
  rw [hn] at hdvd
  obtain ⟨j, _, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  exact ⟨j, hj⟩

/-- **General obstruction.** If the degree of `α` over ℚ is not a power of 2,
then `α` is not constructible. -/
theorem not_constructible_of_finrank_ne_two_pow {α : ℝ}
    (h : ∀ n : ℕ, Module.finrank ℚ ℚ⟮α⟯ ≠ 2 ^ n) : ¬ IsConstructible α := by
  intro hc
  obtain ⟨n, hn⟩ := finrank_adjoin_eq_two_pow_of_constructible hc
  exact h n hn

/-! ### The arithmetic obstruction and the headline result -/

/-- `3` is not a power of `2`: a power of `2` divisible by the prime `3` would
force `3 ∣ 2`, which is false. -/
theorem three_ne_two_pow (n : ℕ) : (3 : ℕ) ≠ 2 ^ n := by
  intro h
  have hdvd : (3 : ℕ) ∣ 2 ^ n := ⟨1, by rw [← h, mul_one]⟩
  have h2 : (3 : ℕ) ∣ 2 := Nat.prime_three.dvd_of_dvd_pow hdvd
  norm_num at h2

/-- **∛3 is not ruler-and-compass constructible — the cube cannot be doubled.**
∛3 has degree `3` over ℚ (parent `finrank_adjoin_cbrt3`), and `3 ≠ 2ⁿ`, so by the
degree obstruction ∛3 is not constructible. -/
theorem cbrt3_not_constructible : ¬ IsConstructible cbrt3 := by
  apply not_constructible_of_finrank_ne_two_pow
  intro n
  rw [finrank_adjoin_cbrt3]
  exact three_ne_two_pow n

end CubeRoot3IrrationalOQ03OQ02
