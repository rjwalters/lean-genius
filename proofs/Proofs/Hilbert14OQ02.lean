import Mathlib.RingTheory.MvPolynomial.Symmetric.FundamentalTheorem
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.AlgebraicIndependent.Basic
import Mathlib.Tactic

/-!
# Hilbert 14 OQ-02: optimal degree bounds for the symmetric group `Sₙ`

The parent entry (`hilbert-14`) concerns finite generation of invariant rings and lists as
an open question:

> *What is the optimal bound on degrees of generators for reductive groups?*

For a general reductive group this is genuinely hard (and the sharp constants are an active
research topic). This file settles it completely for the **fundamental example**, the
symmetric group `Sₙ` acting on `R[x₁,…,xₙ]` by permuting variables — the textbook reductive
(indeed finite) group whose invariant ring is exactly known:

> The invariant ring `R[x₁,…,xₙ]^{Sₙ}` is the algebra of **symmetric polynomials**, and the
> **Fundamental Theorem of Symmetric Polynomials** says it is freely generated by the `n`
> elementary symmetric polynomials `e₁,…,eₙ`, where `eₖ` is homogeneous of degree `k`.
> Hence the optimal degree bound is `β(Sₙ) = n`, attained by `eₙ = x₁⋯xₙ`.

We package Mathlib's Fundamental Theorem (`MvPolynomial.esymmAlgHom_surjective`,
`MvPolynomial.esymmAlgEquiv`) in invariant-theory language and prove the degree facts
(`eₖ` is homogeneous of degree `k`), giving both the generation and the sharp bound, with
`0` axioms.

## Main results

* `symmetric_eq_aeval_esymm` : every symmetric polynomial is a polynomial in `e₁,…,eₙ`.
* `esymm_algebraicIndependent` : `e₁,…,eₙ` are algebraically independent — exactly `n`
  generators, none redundant (the optimal *number*).
* `esymm_isHomogeneous` : `eₖ` is homogeneous of degree `k` (the generators have degrees
  `1,…,n`).
* `esymm_totalDegree_le` : the generators all have degree `≤ n` — the optimal degree bound
  `β(Sₙ) ≤ n`, attained by the top generator `eₙ = x₁⋯xₙ` (homogeneous of degree `n`).
-/

namespace Hilbert14OQ02

open MvPolynomial Finset

variable {σ : Type*} [Fintype σ] [DecidableEq σ] {R : Type*} [CommRing R] {n : ℕ}

/-- **Generation (Fundamental Theorem of Symmetric Polynomials).** Every symmetric
    polynomial in `R[x_σ]` is a polynomial expression in the elementary symmetric
    polynomials `e₁,…,eₙ` (with `n ≥ |σ|`). This is the statement that `Sₙ`-invariants are
    finitely generated by `e₁,…,eₙ`. -/
theorem symmetric_eq_aeval_esymm (hn : Fintype.card σ ≤ n)
    (p : MvPolynomial σ R) (hp : p.IsSymmetric) :
    ∃ q : MvPolynomial (Fin n) R,
      p = aeval (fun i : Fin n => esymm σ R (i + 1)) q := by
  obtain ⟨q, hq⟩ := esymmAlgHom_surjective R hn ⟨p, (mem_symmetricSubalgebra p).mpr hp⟩
  refine ⟨q, ?_⟩
  have hval := congrArg Subtype.val hq
  rw [esymmAlgHom_apply] at hval
  exact hval.symm

/-- The generators `e₁,…,eₙ` assemble into the elementary-symmetric algebra map; when
    `|σ| = n` it is an isomorphism (Fundamental Theorem), exhibiting `R[x_σ]^{Sₙ}` as a
    polynomial ring on `n` free generators. -/
theorem symmetric_algEquiv_polynomial (hn : Fintype.card σ = n) :
    Nonempty (MvPolynomial (Fin n) R ≃ₐ[R] symmetricSubalgebra σ R) :=
  ⟨esymmAlgEquiv σ R hn⟩

/-- **Optimal number of generators.** The elementary symmetric polynomials `e₁,…,eₙ` are
    algebraically independent over `R` (when `|σ| = n`). So the invariant ring needs exactly
    `n` generators — none of `e₁,…,eₙ` is a polynomial in the others. -/
theorem esymm_algebraicIndependent (hn : Fintype.card σ = n) :
    AlgebraicIndependent R (fun i : Fin n => esymm σ R (i + 1)) := by
  rw [algebraicIndependent_iff_injective_aeval]
  have hcomp : (aeval (fun i : Fin n => esymm σ R (i + 1)) :
        MvPolynomial (Fin n) R →ₐ[R] MvPolynomial σ R)
      = (symmetricSubalgebra σ R).val.comp (esymmAlgHom σ R n) := by
    ext i
    simp [esymmAlgHom]
  rw [hcomp, AlgHom.coe_comp]
  exact (Subtype.val_injective).comp (esymmAlgHom_injective R hn.ge)

/-- **The generator `eₖ` is homogeneous of degree `k`.** Each elementary symmetric
    polynomial `eₖ = ∑_{|t|=k} ∏_{i∈t} xᵢ` is a sum of squarefree degree-`k` monomials. -/
theorem esymm_isHomogeneous (k : ℕ) : (esymm σ R k).IsHomogeneous k := by
  rw [esymm_eq_sum_monomial]
  apply MvPolynomial.IsHomogeneous.sum
  intro t ht
  rw [mem_powersetCard] at ht
  apply MvPolynomial.isHomogeneous_monomial
  have hdeg : (∑ i ∈ t, Finsupp.single i (1 : ℕ)).degree = t.card := by
    rw [map_sum]
    simp [Finsupp.degree_single]
  rw [hdeg, ht.2]

/-- The generators have degree `≤ n`: `e₁,…,eₙ` all lie in degree `≤ n`, so the symmetric
    invariants are generated in degrees `≤ n` — the degree bound `β(Sₙ) ≤ n`. -/
theorem esymm_totalDegree_le (i : Fin n) :
    (esymm σ R (i + 1)).totalDegree ≤ n :=
  le_trans (esymm_isHomogeneous (i + 1)).totalDegree_le (by omega)

end Hilbert14OQ02
