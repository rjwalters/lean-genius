import Proofs.Erdos85SignedSRGBridge

/-! # Unique commuting two-factors for the lambda-six representatives

A factor is encoded only on the 64 edges of the defect complement. -/

namespace Erdos85

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

def isCommutingTwoFactor64
    (incident : Fin 16 → BitVec 64)
    (leftMask rightMask : Fin 16 → Fin 16 → BitVec 64)
    (f : BitVec 64) : Prop :=
  (∀ x : Fin 16, (f &&& incident x).cpop = 2) ∧
  ∀ x y : Fin 16,
    (f &&& leftMask x y).cpop = (f &&& rightMask x y).cpop

