def lambdaSixTenSixT40CanonicalFactor64 : BitVec 64 := 0xb680108410410a0a

theorem unique_commutingTwoFactor64_tenSixT40 :
    ∀ f : BitVec 64, isCommutingTwoFactor64 lambdaSixTenSixT40Incident
      lambdaSixTenSixT40LeftMask lambdaSixTenSixT40RightMask f →
      f = lambdaSixTenSixT40CanonicalFactor64 := by
  simp only [isCommutingTwoFactor64,
    lambdaSixTenSixT40Incident, lambdaSixTenSixT40LeftMask,
    lambdaSixTenSixT40RightMask, lambdaSixTenSixT40CanonicalFactor64]
  simp (config := { maxSteps := 100000000 }) [Fin.forall_fin_succ]
  bv_decide (config := { timeout := 600 })

