{
  "name": "lean-genius",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\" && pnpm gallery:check-size && pnpm gallery:check-verified-companions && pnpm annotations:build && pnpm research:build && pnpm research:enrich && pnpm gallery:check-search-index && pnpm gallery:loading-facts && pnpm gallery:build-redirects && tsc -b && vite build && pnpm gallery:check-bundle-budget",
    "lint": "eslint .",
    "gallery:build-redirects": "tsx scripts/gallery/build-redirects.ts",
    "gallery:migrate-oq-slugs": "tsx scripts/gallery/migrate-oq-slugs.ts",
    "test:oq-slug": "tsx scripts/tests/oq-slug.test.ts",
    "test:oq-group": "tsx scripts/tests/oq-group.test.ts",
    "gallery:check-bundle-budget": "tsx scripts/gallery/check-bundle-budget.ts",
    "gallery:check-search-index": "tsx scripts/gallery/check-search-index.ts",
    "gallery:check-verified-companions": "tsx scripts/gallery/check-verified-companions.ts",
    "gallery:check-size": "tsx scripts/gallery/check-meta-size.ts",
    "gallery:check-size:strict": "tsx scripts/gallery/check-meta-size.ts --strict",
    "gallery:size-report": "tsx scripts/gallery/check-meta-size.ts --report",
    "gallery:loading-facts": "tsx scripts/gallery/build-loading-facts.ts",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=lean-genius --commit-dirty=true",
    "annotations:build": "tsx scripts/annotations/build.ts",
    "annotations:validate": "tsx scripts/annotations/build.ts --strict",
    "annotations:normalize": "tsx scripts/annotations/normalize-enums.ts",
    "annotations:normalize-check": "tsx scripts/annotations/normalize-enums.ts --check",
    "annotations:migrate": "tsx scripts/annotations/resolver.ts migrate",
    "annotations:parse": "tsx scripts/annotations/resolver.ts parse",
    "research:sync": "tsx scripts/research/sync-data.ts",
    "research:build": "pnpm research:sync && tsx scripts/research/build.ts",
    "research:enrich": "tsx scripts/research/enrich-research.ts",
    "research:validate-seeker-stubs": "tsx scripts/research/validate-seeker-stubs.ts --changed",
    "db:export": "tsx scripts/research/db-export.ts",
    "db:rebuild": "tsx scripts/research/db-rebuild.ts",
    "aristotle": "./research/scripts/aristotle-status.sh",
    "aristotle:retrieve": "./research/scripts/aristotle-status.sh --retrieve",
    "aristotle:json": "./research/scripts/aristotle-status.sh --json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "katex": "^0.18.6",
    "lucide-react": "^0.562.0",
    "masto": "^7.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251221.0",
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.5",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.2.4"
  }
}
